@model MelaFair.Web.Models.ViewModels.VendorJobPostingViewModel
@{ ViewData["Title"] = Model.JobPostingId == 0 ? "Post a Job" : "Edit Job"; var action = Model.JobPostingId == 0 ? "CreateJob" : "EditJob"; const string inputStyle = "mt-2 block w-full rounded-xl border-2 border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 hover:border-emerald-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100"; }
<div class="max-w-4xl mx-auto space-y-6">
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-700 via-teal-700 to-slate-900 p-7 sm:p-9 text-white shadow-xl shadow-emerald-900/20"><div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-amber-300/20 blur-2xl"></div><div class="relative flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"><div><span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-50 ring-1 ring-white/20"><span class="h-2 w-2 rounded-full bg-amber-300"></span> Vendor staff recruitment</span><h1 class="mt-3 text-3xl font-black tracking-tight">@(Model.JobPostingId == 0 ? "Post a standout job" : "Refine your job posting")</h1><p class="mt-2 max-w-2xl text-sm leading-relaxed text-emerald-50/90">Attract the right temporary staff for your stall. Your posting is shown immediately on the employee job board.</p></div><div class="rounded-2xl border border-white/15 bg-white/10 px-4 py-3 text-sm font-semibold text-emerald-50"><span class="block text-[10px] uppercase tracking-widest text-emerald-200">Step 1 of 1</span>Complete the job details</div></div></section>
  <form asp-action="@action" method="post" class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lg shadow-slate-200/60">@Html.AntiForgeryToken()<input asp-for="JobPostingId" type="hidden" />
    <div class="border-b border-slate-200 bg-slate-50 px-6 py-5 sm:px-8"><h2 class="font-bold text-slate-900">Job details</h2><p class="mt-1 text-sm text-slate-500">Choose a leased fair, then provide clear details for applicants.</p></div>
    <div class="grid grid-cols-1 gap-6 p-6 sm:p-8 md:grid-cols-2"><div asp-validation-summary="ModelOnly" class="md:col-span-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>
      <div class="md:col-span-2"><label asp-for="FairId" class="text-sm font-bold text-slate-800">Fair location</label><select asp-for="FairId" class="@inputStyle"><option value="">Choose your leased fair...</option>@foreach(var fair in Model.AvailableFairs){<option value="@fair.FairId">@fair.Title</option>}</select><span asp-validation-for="FairId" class="mt-1 block text-xs font-medium text-rose-600"></span></div>
      <div><label asp-for="Title" class="text-sm font-bold text-slate-800">Job title</label><input asp-for="Title" placeholder="e.g. Stall Sales Assistant" class="@inputStyle" /><span asp-validation-for="Title" class="mt-1 block text-xs font-medium text-rose-600"></span></div><div><label asp-for="Department" class="text-sm font-bold text-slate-800">Work area</label><input asp-for="Department" placeholder="e.g. Customer service" class="@inputStyle" /></div>
      <div class="md:col-span-2"><label asp-for="Description" class="text-sm font-bold text-slate-800">What will this person do?</label><textarea asp-for="Description" rows="5" placeholder="Describe responsibilities, shifts, and what makes the role appealing." class="@inputStyle"></textarea><span asp-validation-for="Description" class="mt-1 block text-xs font-medium text-rose-600"></span></div>
      <div class="md:col-span-2"><label asp-for="Requirements" class="text-sm font-bold text-slate-800">Skills and requirements</label><textarea asp-for="Requirements" rows="4" placeholder="List experience, skills, availability, or languages needed." class="@inputStyle"></textarea></div>
      <div><label asp-for="DailyWage" class="text-sm font-bold text-slate-800">Daily wage</label><div class="relative"><span class="pointer-events-none absolute left-4 top-5 text-sm font-bold text-emerald-700">৳</span><input asp-for="DailyWage" placeholder="0.00" class="@inputStyle pl-8" /></div><span asp-validation-for="DailyWage" class="mt-1 block text-xs font-medium text-rose-600"></span></div><div><label asp-for="PositionsAvailable" class="text-sm font-bold text-slate-800">Number of openings</label><input asp-for="PositionsAvailable" class="@inputStyle" /><span asp-validation-for="PositionsAvailable" class="mt-1 block text-xs font-medium text-rose-600"></span></div>
      <div><label asp-for="ApplicationDeadline" class="text-sm font-bold text-slate-800">Application deadline</label><input asp-for="ApplicationDeadline" class="@inputStyle" /></div><label class="flex cursor-pointer items-center gap-3 self-end rounded-xl border-2 border-emerald-100 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-900"><input asp-for="IsActive" class="h-5 w-5 rounded border-emerald-400 text-emerald-600 focus:ring-emerald-500" />Publish and accept applications</label>
    </div>
    <div class="flex flex-col-reverse gap-3 border-t border-slate-200 bg-slate-50 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"><a asp-action="Jobs" class="rounded-xl px-5 py-3 text-center text-sm font-bold text-slate-600 hover:bg-slate-200">Cancel</a><button type="submit" class="rounded-xl bg-emerald-600 px-7 py-3 text-sm font-black text-white shadow-lg shadow-emerald-600/25 transition hover:-translate-y-0.5 hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-200">@(Model.JobPostingId == 0 ? "Publish job posting" : "Save job changes")</button></div>
  </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
