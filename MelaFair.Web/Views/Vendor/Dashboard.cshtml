@model MelaFair.Web.Models.ViewModels.VendorDashboardViewModel
@{
    ViewData["Title"] = "Vendor Commercial Command Center";
}

<div class="space-y-8">
    <!-- Hero Greeting & Quick Action Banner -->
    <div class="bg-gradient-to-r from-emerald-900 via-teal-900 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden border border-emerald-500/20">
        <!-- Decorative Ambient Glow -->
        <div class="absolute -right-10 -top-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute right-40 -bottom-10 w-60 h-60 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2 max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold uppercase tracking-wider">
                    <span>🎪</span> Official Vendor Portal &bull; Verified Partner
                </div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight leading-tight">
                    Welcome back, <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200">@(string.IsNullOrEmpty(Model.VendorName) ? "Partner Vendor" : Model.VendorName)</span>!
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    Manage your festival booth leases, monitor event schedules, print official trade permits, and discover high-footfall cultural fairs across Bangladesh.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <a asp-controller="Vendor" asp-action="Marketplace" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold text-xs shadow-lg shadow-emerald-500/25 transition transform hover:-translate-y-0.5 flex items-center gap-2">
                    <i class="fas fa-plus-circle text-sm"></i>
                    <span>Lease New Stalls</span>
                </a>
                <a asp-controller="Vendor" asp-action="MyStalls" class="px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs backdrop-blur-md border border-white/20 transition flex items-center gap-2">
                    <i class="fas fa-certificate text-sm"></i>
                    <span>My Booth Permits</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 4 Key Performance Indicator (KPI) Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Total Leased Stalls -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition space-y-3 group">
            <div class="flex items-center justify-between">
                <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">Total Leased Stalls</span>
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform">
                    🎪
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900">@Model.TotalStallsLeased</span>
                <span class="text-xs font-semibold text-emerald-600">Active Units</span>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1.5 pt-1 border-t border-slate-100">
                <i class="fas fa-shield-alt text-emerald-500"></i>
                <span>Row-locked concurrency safe</span>
            </div>
        </div>

        <!-- Total Capital Invested -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition space-y-3 group">
            <div class="flex items-center justify-between">
                <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">Total Investment</span>
                <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform">
                    💰
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900">$@Model.TotalAmountInvested.ToString("N2")</span>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center justify-between pt-1 border-t border-slate-100">
                <span>Avg Rate / Stall:</span>
                <span class="font-bold text-slate-800">$@Model.AverageStallRate.ToString("N0")</span>
            </div>
        </div>

        <!-- Active & Upcoming Fairs -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition space-y-3 group">
            <div class="flex items-center justify-between">
                <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">Participating Fairs</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform">
                    🏛️
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900">@Model.ActiveFairsCount</span>
                <span class="text-xs font-semibold text-blue-600">Events</span>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1.5 pt-1 border-t border-slate-100">
                <i class="fas fa-calendar-check text-blue-500"></i>
                <span>@Model.UpcomingFairsCount Scheduled Upcoming</span>
            </div>
        </div>

        <!-- Operational Status -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition space-y-3 group">
            <div class="flex items-center justify-between">
                <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">Trade Status</span>
                <div class="w-10 h-10 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform">
                    📜
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-emerald-600">Verified</span>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1.5 pt-1 border-t border-slate-100">
                <i class="fas fa-check-circle text-emerald-500"></i>
                <span>Commercial Permits Active</span>
            </div>
        </div>
    </div>

    <!-- Spotlight: Next Nearest Upcoming Festival with Live Countdown -->
    @if (Model.NextUpcomingBooking != null)
    {
        <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-950 rounded-3xl border border-emerald-500/30 p-6 sm:p-8 text-white shadow-lg space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-4">
                <div class="space-y-1">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30 uppercase tracking-widest">
                        ⭐ Next Upcoming Exhibition
                    </span>
                    <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white mt-1">@Model.NextUpcomingBooking.FairTitle</h2>
                    <p class="text-xs text-slate-300 flex items-center gap-2">
                        <span>📍 @Model.NextUpcomingBooking.Location</span> &bull;
                        <span>📅 @Model.NextUpcomingBooking.StartDate.ToString("MMMM dd, yyyy")</span>
                    </p>
                </div>

                <div class="flex items-center gap-2">
                    <a asp-controller="Vendor" asp-action="StallReceipt" asp-route-id="@Model.NextUpcomingBooking.BookingId" class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition flex items-center gap-1.5">
                        <i class="fas fa-print"></i>
                        <span>Print Trade Pass</span>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
                <!-- Stall Specs -->
                <div class="bg-white/5 rounded-2xl border border-white/10 p-4 space-y-3">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Allocated Booth Specs</span>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-300">Stall Number:</span>
                        <span class="text-base font-black font-mono text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-lg border border-emerald-500/30">
                            @Model.NextUpcomingBooking.StallNumber
                        </span>
                    </div>
                    <div class="flex items-center justify-between text-xs text-slate-300">
                        <span>Category / Size:</span>
                        <span class="font-bold text-white">@Model.NextUpcomingBooking.Category (@Model.NextUpcomingBooking.Size)</span>
                    </div>
                    <div class="flex items-center justify-between text-xs text-slate-300">
                        <span>Transaction Ref:</span>
                        <span class="font-mono text-[11px] text-slate-400">@Model.NextUpcomingBooking.TransactionReference</span>
                    </div>
                </div>

                <!-- Live Countdown Timer Component -->
                <div class="lg:col-span-2 bg-gradient-to-r from-emerald-950/80 to-teal-950/80 rounded-2xl border border-emerald-500/30 p-5 text-center space-y-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-300 block">
                        ⏱️ Exhibition Opening Countdown
                    </span>
                    <div class="grid grid-cols-4 gap-3 max-w-md mx-auto" id="countdownContainer" data-target="@Model.NextUpcomingBooking.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                        <div class="bg-black/40 rounded-xl p-3 border border-emerald-500/20">
                            <span id="timerDays" class="text-2xl sm:text-3xl font-black text-emerald-400 block font-mono">00</span>
                            <span class="text-[10px] text-slate-400 uppercase font-semibold">Days</span>
                        </div>
                        <div class="bg-black/40 rounded-xl p-3 border border-emerald-500/20">
                            <span id="timerHours" class="text-2xl sm:text-3xl font-black text-teal-400 block font-mono">00</span>
                            <span class="text-[10px] text-slate-400 uppercase font-semibold">Hours</span>
                        </div>
                        <div class="bg-black/40 rounded-xl p-3 border border-emerald-500/20">
                            <span id="timerMinutes" class="text-2xl sm:text-3xl font-black text-amber-400 block font-mono">00</span>
                            <span class="text-[10px] text-slate-400 uppercase font-semibold">Mins</span>
                        </div>
                        <div class="bg-black/40 rounded-xl p-3 border border-emerald-500/20">
                            <span id="timerSeconds" class="text-2xl sm:text-3xl font-black text-rose-400 block font-mono">00</span>
                            <span class="text-[10px] text-slate-400 uppercase font-semibold">Secs</span>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400">
                        Gate registration &amp; booth decoration setup opens 24 hours prior to inauguration.
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Analytics Charts & Stall Category Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Chart 1: Investment by Fair (Bar Chart) -->
        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Capital Investment by Festival</h3>
                    <p class="text-xs text-slate-500">Expenditure allocation across cultural exhibitions</p>
                </div>
                <span class="text-xs font-bold px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg">Financial Overview</span>
            </div>
            <div class="h-64 relative">
                <canvas id="spendingChart"></canvas>
            </div>
        </div>

        <!-- Chart 2: Category Distribution (Doughnut Chart) -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Stall Categories</h3>
                    <p class="text-xs text-slate-500">Industry trade distribution</p>
                </div>
            </div>
            <div class="h-64 relative flex items-center justify-center">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Stall Bookings Table -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden p-6 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900">Recent Stall Allocations</h3>
                <p class="text-xs text-slate-500">Latest active trade permits and transaction records</p>
            </div>
            <a asp-controller="Vendor" asp-action="MyStalls" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1">
                <span>View All Leases (@Model.TotalStallsLeased)</span>
                <span>&rarr;</span>
            </a>
        </div>

        @if (!Model.RecentBookings.Any())
        {
            <div class="p-8 text-center space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center text-2xl font-bold">
                    🎪
                </div>
                <h4 class="text-sm font-bold text-slate-700">No Booth Reservations Found</h4>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">
                    You haven't leased any festival stalls yet. Explore available upcoming cultural fairs to reserve your premier location!
                </p>
                <a asp-controller="Vendor" asp-action="Marketplace" class="inline-block px-4 py-2 rounded-xl bg-emerald-600 text-white font-bold text-xs shadow-md">
                    Explore Marketplace
                </a>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-600 font-bold uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="py-3 px-4">Stall Number</th>
                            <th class="py-3 px-4">Fair Name &amp; Location</th>
                            <th class="py-3 px-4">Category / Size</th>
                            <th class="py-3 px-4">Exhibition Dates</th>
                            <th class="py-3 px-4">Amount Paid</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-3.5 px-4 font-mono font-black text-slate-900">
                                    <span class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200">
                                        @b.StallNumber
                                    </span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-slate-900 block">@b.FairTitle</span>
                                    <span class="text-[10px] text-slate-500">📍 @b.Location</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-semibold text-slate-800">@b.Category</span>
                                    <span class="text-[10px] text-slate-500 block">@b.Size</span>
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    @b.StartDate.ToString("MMM dd") - @b.EndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-3.5 px-4 font-black text-slate-900">$@b.AmountPaid.ToString("N2")</td>
                                <td class="py-3.5 px-4">
                                    @if (b.PaymentStatus == MelaFair.Core.Enums.PaymentStatus.Paid)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Confirmed
                                        </span>
                                    }
                                    else if (b.PaymentStatus == MelaFair.Core.Enums.PaymentStatus.Refunded)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                            Refunded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                            @b.PaymentStatus
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap space-x-1">
                                    <a asp-controller="Vendor" asp-action="StallReceipt" asp-route-id="@b.BookingId" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-semibold transition inline-flex items-center gap-1" title="Print Official Permit">
                                        <i class="fas fa-file-invoice"></i> Permit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Recommended Active Cultural Fairs Section -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-bold text-slate-900">Recommended Festivals for Exhibition</h3>
                <p class="text-xs text-slate-500">High-traffic upcoming fairs with open commercial stalls</p>
            </div>
            <a asp-controller="Vendor" asp-action="Marketplace" class="text-xs font-bold text-emerald-700 hover:text-emerald-800">
                Browse Full Marketplace &rarr;
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @foreach (var fair in Model.RecommendedFairs)
            {
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition">
                    <div>
                        <div class="h-36 w-full bg-slate-200 relative overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(fair.BannerImageUrl))
                            {
                                <img src="@fair.BannerImageUrl" alt="@fair.Title" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-tr from-emerald-600 to-teal-600 flex items-center justify-center text-white text-3xl font-bold">
                                    🎪
                                </div>
                            }
                            <div class="absolute top-2.5 right-2.5 bg-slate-900/85 backdrop-blur-md text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                                @fair.AvailableStalls Stalls Open
                            </div>
                        </div>

                        <div class="p-5 space-y-2">
                            <h4 class="text-sm font-bold text-slate-900 leading-snug">@fair.Title</h4>
                            <p class="text-xs text-slate-500 flex items-center gap-1">
                                <i class="fas fa-map-marker-alt text-slate-400"></i>
                                <span>@fair.Location</span>
                            </p>
                            <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-100">
                                <span class="text-slate-500">Base Lease Rate:</span>
                                <span class="font-black text-slate-900">$@fair.BaseStallPrice.ToString("N0")</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-5 pt-0">
                        <a asp-controller="Vendor" asp-action="StallBooking" asp-route-fairId="@fair.FairId" class="block text-center w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md shadow-emerald-600/20 transition">
                            Book Stalls &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Live Countdown Timer
            const countdownEl = document.getElementById('countdownContainer');
            if (countdownEl) {
                const targetDate = new Date(countdownEl.dataset.target).getTime();

                function updateCountdown() {
                    const now = new Date().getTime();
                    const distance = targetDate - now;

                    if (distance < 0) {
                        document.getElementById('timerDays').innerText = "00";
                        document.getElementById('timerHours').innerText = "00";
                        document.getElementById('timerMinutes').innerText = "00";
                        document.getElementById('timerSeconds').innerText = "00";
                        return;
                    }

                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    document.getElementById('timerDays').innerText = days.toString().padStart(2, '0');
                    document.getElementById('timerHours').innerText = hours.toString().padStart(2, '0');
                    document.getElementById('timerMinutes').innerText = minutes.toString().padStart(2, '0');
                    document.getElementById('timerSeconds').innerText = seconds.toString().padStart(2, '0');
                }

                updateCountdown();
                setInterval(updateCountdown, 1000);
            }

            // 2. Spending by Fair Chart (Bar)
            const spendingCtx = document.getElementById('spendingChart');
            if (spendingCtx) {
                const spendingData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpendingByFair));
                const labels = Object.keys(spendingData);
                const values = Object.values(spendingData);

                new Chart(spendingCtx, {
                    type: 'bar',
                    data: {
                        labels: labels.length > 0 ? labels : ['No Data'],
                        datasets: [{
                            label: 'Amount Invested ($)',
                            data: values.length > 0 ? values : [0],
                            backgroundColor: '#10b981',
                            borderRadius: 8,
                            barThickness: 32
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '$' + value; }
                                }
                            }
                        }
                    }
                });
            }

            // 3. Category Distribution Chart (Doughnut)
            const categoryCtx = document.getElementById('categoryChart');
            if (categoryCtx) {
                const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryDistribution));
                const catLabels = Object.keys(categoryData);
                const catValues = Object.values(categoryData);

                new Chart(categoryCtx, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels.length > 0 ? catLabels : ['General'],
                        datasets: [{
                            data: catValues.length > 0 ? catValues : [1],
                            backgroundColor: ['#10b981', '#06b6d4', '#f59e0b', '#8b5cf6', '#ec4899', '#f97316', '#64748b'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 10 } }
                            }
                        },
                        cutout: '70%'
                    }
                });
            }
        });
    </script>
}
