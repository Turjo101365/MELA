@model MelaFair.Web.Models.ViewModels.VendorJobApplicationsViewModel
@using MelaFair.Core.Enums
@{ ViewData["Title"] = "Job Applications"; }
<div class="space-y-6"><div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm"><a asp-action="Jobs" class="text-xs font-bold text-emerald-700">← My job posts</a><h1 class="text-2xl font-black text-slate-900 mt-2">Applicants: @Model.JobTitle</h1></div>
@if(!Model.Applications.Any()){<div class="bg-white rounded-3xl border border-slate-200 p-10 text-center text-slate-500">No applications received yet.</div>}
else {<div class="space-y-4">@foreach(var app in Model.Applications){<article class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm"><div class="flex flex-col md:flex-row md:justify-between gap-4"><div><h2 class="font-bold text-slate-900">@app.EmployeeName</h2><p class="text-sm text-slate-500">@app.EmployeeEmail · @app.ContactPhone · @app.ExperienceYears years experience</p><p class="mt-3 text-sm text-slate-700">@app.ResumeSummary</p><p class="mt-2 text-xs text-slate-400">Applied @app.ApplicationDate.ToString("MMM dd, yyyy")</p></div><div class="text-right"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold @(app.Status == ApplicationStatus.Accepted ? "bg-emerald-100 text-emerald-700" : app.Status == ApplicationStatus.Rejected ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700")">@app.Status</span>
@if(app.Status == ApplicationStatus.Pending){<div class="flex justify-end gap-2 mt-4"><form asp-action="ReviewApplication" method="post">@Html.AntiForgeryToken()<input type="hidden" name="applicationId" value="@app.ApplicationId"/><input type="hidden" name="jobPostingId" value="@Model.JobPostingId"/><input type="hidden" name="status" value="@ApplicationStatus.Accepted"/><button class="px-3 py-2 bg-emerald-600 text-white rounded-lg text-xs font-bold">Accept</button></form><form asp-action="ReviewApplication" method="post">@Html.AntiForgeryToken()<input type="hidden" name="applicationId" value="@app.ApplicationId"/><input type="hidden" name="jobPostingId" value="@Model.JobPostingId"/><input type="hidden" name="status" value="@ApplicationStatus.Rejected"/><button class="px-3 py-2 bg-rose-50 text-rose-700 rounded-lg text-xs font-bold">Reject</button></form></div>}</div></div></article>}</div>}</div>
