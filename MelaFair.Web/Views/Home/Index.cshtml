@model IEnumerable<MelaFair.Web.Models.Entities.Fair>
@{
    ViewData["Title"] = "Enterprise Cultural Fair & Event Management";
    var fairsList = Model?.ToList() ?? new List<MelaFair.Web.Models.Entities.Fair>();
}

<div class="space-y-12">

    <!-- 1. Hero Section -->
    <div class="relative rounded-[2.5rem] overflow-hidden min-h-[480px] lg:min-h-[540px] shadow-xl flex flex-col justify-between p-8 sm:p-14 lg:p-16 text-white"
         style="background: linear-gradient(to right, rgba(16, 34, 14, 0.88) 0%, rgba(28, 60, 24, 0.72) 48%, rgba(0, 0, 0, 0.35) 100%), url('https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?auto=format&fit=crop&w=1800&q=80') center/cover no-repeat;">
        
        <!-- Top Pill Badge -->
        <div class="z-10">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs font-bold tracking-wide text-[#e5efe2] shadow-sm">
                <i class="fa-solid fa-bolt text-amber-300"></i>
                <span>High-Concurrency SQL Fair System</span>
            </span>
        </div>

        <!-- Headline & Subheading -->
        <div class="max-w-2xl z-10 space-y-4 my-auto py-8">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-[1.18] tracking-tight drop-shadow-md">
                Celebrating Culture with Enterprise Event Concurrency
            </h1>
            <p class="text-[#e5efe2] text-xs sm:text-sm lg:text-base font-normal leading-relaxed drop-shadow">
                A Fair &amp; Event management system built with ASP.NET Core MVC (C#) and SQL Server &mdash; featuring admin-led fair creation, high-concurrency stall booking for vendors, bulk ticketing for visitors, and a job recruitment portal, backed by stored procedures, triggers, and views for race-condition-safe transactions.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-2">
                <a asp-controller="Fair" asp-action="Index" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs sm:text-sm font-bold shadow-lg transition-all hover:scale-105">
                    <i class="fa-solid fa-compass"></i>
                    <span>Explore Fairs</span>
                </a>
                <a asp-controller="Vendor" asp-action="Marketplace" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/30 text-white text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-105">
                    <i class="fa-solid fa-store"></i>
                    <span>Vendor Stalls</span>
                </a>
                <a asp-controller="Visitor" asp-action="BrowseFairs" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs sm:text-sm font-black shadow-md transition-all hover:scale-105">
                    <i class="fa-solid fa-ticket"></i>
                    <span>Buy Passes</span>
                </a>
            </div>
        </div>

        <!-- Concurrency Badge Indicator -->
        <div class="z-10 flex items-center gap-2 text-[11px] text-white/75 font-mono">
            <i class="fa-solid fa-shield-halved text-emerald-400"></i>
            <span>SQL Concurrency: <code class="text-amber-300 font-bold">UPDLOCK, ROWLOCK</code> active</span>
        </div>
    </div>

    <!-- 2. Floating Pill Search Bar (Overlapping Hero bottom) -->
    <div class="-mt-14 sm:-mt-16 relative z-20 max-w-3xl mx-auto px-4 w-full">
        <form asp-controller="Fair" asp-action="Index" method="get" class="bg-[#9fc193] p-2.5 sm:p-3 rounded-full shadow-2xl flex flex-col sm:flex-row items-center gap-2 border border-white/60 backdrop-blur-md">
            
            <!-- Search Keyword Pill Input -->
            <div class="flex-1 w-full relative">
                <input type="text" name="search" placeholder="Search fairs, folk festivals, artisan crafts..." 
                       class="w-full bg-white text-slate-800 placeholder-slate-400 text-xs sm:text-sm px-5 py-3 rounded-full outline-none shadow-sm focus:ring-2 focus:ring-[#2e5d26]/30 transition" />
            </div>

            <!-- Location Pill Input -->
            <div class="flex-1 w-full relative">
                <input type="text" name="location" placeholder="City, district (e.g. Suhrawardy Udyan)..." 
                       class="w-full bg-white text-slate-800 placeholder-slate-400 text-xs sm:text-sm px-5 py-3 rounded-full outline-none shadow-sm focus:ring-2 focus:ring-[#2e5d26]/30 transition" />
            </div>

            <!-- Quick Filter Indicator & Button -->
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit" class="w-full sm:w-auto px-8 py-3 rounded-full bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs sm:text-sm font-bold shadow-md transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-magnifying-glass text-xs"></i>
                    <span>Explore</span>
                </button>
            </div>
        </form>
    </div>

    <!-- 3. Welcome / Intro Showcase Section -->
    <div class="bg-[#f6f9f3] rounded-[2.5rem] p-6 sm:p-10 lg:p-14 border border-[#dce8d8] shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left: Fair Pavilion Photo Card with Badges -->
            <div class="lg:col-span-5 relative">
                <div class="rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-white group relative">
                    <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=900&q=80" 
                         alt="Cultural Fair Celebration" 
                         class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition-transform duration-500" />
                    

                    <!-- Floating Bottom-Right Stored Procedure Badge -->
                    <div class="absolute bottom-4 right-4 px-3 py-1.5 rounded-full bg-slate-900/90 text-amber-300 text-[10px] font-mono font-bold shadow-lg border-2 border-white flex items-center gap-1.5">
                        <i class="fa-solid fa-code"></i>
                        <span>SP Concurrency</span>
                    </div>
                </div>
            </div>

            <!-- Right: Authentic MelaFair Description -->
            <div class="lg:col-span-7 space-y-5">
                <span class="text-xs font-black uppercase tracking-widest text-[#4e8740] bg-[#e5efe2] px-3 py-1 rounded-full">
                    Enterprise Event Core
                </span>
                
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#1c3c18] tracking-tight leading-tight">
                    Welcome to MelaFair Management System
                </h2>
                
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    Designed for high-capacity traditional festivals, seasonal exhibitions, and artisan craft fairs across Bangladesh. 
                    Our platform eliminates race conditions through SQL Server stored procedures with explicit row-level locking (<code class="bg-[#e5efe2] text-[#2e5d26] px-1.5 py-0.5 rounded font-mono text-xs">UPDLOCK, ROWLOCK</code>), ensuring zero oversold stalls and synchronized ticketing even during peak booking rushes.
                </p>

                <!-- Live Metrics Badges -->
                <div class="grid grid-cols-3 gap-3 pt-2">
                    <div class="bg-white rounded-2xl p-4 border border-[#e2ece0] shadow-sm text-center">
                        <span class="block text-2xl sm:text-3xl font-black text-[#2e5d26]">@ViewBag.TotalFairsCount</span>
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Active Fairs</span>
                    </div>
                    <div class="bg-white rounded-2xl p-4 border border-[#e2ece0] shadow-sm text-center">
                        <span class="block text-2xl sm:text-3xl font-black text-[#2e5d26]">@ViewBag.TotalStallsBookedCount</span>
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Stalls Leased</span>
                    </div>
                    <div class="bg-white rounded-2xl p-4 border border-[#e2ece0] shadow-sm text-center">
                        <span class="block text-2xl sm:text-3xl font-black text-[#2e5d26]">@ViewBag.TotalTicketsSoldCount</span>
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Passes Issued</span>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="flex items-center gap-4 pt-2">
                    <a asp-controller="Fair" asp-action="Index" class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs sm:text-sm font-bold shadow-md transition-all">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>Explore All Fairs</span>
                    </a>
                    <a asp-controller="Vendor" asp-action="Marketplace" class="text-xs sm:text-sm font-bold text-[#386c2c] hover:text-[#1c3c18] transition">
                        Lease a Stall &rarr;
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- 4. Featured Cultural Fairs Section -->
    <div class="space-y-6 pt-4">
        
        <!-- Section Header -->
        <div class="text-center max-w-2xl mx-auto space-y-2">
            <h3 class="text-2xl sm:text-3xl font-black text-[#2e5d26] tracking-tight">
                Featured Cultural Fairs &amp; Exhibitions
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">
                Live festival schedules, real-time stall leasing, and daily admission pass availability
            </p>
        </div>

        <!-- Dynamic 3-Card Grid from Database Model -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @for (int i = 0; i < Math.Min(fairsList.Count, 3); i++)
            {
                var fair = fairsList[i];
                var cardImage = !string.IsNullOrWhiteSpace(fair.BannerImageUrl) 
                    ? fair.BannerImageUrl 
                    : "https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?auto=format&fit=crop&w=800&q=80";

                <div class="bg-white rounded-[2rem] p-3.5 border border-[#dce8d8] shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <!-- Card Image with rounded corners -->
                        <div class="rounded-2xl h-52 w-full overflow-hidden relative shadow-sm">
                            <img src="@cardImage" alt="@fair.Title" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            <div class="absolute top-3 right-3 bg-[#1c3c18]/85 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full shadow">
                                @fair.StartDate.ToString("MMM dd") - @fair.EndDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        <!-- Card Content -->
                        <div class="p-3 pt-4 space-y-2">
                            <h4 class="font-bold text-base sm:text-lg text-[#1c3c18] group-hover:text-[#2e5d26] transition line-clamp-1">
                                @fair.Title
                            </h4>
                            <p class="text-xs text-slate-500 flex items-center gap-1.5 font-medium">
                                <i class="fa-solid fa-location-dot text-[#2e5d26]"></i>
                                <span>@fair.Location</span>
                            </p>
                            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed pt-1">
                                @fair.Description
                            </p>

                            <!-- Availability Badges -->
                            <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-semibold text-center">
                                <div class="bg-[#f4f8f3] rounded-xl p-2 border border-[#e5efe2]">
                                    <span class="block text-[#2e5d26] font-bold">@fair.AvailableStalls / @fair.TotalStalls</span>
                                    <span class="text-[10px] text-slate-500">Stalls Open</span>
                                </div>
                                <div class="bg-[#f4f8f3] rounded-xl p-2 border border-[#e5efe2]">
                                    <span class="block text-[#2e5d26] font-bold">$@fair.BaseTicketPrice.ToString("F0")</span>
                                    <span class="text-[10px] text-slate-500">Per Pass</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Green Pill Button -->
                    <div class="p-3 pt-2">
                        <a asp-controller="Fair" asp-action="Details" asp-route-id="@fair.FairId" 
                           class="w-full py-2.5 px-6 rounded-full bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs font-bold shadow-sm transition-all text-center block hover:scale-102">
                            View Details &amp; Stalls
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Carousel / Pagination Indicator -->
        <div class="flex items-center justify-center gap-2 pt-3">
            <span class="w-6 h-2 rounded-full bg-[#2e5d26]"></span>
            <span class="w-2 h-2 rounded-full bg-[#cce0c6]"></span>
            <span class="w-2 h-2 rounded-full bg-[#cce0c6]"></span>
            <span class="w-2 h-2 rounded-full bg-[#cce0c6]"></span>
        </div>
    </div>

    <!-- 5. 4 Enterprise Role Portals Grid -->
    <div class="pt-6">
        <div class="text-center max-w-xl mx-auto mb-6">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#4e8740] bg-[#e5efe2] px-3 py-1 rounded-full">
                Role Portals
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-[#1c3c18] mt-2">Enterprise Workflows</h3>
            <p class="text-xs text-slate-500">Dedicated operational interfaces with role-based access control</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- Admin Portal -->
            <div class="bg-white rounded-3xl p-5 border border-[#dce8d8] shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="w-10 h-10 rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold text-lg mb-3">
                        <i class="fa-solid fa-crown"></i>
                    </div>
                    <h4 class="font-bold text-sm text-[#1c3c18] mb-1">Fair Administrator</h4>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                        Schedule multi-day fairs via <code class="text-[#2e5d26] font-mono text-[10px]">usp_CreateFair</code>, manage event calendars, and track live revenue analytics.
                    </p>
                </div>
                <a asp-controller="Admin" asp-action="Dashboard" class="w-full py-2 px-4 rounded-full bg-[#e5efe2] hover:bg-[#2e5d26] text-[#2e5d26] hover:text-white font-bold text-xs transition text-center">
                    Admin Dashboard &rarr;
                </a>
            </div>

            <!-- Vendor Portal -->
            <div class="bg-white rounded-3xl p-5 border border-[#dce8d8] shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="w-10 h-10 rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold text-lg mb-3">
                        <i class="fa-solid fa-store"></i>
                    </div>
                    <h4 class="font-bold text-sm text-[#1c3c18] mb-1">Fair Vendor</h4>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                        Explore stall maps, select retail categories, and lease stalls safely with zero duplicates via <code class="text-[#2e5d26] font-mono text-[10px]">usp_BuyStall</code>.
                    </p>
                </div>
                <a asp-controller="Vendor" asp-action="Marketplace" class="w-full py-2 px-4 rounded-full bg-[#e5efe2] hover:bg-[#2e5d26] text-[#2e5d26] hover:text-white font-bold text-xs transition text-center">
                    Browse Stalls &rarr;
                </a>
            </div>

            <!-- Visitor Portal -->
            <div class="bg-white rounded-3xl p-5 border border-[#dce8d8] shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="w-10 h-10 rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold text-lg mb-3">
                        <i class="fa-solid fa-ticket"></i>
                    </div>
                    <h4 class="font-bold text-sm text-[#1c3c18] mb-1">Fair Visitor</h4>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                        Check live daily capacity, book admission passes safely with <code class="text-[#2e5d26] font-mono text-[10px]">usp_BuyFairTicket</code>, and view digital passes.
                    </p>
                </div>
                <a asp-controller="Visitor" asp-action="BrowseFairs" class="w-full py-2 px-4 rounded-full bg-[#e5efe2] hover:bg-[#2e5d26] text-[#2e5d26] hover:text-white font-bold text-xs transition text-center">
                    Get Passes &rarr;
                </a>
            </div>

            <!-- Employee Portal -->
            <div class="bg-white rounded-3xl p-5 border border-[#dce8d8] shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="w-10 h-10 rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold text-lg mb-3">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <h4 class="font-bold text-sm text-[#1c3c18] mb-1">Fair Staff &amp; Jobs</h4>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                        Browse event operations, security, and ticketing openings. Submit applications via <code class="text-[#2e5d26] font-mono text-[10px]">usp_RecruitEmployee</code>.
                    </p>
                </div>
                <a asp-controller="Employee" asp-action="JobListings" class="w-full py-2 px-4 rounded-full bg-[#e5efe2] hover:bg-[#2e5d26] text-[#2e5d26] hover:text-white font-bold text-xs transition text-center">
                    Fair Jobs &rarr;
                </a>
            </div>

        </div>
    </div>

</div>
