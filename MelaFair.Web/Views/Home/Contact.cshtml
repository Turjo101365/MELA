@{
    ViewData["Title"] = "MelaFair Event Coordination & Support Desk";
}

<!-- Main Contact Page Container -->
<div class="-mx-3 sm:-mx-6 lg:-mx-10 -mt-2 sm:-mt-3">

    <!-- 1. Hero Banner with Cultural Festival Foliage & Torn Paper Edge -->
    <div class="relative text-white overflow-hidden pt-12 pb-24 sm:pb-32 px-6 sm:px-12 text-center"
         style="background: linear-gradient(135deg, rgba(20, 42, 18, 0.92) 0%, rgba(36, 75, 30, 0.85) 60%, rgba(55, 102, 45, 0.8) 100%), url('https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=1800&q=80') center/cover no-repeat;">
        
        <div class="max-w-3xl mx-auto space-y-4 relative z-10">
            <!-- Pill Badge -->
            <div>
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs font-bold tracking-wide text-[#e5efe2] shadow-sm">
                    <i class="fa-solid fa-headset text-amber-300"></i>
                    <span>MELA Fair Operations &amp; Support Desk</span>
                </span>
            </div>

            <!-- Page Title -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight drop-shadow-md">
                Contact Event Coordination
            </h1>

            <!-- Subtitle -->
            <p class="text-[#e5efe2] text-xs sm:text-sm max-w-xl mx-auto leading-relaxed font-normal">
                Have questions regarding cultural fair schedules, vendor stall allocations, ticket pass reservations, or staff recruitment? Reach out to our central operations desk.
            </p>
        </div>

        <!-- Torn / Ripped Paper Wave SVG Edge Divider -->
        <div class="absolute -bottom-1 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
            <svg class="relative block w-full h-12 sm:h-16 text-[#eef3eb]" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
                <path d="M0,0 L25,20 L55,5 L85,25 L120,8 L155,22 L190,6 L230,24 L270,10 L310,22 L350,7 L390,25 L430,9 L470,24 L510,8 L550,22 L590,7 L630,25 L670,9 L710,23 L750,7 L790,24 L830,10 L870,22 L910,8 L950,25 L990,9 L1030,24 L1070,8 L1110,22 L1150,9 L1200,20 L1200,120 L0,120 Z"></path>
            </svg>
        </div>
    </div>

    <!-- 2. Three Info Cards (Overlapping Hero) -->
    <div class="max-w-5xl mx-auto -mt-12 sm:-mt-16 relative z-20 px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            
            <!-- Card 1: Support Hotline -->
            <div class="bg-[#fbfaf4] rounded-[2rem] p-7 border border-[#e8e4d2] shadow-lg flex flex-col justify-between hover:shadow-xl transition-all">
                <div>
                    <!-- Circular Icon Badge -->
                    <div class="w-12 h-12 rounded-full bg-[#2e5d26] text-white flex items-center justify-center text-lg mb-5 shadow">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <span class="text-[10px] font-bold uppercase text-[#2e5d26] tracking-wider">Ticketing Hotline</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">+880 (02) 987-6543</h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-6">
                        Direct phone assistance for visitor pass issues, bulk admission bookings, and general fair schedule inquiries.
                    </p>
                </div>
                <div>
                    <a href="tel:+88029876543" class="inline-flex items-center gap-2 text-xs font-bold text-[#2e5d26] hover:text-[#1c3c18] transition">
                        <i class="fa-regular fa-circle-right"></i>
                        <span>Call Support Desk</span>
                    </a>
                </div>
            </div>

            <!-- Card 2: Email (Highlighted Dark Green Card) -->
            <div class="bg-[#244f21] rounded-[2rem] p-7 border border-[#31642d] shadow-2xl text-white flex flex-col justify-between md:-translate-y-2 hover:shadow-2xl transition-all">
                <div>
                    <!-- Circular Icon Badge (Light Green) -->
                    <div class="w-12 h-12 rounded-full bg-[#8cb748] text-white flex items-center justify-center text-lg mb-5 shadow">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <span class="text-[10px] font-bold uppercase text-[#8cb748] tracking-wider">Vendor &amp; Stalls Desk</span>
                    <h3 class="text-lg sm:text-xl font-bold text-white mb-2">support@melafair.com</h3>
                    <p class="text-xs text-white/80 leading-relaxed mb-6">
                        Email our event management desk for stall licensing queries, corporate festival partnerships, and technical support.
                    </p>
                </div>
                <div>
                    <a href="mailto:support@melafair.com" class="inline-flex items-center gap-2 text-xs font-bold text-[#a7cc9c] hover:text-white transition">
                        <i class="fa-regular fa-circle-right"></i>
                        <span>Send Email</span>
                    </a>
                </div>
            </div>

            <!-- Card 3: Central Operations HQ -->
            <div class="bg-[#fbfaf4] rounded-[2rem] p-7 border border-[#e8e4d2] shadow-lg flex flex-col justify-between hover:shadow-xl transition-all">
                <div>
                    <!-- Circular Icon Badge -->
                    <div class="w-12 h-12 rounded-full bg-[#2e5d26] text-white flex items-center justify-center text-lg mb-5 shadow">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <span class="text-[10px] font-bold uppercase text-[#2e5d26] tracking-wider">Operations Center</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">Suhrawardy Udyan, Dhaka</h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-6">
                        Central festival coordination headquarters and on-site vendor verification pavilion in Dhaka, Bangladesh.
                    </p>
                </div>
                <div>
                    <a href="#map" class="inline-flex items-center gap-2 text-xs font-bold text-[#2e5d26] hover:text-[#1c3c18] transition">
                        <i class="fa-regular fa-circle-right"></i>
                        <span>View on Map</span>
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- 3. Working Time & Map (Left) + Contact Form (Right) -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
            
            <!-- Left Column: Working Time & Location Map -->
            <div class="lg:col-span-6 space-y-6">
                
                <!-- Working Time Header -->
                <div>
                    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mb-2">
                        Fair Operating Hours
                    </h2>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        Our event staff and digital concurrency verification systems operate around the clock during active fair seasons.
                    </p>
                </div>

                <!-- Schedule List -->
                <div class="space-y-2.5 text-xs text-slate-700 font-medium pt-1">
                    <div class="flex items-center gap-2.5">
                        <i class="fa-solid fa-clock text-[#2e5d26] text-sm"></i>
                        <span>Fair Ground Hours : Everyday 8:00 AM - 10:00 PM</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <i class="fa-solid fa-store text-[#2e5d26] text-sm"></i>
                        <span>Stall Booking Desk : Monday - Saturday (9:00 AM - 6:00 PM)</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
                        <span>Digital Ticket Passes : Instant 24/7 Real-Time Concurrency</span>
                    </div>
                </div>

                <!-- Location Map Header -->
                <div class="pt-4">
                    <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-map-location-dot text-[#2e5d26]"></i>
                        <span>Event Location : Suhrawardy Udyan, Dhaka</span>
                    </h3>

                    <!-- Interactive Styled Map Box -->
                    <div id="map" class="rounded-2xl overflow-hidden shadow-md border border-slate-200 h-64 sm:h-72 w-full relative bg-slate-100">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3652.285885061614!2d90.39572247593257!3d23.73719468928096!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755b8ef6c747551%3A0xc3b8602b7811956!2sSuhrawardy%20Udyan!5e0!3m2!1sen!2sbd!4v1700000000000!5m2!1sen!2sbd" 
                            class="w-full h-full border-0" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>

            </div>

            <!-- Right Column: Get In Touch Contact Form -->
            <div class="lg:col-span-6 space-y-4">
                
                <!-- Pill Badge -->
                <div>
                    <span class="inline-block px-4 py-1 rounded-full border border-[#2e5d26]/30 text-[#2e5d26] text-xs font-bold bg-[#e5efe2]">
                        Inquiries &amp; Support
                    </span>
                </div>

                <!-- Headline -->
                <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
                    Get In Touch !
                </h2>
                <p class="text-xs text-slate-500">
                    Send your inquiry regarding fair scheduling, stall leasing, or ticket passes.
                </p>

                <!-- Form Card with Soft Cream Inputs -->
                <div class="bg-white rounded-[2rem] p-7 sm:p-9 border border-slate-100 shadow-xl">
                    <form asp-controller="Home" asp-action="Contact" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <!-- Email Field -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address</label>
                            <input type="email" name="email" placeholder="you@example.com" required 
                                   class="w-full bg-[#f6f2e8] text-slate-800 placeholder-slate-400 text-xs sm:text-sm px-5 py-3 rounded-full outline-none border border-[#e8dfcf] focus:ring-2 focus:ring-[#8cb748]/40 transition" />
                        </div>

                        <!-- Name Field -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Full Name</label>
                            <input type="text" name="name" placeholder="Your Name or Vendor Organization" required 
                                   class="w-full bg-[#f6f2e8] text-slate-800 placeholder-slate-400 text-xs sm:text-sm px-5 py-3 rounded-full outline-none border border-[#e8dfcf] focus:ring-2 focus:ring-[#8cb748]/40 transition" />
                        </div>

                        <!-- Message Field -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Inquiry Details</label>
                            <textarea name="message" rows="4" placeholder="Specify your stall booking, ticket pass, or general inquiry..." required 
                                      class="w-full bg-[#f6f2e8] text-slate-800 placeholder-slate-400 text-xs sm:text-sm px-5 py-3.5 rounded-3xl outline-none border border-[#e8dfcf] focus:ring-2 focus:ring-[#8cb748]/40 transition resize-none"></textarea>
                        </div>

                        <!-- Submit Button -->
                        <div class="pt-2">
                            <button type="submit" 
                                    class="px-8 py-3 rounded-full bg-[#8cb748] hover:bg-[#7ba33c] text-white text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-105 flex items-center gap-2">
                                <i class="fa-solid fa-paper-plane text-xs"></i>
                                <span>Send Inquiry</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>

        </div>
    </div>

</div>
