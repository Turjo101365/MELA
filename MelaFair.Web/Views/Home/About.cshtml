@{
    ViewData["Title"] = "About MELA - Enterprise Cultural Fair & Event Platform";
    var totalFairs = ViewBag.TotalFairsCount ?? 0;
    var totalTickets = ViewBag.TotalTicketsSoldCount ?? 0;
    var totalStalls = ViewBag.TotalStallsBookedCount ?? 0;
}

<!-- Main About Page Container -->
<div class="-mx-3 sm:-mx-6 lg:-mx-10 -mt-2 sm:-mt-3 space-y-12">

    <!-- 1. Hero Banner with Cultural Gradient & Curved Divider -->
    <div class="relative text-white overflow-hidden pt-12 pb-20 sm:pb-24 px-6 sm:px-12 text-center"
         style="background: linear-gradient(135deg, rgba(18, 36, 16, 0.94) 0%, rgba(32, 65, 27, 0.88) 55%, rgba(46, 93, 38, 0.82) 100%), url('https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?auto=format&fit=crop&w=1800&q=80') center/cover no-repeat;">
        
        <div class="max-w-3xl mx-auto space-y-5 relative z-10">
            <!-- Pill Badge -->
            <div>
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-xs font-bold tracking-wide text-[#e5efe2] shadow-sm">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
                    <span>Next-Gen Enterprise Event Core</span>
                </span>
            </div>

            <!-- Main Title -->
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight drop-shadow-md leading-tight">
                Digitizing Cultural Fairs &amp; Community Events
            </h1>

            <!-- Subtitle -->
            <p class="text-[#d0e5cc] text-xs sm:text-sm lg:text-base max-w-2xl mx-auto leading-relaxed font-normal">
                MELA is an enterprise-grade event management platform built with ASP.NET Core MVC (C#) and SQL Server. We bridge tradition and modern technology to deliver race-condition-safe stall leasing, digital ticketing, and event recruitment across Bangladesh.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-3 pt-3">
                <a asp-controller="Fair" asp-action="Index" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs sm:text-sm font-bold shadow-lg transition-all hover:scale-105 active:scale-95" aria-label="Explore Active Cultural Fairs">
                    <i class="fa-solid fa-compass"></i>
                    <span>Explore Fairs</span>
                </a>
                <a asp-controller="Vendor" asp-action="Marketplace" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/30 text-white text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-105 active:scale-95" aria-label="Browse Stall Marketplace">
                    <i class="fa-solid fa-store"></i>
                    <span>Stall Marketplace</span>
                </a>
                <a asp-controller="Home" asp-action="Contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs sm:text-sm font-black shadow-md transition-all hover:scale-105 active:scale-95" aria-label="Contact Secretariat Desk">
                    <i class="fa-solid fa-headset"></i>
                    <span>Get in Touch</span>
                </a>
            </div>
        </div>

        <!-- Wave SVG Curve Divider -->
        <div class="absolute -bottom-1 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
            <svg class="relative block w-full h-10 sm:h-16 text-[#eef3eb]" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
                <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
            </svg>
        </div>
    </div>

    <!-- 2. Live Performance & Scale Statistics Grid -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
            
            <div class="bg-white rounded-3xl p-5 sm:p-6 border border-[#dce8d8] shadow-sm hover:shadow-md transition-all text-center space-y-2 group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-tent-arrow-left-right"></i>
                </div>
                <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">@totalFairs</div>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active Fairs</div>
            </div>

            <div class="bg-white rounded-3xl p-5 sm:p-6 border border-[#dce8d8] shadow-sm hover:shadow-md transition-all text-center space-y-2 group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">@totalTickets</div>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Passes Issued</div>
            </div>

            <div class="bg-white rounded-3xl p-5 sm:p-6 border border-[#dce8d8] shadow-sm hover:shadow-md transition-all text-center space-y-2 group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-store"></i>
                </div>
                <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">@totalStalls</div>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Stalls Leased</div>
            </div>

            <div class="bg-white rounded-3xl p-5 sm:p-6 border border-[#dce8d8] shadow-sm hover:shadow-md transition-all text-center space-y-2 group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-sky-100 text-sky-800 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">100%</div>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">ACID Concurrency</div>
            </div>

        </div>
    </div>

    <!-- 3. Purpose & Mission Grid -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="bg-[#f6f9f3] rounded-[2.5rem] p-6 sm:p-10 lg:p-14 border border-[#dce8d8] shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Left: Cultural Fair Showcase Card -->
                <div class="lg:col-span-5 relative">
                    <div class="rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-white group relative">
                        <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=900&q=80" 
                             alt="Traditional Mela Gathering" 
                             class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-500" />
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex flex-col justify-end p-6 text-white">
                            <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-600/90 text-white px-2.5 py-1 rounded-full w-max mb-1">
                                Cultural Heritage
                            </span>
                            <h3 class="text-lg font-bold">Connecting Tradition with High Tech</h3>
                            <p class="text-xs text-slate-200">Preserving community festivals through modern digital access.</p>
                        </div>
                    </div>
                </div>

                <!-- Right: Purpose & Vision Text -->
                <div class="lg:col-span-7 space-y-6">
                    <div>
                        <span class="text-xs font-black uppercase tracking-widest text-[#4e8740] bg-[#e5efe2] px-3.5 py-1 rounded-full">
                            Our Mission &amp; Purpose
                        </span>
                        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mt-3">
                            Building a Unified Ecosystem for Cultural Fairs
                        </h2>
                    </div>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        Traditional fairs (Melas) such as Boishakhi Mela, Folk Expos, and Artisan Exhibitions are central to Bangladeshi heritage. However, legacy event organization faces major hurdles: double-booked vendor stalls, gate congestion, lack of real-time ticketing analytics, and informal staff recruitment.
                    </p>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        <strong>MELA</strong> was engineered to solve these challenges. By combining ASP.NET Core MVC with SQL Server ACID transactions, MELA ensures synchronized stall reservations, hassle-free visitor pass management, and automated staff hiring desk for event organizers and small businesses.
                    </p>

                    <!-- Key Pillars List -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        <div class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-[#e2ece0] shadow-2xs">
                            <i class="fa-solid fa-circle-check text-[#2e5d26] text-base shrink-0"></i>
                            <span class="text-xs font-bold text-slate-800">Zero Double-Booking Guarantee</span>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-[#e2ece0] shadow-2xs">
                            <i class="fa-solid fa-circle-check text-[#2e5d26] text-base shrink-0"></i>
                            <span class="text-xs font-bold text-slate-800">Instant Digital Entry Passes</span>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-[#e2ece0] shadow-2xs">
                            <i class="fa-solid fa-circle-check text-[#2e5d26] text-base shrink-0"></i>
                            <span class="text-xs font-bold text-slate-800">Vendor Stall Marketplace</span>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-[#e2ece0] shadow-2xs">
                            <i class="fa-solid fa-circle-check text-[#2e5d26] text-base shrink-0"></i>
                            <span class="text-xs font-bold text-slate-800">Event Staff Recruitment Desk</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 4. Platform Capabilities Grid -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-black uppercase tracking-widest text-[#4e8740] bg-[#e5efe2] px-3.5 py-1 rounded-full">
                Platform Capabilities
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
                Designed for All Event Stakeholders
            </h2>
            <p class="text-xs sm:text-sm text-slate-600">
                A role-based architectural engine supporting Administrators, Vendors, Visitors, and Job Seekers.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <!-- Card 1: Admin Control -->
            <div class="bg-white rounded-3xl p-6 border border-[#dce8d8] shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-4 group">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-xl group-hover:bg-[#2e5d26] group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">Admin Control Desk</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Create multi-day cultural fairs, map venue layouts, configure stall pricing, manage total pass capacities, and monitor real-time sales revenue.
                    </p>
                </div>
                <a asp-controller="Admin" asp-action="Dashboard" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#2e5d26] group-hover:translate-x-1 transition-transform">
                    <span>Explore Dashboard</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>

            <!-- Card 2: Vendor Stalls -->
            <div class="bg-white rounded-3xl p-6 border border-[#dce8d8] shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-4 group">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl group-hover:bg-amber-600 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-store"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">Vendor Stall Leasing</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Browse active fair floorplans, select high-footfall stall zones, reserve stalls with SQL concurrency locking, and post job vacancies for staff.
                    </p>
                </div>
                <a asp-controller="Vendor" asp-action="Marketplace" class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 group-hover:translate-x-1 transition-transform">
                    <span>View Marketplace</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>

            <!-- Card 3: Visitor Passes -->
            <div class="bg-white rounded-3xl p-6 border border-[#dce8d8] shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-4 group">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-ticket"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">Visitor Passes &amp; Entry</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Secure instant admission passes, select entry dates, receive digital ticket codes, and experience fast-track entry at event turnstiles.
                    </p>
                </div>
                <a asp-controller="Visitor" asp-action="BrowseFairs" class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 group-hover:translate-x-1 transition-transform">
                    <span>Browse Passes</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>

            <!-- Card 4: Staff Recruitment -->
            <div class="bg-white rounded-3xl p-6 border border-[#dce8d8] shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-4 group">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-800 flex items-center justify-center text-xl group-hover:bg-sky-600 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">Staff Recruitment Hub</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Empower local employment by connecting event organizers and vendors with temporary fair staff, security personnel, and customer service teams.
                    </p>
                </div>
                <a asp-controller="Employee" asp-action="JobListings" class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 group-hover:translate-x-1 transition-transform">
                    <span>Explore Jobs</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>

        </div>
    </div>

    <!-- 5. Technology Stack & Architectural Integrity Card -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="bg-white rounded-[2.5rem] p-8 sm:p-12 border border-[#dce8d8] shadow-sm space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-[#e2ece0]">
                <div>
                    <span class="text-xs font-black uppercase tracking-widest text-[#4e8740] bg-[#e5efe2] px-3.5 py-1 rounded-full">
                        Technical Architecture
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-2">
                        Engineered for High Concurrency &amp; Reliability
                    </h2>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1.5 rounded-full bg-slate-900 text-amber-300 font-mono text-xs font-bold flex items-center gap-2">
                        <i class="fa-solid fa-database"></i>
                        <span>SQL Server 2022</span>
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-700">
                
                <div class="space-y-2 p-4 bg-[#f6f9f4] rounded-2xl border border-[#e2ece0]">
                    <div class="flex items-center gap-2 font-bold text-slate-900 text-sm">
                        <i class="fa-solid fa-layer-group text-[#2e5d26]"></i>
                        <span>ASP.NET Core 8 MVC</span>
                    </div>
                    <p class="text-slate-600 leading-relaxed">
                        Clean Model-View-Controller architecture with dependency injection, asynchronous service pattern, custom view models, and cookie-based identity authentication.
                    </p>
                </div>

                <div class="space-y-2 p-4 bg-[#f6f9f4] rounded-2xl border border-[#e2ece0]">
                    <div class="flex items-center gap-2 font-bold text-slate-900 text-sm">
                        <i class="fa-solid fa-lock text-[#2e5d26]"></i>
                        <span>Race-Condition Lock Protection</span>
                    </div>
                    <p class="text-slate-600 leading-relaxed">
                        High-concurrency stall reservations backed by SQL Server transaction hints (`UPDLOCK`, `ROWLOCK`) preventing race conditions during simultaneous vendor checkouts.
                    </p>
                </div>

                <div class="space-y-2 p-4 bg-[#f6f9f4] rounded-2xl border border-[#e2ece0]">
                    <div class="flex items-center gap-2 font-bold text-slate-900 text-sm">
                        <i class="fa-solid fa-palette text-[#2e5d26]"></i>
                        <span>Tailwind CSS &amp; Fluid Design</span>
                    </div>
                    <p class="text-slate-600 leading-relaxed">
                        Custom `poulls` green color palette, Plus Jakarta Sans typography, responsive layout breakpoints, glassmorphism cards, and interactive modal drawers.
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- 6. Call To Action Footer Card -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="relative bg-gradient-to-r from-[#1c3c18] via-[#244f21] to-[#2e5d26] text-white rounded-[2.5rem] p-8 sm:p-12 text-center overflow-hidden shadow-xl">
            <!-- Decorative circles -->
            <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
            <div class="absolute -left-16 -top-16 w-64 h-64 bg-amber-400/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="max-w-2xl mx-auto space-y-4 relative z-10">
                <h2 class="text-2xl sm:text-4xl font-black tracking-tight text-white">
                    Ready to Experience MELA?
                </h2>
                <p class="text-xs sm:text-sm text-[#d0e5cc] leading-relaxed">
                    Join thousands of visitors, vendors, and event staff celebrating cultural heritage on Bangladesh's leading fair management platform.
                </p>

                <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
                    <a asp-controller="Fair" asp-action="Index" class="px-6 py-3 rounded-full bg-white text-[#1c3c18] hover:bg-[#e5efe2] text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-105">
                        <i class="fa-solid fa-compass mr-1.5"></i> Explore Fairs Now
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="px-6 py-3 rounded-full bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs sm:text-sm font-black shadow-md transition-all hover:scale-105">
                        <i class="fa-solid fa-user-plus mr-1.5"></i> Create an Account
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
