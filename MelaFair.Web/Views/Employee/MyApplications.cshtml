@model MelaFair.Web.Models.ViewModels.MyApplicationsViewModel
@{
    ViewData["Title"] = "My Job Applications & Status";
    var totalApps = Model.Applications.Count;
    var acceptedCount = Model.Applications.Count(a => a.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted);
    var shortlistedCount = Model.Applications.Count(a => a.Status == MelaFair.Core.Enums.ApplicationStatus.Shortlisted);
    var pendingCount = Model.Applications.Count(a => a.Status == MelaFair.Core.Enums.ApplicationStatus.Pending);
}

<div class="space-y-8">

    <!-- 1. Header Banner -->
    <div class="bg-white rounded-[2.5rem] border border-[#dce8d8] p-6 sm:p-8 lg:p-10 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#e5efe2] text-[#2e5d26] text-xs font-bold">
                <i class="fa-solid fa-clipboard-check text-amber-600"></i>
                <span>Candidate Portal &bull; Applicant Tracker</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#142a12] tracking-tight">
                My Job Applications
            </h1>
            <p class="text-xs sm:text-sm text-slate-500">
                Track your submitted applications, interview reviews, and festival on-site hiring status.
            </p>
        </div>

        <a asp-controller="Employee" asp-action="JobListings" class="px-5 py-2.5 rounded-full bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-xs shadow-md transition-all hover:scale-105 flex items-center gap-2 self-start md:self-auto">
            <i class="fa-solid fa-plus"></i>
            <span>Browse More Openings</span>
        </a>
    </div>

    <!-- 2. Application Metrics Summary (4 Cards) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-[#dce8d8] shadow-sm flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-lg font-bold shrink-0">
                <i class="fa-solid fa-paper-plane"></i>
            </div>
            <div>
                <span class="text-xl sm:text-2xl font-black text-[#142a12] block">@totalApps</span>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Applied</span>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-[#dce8d8] shadow-sm flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg font-bold shrink-0">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>
            <div>
                <span class="text-xl sm:text-2xl font-black text-amber-600 block">@pendingCount</span>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Under Review</span>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-[#dce8d8] shadow-sm flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold shrink-0">
                <i class="fa-solid fa-star"></i>
            </div>
            <div>
                <span class="text-xl sm:text-2xl font-black text-blue-600 block">@shortlistedCount</span>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Shortlisted</span>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-[#dce8d8] shadow-sm flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg font-bold shrink-0">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <span class="text-xl sm:text-2xl font-black text-emerald-600 block">@acceptedCount</span>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Accepted &amp; Hired</span>
            </div>
        </div>
    </div>

    <!-- 3. Applications List -->
    @if (!Model.Applications.Any())
    {
        <div class="bg-white rounded-[2.5rem] border border-[#dce8d8] p-12 sm:p-16 text-center space-y-4 shadow-sm max-w-lg mx-auto">
            <div class="w-16 h-16 rounded-full bg-[#eef4ed] text-[#2e5d26] mx-auto flex items-center justify-center text-2xl font-bold">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <h2 class="text-lg font-bold text-slate-900">No Job Applications Yet</h2>
            <p class="text-xs text-slate-500 leading-relaxed max-w-sm mx-auto">
                You haven't submitted applications for any fair ground roles yet. Explore our open positions across ticketing, security, and festival operations.
            </p>
            <div class="pt-2">
                <a asp-controller="Employee" asp-action="JobListings" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-xs shadow-md transition-all hover:scale-105">
                    <i class="fa-solid fa-compass"></i>
                    <span>Browse Open Positions</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var app in Model.Applications)
            {
                <div class="bg-white rounded-[2rem] border border-[#dce8d8] shadow-sm hover:shadow-md transition p-6 sm:p-8 space-y-6">
                    
                    <!-- Top Bar: Role & Status -->
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-[#eef3eb] pb-5">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-bold text-[#2e5d26] bg-[#e5efe2] uppercase tracking-wider px-2.5 py-0.5 rounded-full">
                                    @app.Department
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">
                                    Ref: #MF-APP-@app.ApplicationId
                                </span>
                            </div>
                            <h2 class="text-xl font-bold text-[#142a12]">@app.JobTitle</h2>
                            <p class="text-xs text-slate-500 flex items-center gap-1.5 font-medium">
                                <i class="fa-solid fa-landmark text-[#2e5d26]"></i>
                                <span>@app.FairTitle</span>
                            </p>
                        </div>

                        <div class="flex flex-col sm:items-end gap-1.5">
                            <div class="text-right">
                                <span class="text-xs font-black text-[#142a12] bg-[#f4f8f3] px-3 py-1 rounded-full border border-[#dce8d8] inline-block">
                                    &#2547;@app.DailyWage.ToString("N0") / day
                                </span>
                            </div>

                            <!-- Status Badge -->
                            <div>
                                @switch (app.Status)
                                {
                                    case MelaFair.Core.Enums.ApplicationStatus.Accepted:
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center gap-1.5">
                                            <i class="fa-solid fa-circle-check text-emerald-600"></i>
                                            <span>Accepted &bull; Hired</span>
                                        </span>
                                        break;
                                    case MelaFair.Core.Enums.ApplicationStatus.Shortlisted:
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300 flex items-center gap-1.5">
                                            <i class="fa-solid fa-star text-blue-600"></i>
                                            <span>Shortlisted for Interview</span>
                                        </span>
                                        break;
                                    case MelaFair.Core.Enums.ApplicationStatus.Rejected:
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 flex items-center gap-1.5">
                                            <i class="fa-solid fa-circle-xmark text-rose-600"></i>
                                            <span>Position Filled</span>
                                        </span>
                                        break;
                                    default:
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300 flex items-center gap-1.5">
                                            <i class="fa-solid fa-clock text-amber-600"></i>
                                            <span>Review in Progress</span>
                                        </span>
                                        break;
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 4-Step Recruitment Progress Bar -->
                    <div class="py-2">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-3">
                            Application Lifecycle Stage
                        </span>
                        
                        <div class="grid grid-cols-4 gap-2 text-center text-xs">
                            <!-- Step 1: Submitted -->
                            <div class="space-y-1.5">
                                <div class="w-full h-1.5 rounded-full bg-[#2e5d26]"></div>
                                <span class="text-[11px] font-bold text-[#2e5d26] block">1. Submitted</span>
                            </div>

                            <!-- Step 2: Under Review -->
                            <div class="space-y-1.5">
                                <div class="w-full h-1.5 rounded-full @(app.Status != MelaFair.Core.Enums.ApplicationStatus.Pending ? "bg-[#2e5d26]" : "bg-amber-400")"></div>
                                <span class="text-[11px] font-bold @(app.Status == MelaFair.Core.Enums.ApplicationStatus.Pending ? "text-amber-600" : "text-[#2e5d26]") block">2. Review</span>
                            </div>

                            <!-- Step 3: Shortlisted -->
                            <div class="space-y-1.5">
                                <div class="w-full h-1.5 rounded-full @(app.Status == MelaFair.Core.Enums.ApplicationStatus.Shortlisted || app.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted ? "bg-[#2e5d26]" : "bg-slate-200")"></div>
                                <span class="text-[11px] font-bold @(app.Status == MelaFair.Core.Enums.ApplicationStatus.Shortlisted ? "text-blue-600" : (app.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted ? "text-[#2e5d26]" : "text-slate-400")) block">3. Shortlist</span>
                            </div>

                            <!-- Step 4: Decision / Onboarding -->
                            <div class="space-y-1.5">
                                <div class="w-full h-1.5 rounded-full @(app.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted ? "bg-emerald-500" : (app.Status == MelaFair.Core.Enums.ApplicationStatus.Rejected ? "bg-rose-400" : "bg-slate-200"))"></div>
                                <span class="text-[11px] font-bold @(app.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted ? "text-emerald-700" : (app.Status == MelaFair.Core.Enums.ApplicationStatus.Rejected ? "text-rose-600" : "text-slate-400")) block">4. Final</span>
                            </div>
                        </div>
                    </div>

                    <!-- Status Instructions Callout -->
                    @if (app.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted)
                    {
                        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 flex items-start gap-3 text-xs text-emerald-900">
                            <i class="fa-solid fa-bullhorn text-emerald-600 text-sm mt-0.5 shrink-0"></i>
                            <div>
                                <strong class="font-bold block text-emerald-950 mb-0.5">Congratulations! You have been selected.</strong>
                                <span>Please report to the Fair Operations Secretariat (Room 104, Suhrawardy Udyan) 2 days prior to the festival opening with your original National ID/Student ID card for uniform and badge issuance.</span>
                            </div>
                        </div>
                    }
                    else if (app.Status == MelaFair.Core.Enums.ApplicationStatus.Shortlisted)
                    {
                        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 flex items-start gap-3 text-xs text-blue-900">
                            <i class="fa-solid fa-phone-volume text-blue-600 text-sm mt-0.5 shrink-0"></i>
                            <div>
                                <strong class="font-bold block text-blue-950 mb-0.5">Shortlisted for Phone / Ground Briefing</strong>
                                <span>Your profile has been shortlisted. Our festival recruitment coordinator will contact your registered phone number shortly for shift confirmation.</span>
                            </div>
                        </div>
                    }
                    else if (app.Status == MelaFair.Core.Enums.ApplicationStatus.Pending)
                    {
                        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-start gap-3 text-xs text-amber-900">
                            <i class="fa-solid fa-hourglass-start text-amber-600 text-sm mt-0.5 shrink-0"></i>
                            <div>
                                <strong class="font-bold block text-amber-950 mb-0.5">Application Under Active Screening</strong>
                                <span>Our event operations team is currently reviewing submissions. Applications are processed in order of receipt.</span>
                            </div>
                        </div>
                    }

                    <!-- Resume Summary Snippet -->
                    <div class="bg-[#f6f9f4] rounded-2xl p-4 text-xs space-y-1 text-slate-600 border border-[#e2ece0]">
                        <span class="font-bold text-[#142a12] block text-[10px] uppercase tracking-wider">Submitted Resume / Background Statement:</span>
                        <p class="italic leading-relaxed">"@app.ResumeSummary"</p>
                    </div>

                    <!-- Footer Details -->
                    <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium pt-1">
                        <span>Submitted on: @app.ApplicationDate.ToString("MMMM dd, yyyy")</span>
                        <a asp-controller="Home" asp-action="Contact" class="text-xs font-bold text-[#2e5d26] hover:text-[#142a12] transition flex items-center gap-1">
                            <i class="fa-solid fa-headset"></i>
                            <span>Contact Recruitment Desk</span>
                        </a>
                    </div>

                </div>
            }
        </div>
    }

</div>
