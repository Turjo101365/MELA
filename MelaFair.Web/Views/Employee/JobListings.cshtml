@model IEnumerable<MelaFair.Web.Models.Entities.JobPosting>
@{
    ViewData["Title"] = "Fair Staff Employment Opportunities";
}

<div class="space-y-8">
    <!-- Header -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-800">
                💼 Employee Recruitment Board
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">Fair Ground Employment Openings</h1>
            <p class="text-xs sm:text-sm text-slate-500">
                Apply for event operations, ticketing, sound engineering, and ground security positions (<code class="text-purple-700 font-mono">usp_RecruitEmployee</code>).
            </p>
        </div>

        @if (User.IsInRole(RoleConstants.Employee))
        {
            <a asp-controller="Employee" asp-action="MyApplications" class="px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md transition self-start md:self-auto whitespace-nowrap">
                📋 My Applications
            </a>
        }
    </div>

    <!-- Job Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var job in Model)
        {
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:border-purple-300 transition festival-card space-y-4">
                <div class="space-y-3">
                    <div class="flex items-start justify-between">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-50 text-purple-700">
                            @job.Department
                        </span>
                        <span class="text-xs font-black text-slate-900 bg-slate-100 px-2.5 py-1 rounded-lg">
                            $@job.DailyWage.ToString("N0") / day
                        </span>
                    </div>

                    <div>
                        <h2 class="text-base font-bold text-slate-900">@job.Title</h2>
                        <span class="text-xs text-slate-500 font-medium">🎪 @job.Fair?.Title</span>
                    </div>

                    <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                        @job.Description
                    </p>

                    <div class="bg-slate-50 rounded-xl p-3 text-[11px] space-y-1 text-slate-600">
                        <span class="font-bold text-slate-800 block">Requirements:</span>
                        <p class="line-clamp-2">@job.Requirements</p>
                    </div>

                    <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                        <span>Openings: @(job.PositionsAvailable - job.PositionsFilled) left</span>
                        <span>Deadline: @job.ApplicationDeadline.ToString("MMM dd")</span>
                    </div>
                </div>

                <div class="pt-2 border-t border-slate-100">
                    <a asp-controller="Employee" asp-action="Apply" asp-route-jobPostingId="@job.JobPostingId" class="block text-center w-full py-2.5 px-4 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-md shadow-purple-600/20 transition">
                        Apply for Position &rarr;
                    </a>
                </div>
            </div>
        }
    </div>
</div>
