@{
    Layout = "_Layout";
}

<div class="space-y-6">
    <!-- Admin Breadcrumb / Quick Nav -->
    <div class="bg-white rounded-3xl border border-[#dbe6d6] p-4 sm:p-5 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center space-x-3.5">
            <div class="w-10 h-10 rounded-2xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold shadow-xs">
                <i class="fa-solid fa-sliders text-sm"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-black text-[#1c3c18]">Admin Control Center</h1>
                <p class="text-xs text-[#557b4f] font-medium">Fair Provisioning &bull; Concurrency Stored Procedures &bull; SQL Views</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <a asp-controller="Admin" asp-action="Dashboard" class="px-4 py-2 text-xs font-bold rounded-full @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "bg-[#2e5d26] text-white shadow-sm shadow-[#2e5d26]/20" : "bg-[#e5efe2] text-[#2e5d26] hover:bg-[#d8ebd4]") transition-all duration-200">
                Overview
            </a>
            <a asp-controller="Admin" asp-action="CreateFair" class="px-4 py-2 text-xs font-bold rounded-full @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateFair" ? "bg-[#2e5d26] text-white shadow-sm shadow-[#2e5d26]/20" : "bg-[#e5efe2] text-[#2e5d26] hover:bg-[#d8ebd4]") transition-all duration-200">
                + Create Fair
            </a>
            <a asp-controller="Admin" asp-action="ManageFairs" class="px-4 py-2 text-xs font-bold rounded-full @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageFairs" ? "bg-[#2e5d26] text-white shadow-sm shadow-[#2e5d26]/20" : "bg-[#e5efe2] text-[#2e5d26] hover:bg-[#d8ebd4]") transition-all duration-200">
                Manage Events
            </a>
            <a asp-controller="Admin" asp-action="Analytics" class="px-4 py-2 text-xs font-bold rounded-full @(ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "bg-[#2e5d26] text-white shadow-sm shadow-[#2e5d26]/20" : "bg-[#e5efe2] text-[#2e5d26] hover:bg-[#d8ebd4]") transition-all duration-200">
                Analytics (Views)
            </a>
        </div>
    </div>

    @RenderBody()
</div>

@await RenderSectionAsync("Scripts", required: false)
