@using Microsoft.AspNetCore.Identity
@using MelaFair.Core.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#eef3eb]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MELA Fair &amp; Event Management</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVJkEZSMUkrQ6usKGiOL6NwAn2NAIj50tnMYrQIEQrUreQ/yKxeFJ7cuB67v7/QIxxNNUul3obQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        poulls: {
                            50: '#f4f8f3',
                            100: '#e5efe2',
                            200: '#cce0c6',
                            300: '#9fc193',
                            400: '#73a466',
                            500: '#4e8740',
                            600: '#386c2c',
                            700: '#2e5d26',
                            800: '#23491f',
                            900: '#1c3c18',
                            950: '#0e200c'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full bg-[#eef3eb] text-slate-800 antialiased selection:bg-[#2e5d26] selection:text-white">

    <!-- Outer Frame Container -->
    <div class="w-full max-w-[1400px] mx-auto min-h-screen flex flex-col px-3 sm:px-6 lg:px-10 py-2 sm:py-3">

        <!-- Floating Capsule Navigation Bar -->
        <header class="sticky top-2 sm:top-3 z-50 mb-6 transition-all duration-300">
            <nav id="mainNavbar" class="nav-capsule bg-white/95 backdrop-blur-md rounded-full px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 shadow-md border border-[#dbe6d6] flex items-center justify-between transition-all">
                
                <!-- Logo & Brand (MELA FAIR) -->
                <div class="flex items-center gap-6 lg:gap-8">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2.5 group select-none">
                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-gradient-to-tr from-[#1c3c18] via-[#244f21] to-[#2e5d26] text-white flex items-center justify-center font-black text-lg shadow-sm group-hover:scale-105 group-hover:rotate-6 group-hover:shadow-md group-hover:shadow-emerald-900/20 transition-all duration-300">
                            M
                        </div>
                        <div class="flex flex-col">
                            <div class="flex items-center gap-1.5 leading-none">
                                <span class="text-xl sm:text-2xl font-black tracking-tight text-[#1c3c18] group-hover:text-[#2e5d26] transition-colors">
                                    MELA
                                </span>
                                <span class="text-[10px] font-black uppercase tracking-wider text-[#2e5d26] bg-[#e5efe2] group-hover:bg-[#2e5d26] group-hover:text-white px-2 py-0.5 rounded-full transition-all duration-300 shadow-xs">
                                    FAIR
                                </span>
                            </div>
                            <span class="text-[9px] text-[#557b4f] font-semibold uppercase tracking-wider mt-0.5">
                                Enterprise Event Core
                            </span>
                        </div>
                    </a>

                    <!-- Desktop Navigation Links -->
                    <div class="hidden md:flex items-center space-x-1 lg:space-x-1.5 text-xs lg:text-sm font-semibold text-[#40543e]">
                        <a asp-controller="Home" asp-action="Index" 
                           class="px-3 py-1.5 rounded-full transition-all duration-200 @(currentCtrl == "Home" && currentAct == "Index" ? "bg-[#e5efe2] text-[#2e5d26] font-bold shadow-xs" : "hover:text-[#2e5d26] hover:bg-[#e5efe2]/60")">
                            Home
                        </a>
                        <a asp-controller="Fair" asp-action="Index" 
                           class="px-3 py-1.5 rounded-full transition-all duration-200 @(currentCtrl == "Fair" ? "bg-[#e5efe2] text-[#2e5d26] font-bold shadow-xs" : "hover:text-[#2e5d26] hover:bg-[#e5efe2]/60")">
                            Explore Fairs
                        </a>
                        <a asp-controller="Vendor" asp-action="Marketplace" 
                           class="px-3 py-1.5 rounded-full transition-all duration-200 @(currentCtrl == "Vendor" && currentAct == "Marketplace" ? "bg-[#e5efe2] text-[#2e5d26] font-bold shadow-xs" : "hover:text-[#2e5d26] hover:bg-[#e5efe2]/60")">
                            Vendor Stalls
                        </a>
                        <a asp-controller="Visitor" asp-action="BrowseFairs" 
                           class="px-3 py-1.5 rounded-full transition-all duration-200 @(currentCtrl == "Visitor" && (currentAct == "BrowseFairs" || currentAct == "TicketBooking") ? "bg-[#e5efe2] text-[#2e5d26] font-bold shadow-xs" : "hover:text-[#2e5d26] hover:bg-[#e5efe2]/60")">
                            Passes
                        </a>
                        <a asp-controller="Employee" asp-action="JobListings" 
                           class="px-3 py-1.5 rounded-full transition-all duration-200 @(currentCtrl == "Employee" && currentAct == "JobListings" ? "bg-[#e5efe2] text-[#2e5d26] font-bold shadow-xs" : "hover:text-[#2e5d26] hover:bg-[#e5efe2]/60")">
                            Staff Jobs
                        </a>
                        <a asp-controller="Home" asp-action="Contact" 
                           class="px-3 py-1.5 rounded-full transition-all duration-200 @(currentCtrl == "Home" && currentAct == "Contact" ? "bg-[#e5efe2] text-[#2e5d26] font-bold shadow-xs" : "hover:text-[#2e5d26] hover:bg-[#e5efe2]/60")">
                            Contact
                        </a>

                        @if (User.IsInRole(RoleConstants.Admin))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#e5efe2] hover:bg-[#d6e7d1] hover:scale-105 transition-all shadow-xs">
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2e5d26] opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2e5d26]"></span>
                                </span>
                                <span>Admin Panel</span>
                            </a>
                        }
                        @if (User.IsInRole(RoleConstants.Vendor))
                        {
                            <a asp-controller="Vendor" asp-action="Dashboard" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#e5efe2] hover:bg-[#d6e7d1] hover:scale-105 transition-all shadow-xs">
                                <i class="fa-solid fa-store text-xs"></i>
                                <span>My Stalls</span>
                            </a>
                            <a asp-controller="Vendor" asp-action="Jobs" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#e5efe2] hover:bg-[#d6e7d1] hover:scale-105 transition-all shadow-xs">
                                <i class="fa-solid fa-user-plus text-xs"></i>
                                <span>Staff Hiring</span>
                            </a>
                        }
                        @if (User.IsInRole(RoleConstants.Visitor))
                        {
                            <a asp-controller="Visitor" asp-action="MyTickets" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#e5efe2] hover:bg-[#d6e7d1] hover:scale-105 transition-all shadow-xs">
                                <i class="fa-solid fa-ticket text-xs"></i>
                                <span>My Passes</span>
                            </a>
                        }
                        @if (User.IsInRole(RoleConstants.Employee))
                        {
                            <a asp-controller="Employee" asp-action="MyApplications" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#e5efe2] hover:bg-[#d6e7d1] hover:scale-105 transition-all shadow-xs">
                                <i class="fa-solid fa-briefcase text-xs"></i>
                                <span>My Jobs</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Right Side Actions & Auth -->
                <div class="flex items-center space-x-2 sm:space-x-3">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="flex items-center space-x-2">
                            <span class="hidden xl:inline-flex items-center gap-1.5 text-xs font-bold text-[#2e5d26] bg-[#e5efe2] px-3.5 py-1.5 rounded-full shadow-xs border border-[#d2e4ce]">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                                @(currentUser?.FullName ?? User.Identity?.Name) &bull; @(currentUser?.UserRole ?? "User")
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3.5 py-1.5 text-xs font-semibold text-[#2e5d26] hover:bg-[#e5efe2] active:scale-95 rounded-full transition-all duration-200 flex items-center gap-1.5 border border-transparent hover:border-[#d2e4ce]">
                                    <i class="fa-solid fa-right-from-bracket text-[11px]"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <!-- Get Started Pill Button -->
                        <div class="flex items-center space-x-2">
                            <a asp-controller="Account" asp-action="Login" class="hidden sm:inline-block px-4 py-2 text-xs font-bold text-[#2e5d26] hover:bg-[#e5efe2] hover:scale-105 active:scale-95 rounded-full transition-all duration-200">
                                Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="relative group overflow-hidden inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-gradient-to-r from-[#2e5d26] to-[#3b7331] hover:from-[#23491f] hover:to-[#2e5d26] text-white text-xs sm:text-sm font-semibold shadow-md shadow-[#2e5d26]/20 hover:shadow-lg hover:shadow-[#2e5d26]/30 transition-all duration-300 hover:scale-105 active:scale-95">
                                <i class="fa-solid fa-ticket text-xs text-amber-300 group-hover:rotate-12 transition-transform duration-300"></i>
                                <span>Get Passes</span>
                            </a>
                        </div>
                    }

                    <!-- Mobile Hamburger Menu Button -->
                    <button id="mobileMenuBtn" type="button" class="md:hidden w-9 h-9 rounded-full bg-[#e5efe2] text-[#2e5d26] hover:bg-[#2e5d26] hover:text-white flex items-center justify-center transition-all duration-200 focus:outline-none" aria-label="Toggle Navigation Menu">
                        <i id="mobileMenuIcon" class="fa-solid fa-bars text-sm transition-transform duration-300"></i>
                    </button>
                </div>
            </nav>

            <!-- Animated Mobile Navigation Drawer -->
            <div id="mobileMenu" class="hidden md:hidden mt-2 bg-white/95 backdrop-blur-xl rounded-3xl p-5 shadow-2xl border border-[#dbe6d6] transition-all duration-300 ease-out origin-top opacity-0 -translate-y-3 pointer-events-none">
                <div class="flex flex-col space-y-2">
                    <a asp-controller="Home" asp-action="Index" class="px-4 py-2.5 rounded-2xl text-sm font-semibold flex items-center gap-3 transition-colors @(currentCtrl == "Home" && currentAct == "Index" ? "bg-[#e5efe2] text-[#2e5d26] font-bold" : "text-slate-700 hover:bg-[#eef5ec] hover:text-[#2e5d26]")">
                        <i class="fa-solid fa-house w-5 text-center text-emerald-600"></i>
                        <span>Home</span>
                    </a>
                    <a asp-controller="Fair" asp-action="Index" class="px-4 py-2.5 rounded-2xl text-sm font-semibold flex items-center gap-3 transition-colors @(currentCtrl == "Fair" ? "bg-[#e5efe2] text-[#2e5d26] font-bold" : "text-slate-700 hover:bg-[#eef5ec] hover:text-[#2e5d26]")">
                        <i class="fa-solid fa-compass w-5 text-center text-emerald-600"></i>
                        <span>Explore Fairs</span>
                    </a>
                    <a asp-controller="Vendor" asp-action="Marketplace" class="px-4 py-2.5 rounded-2xl text-sm font-semibold flex items-center gap-3 transition-colors @(currentCtrl == "Vendor" && currentAct == "Marketplace" ? "bg-[#e5efe2] text-[#2e5d26] font-bold" : "text-slate-700 hover:bg-[#eef5ec] hover:text-[#2e5d26]")">
                        <i class="fa-solid fa-store w-5 text-center text-emerald-600"></i>
                        <span>Vendor Stalls</span>
                    </a>
                    <a asp-controller="Visitor" asp-action="BrowseFairs" class="px-4 py-2.5 rounded-2xl text-sm font-semibold flex items-center gap-3 transition-colors @(currentCtrl == "Visitor" ? "bg-[#e5efe2] text-[#2e5d26] font-bold" : "text-slate-700 hover:bg-[#eef5ec] hover:text-[#2e5d26]")">
                        <i class="fa-solid fa-ticket w-5 text-center text-emerald-600"></i>
                        <span>Passes &amp; Tickets</span>
                    </a>
                    <a asp-controller="Employee" asp-action="JobListings" class="px-4 py-2.5 rounded-2xl text-sm font-semibold flex items-center gap-3 transition-colors @(currentCtrl == "Employee" ? "bg-[#e5efe2] text-[#2e5d26] font-bold" : "text-slate-700 hover:bg-[#eef5ec] hover:text-[#2e5d26]")">
                        <i class="fa-solid fa-briefcase w-5 text-center text-emerald-600"></i>
                        <span>Staff Jobs</span>
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="px-4 py-2.5 rounded-2xl text-sm font-semibold flex items-center gap-3 transition-colors @(currentCtrl == "Home" && currentAct == "Contact" ? "bg-[#e5efe2] text-[#2e5d26] font-bold" : "text-slate-700 hover:bg-[#eef5ec] hover:text-[#2e5d26]")">
                        <i class="fa-solid fa-headset w-5 text-center text-emerald-600"></i>
                        <span>Contact &amp; Support</span>
                    </a>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="pt-3 border-t border-[#e2ece0] mt-2 space-y-2">
                            <div class="px-4 py-1 text-xs font-bold text-[#2e5d26]">
                                Logged in as: @(currentUser?.FullName ?? User.Identity?.Name)
                            </div>
                            @if (User.IsInRole(RoleConstants.Admin))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-shield-halved"></i> Admin Control Center
                                </a>
                                <a asp-controller="Admin" asp-action="Stalls" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-store"></i> All Stalls & Leases
                                </a>
                                <a asp-controller="Admin" asp-action="Passes" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-ticket"></i> Passes & Capacity
                                </a>
                                <a asp-controller="Admin" asp-action="StaffJobs" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-briefcase"></i> Staff Recruitment Desk
                                </a>
                            }
                            @if (User.IsInRole(RoleConstants.Vendor))
                            {
                                <a asp-controller="Vendor" asp-action="Dashboard" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-store"></i> My Stalls
                                </a>
                                <a asp-controller="Vendor" asp-action="Jobs" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-user-plus"></i> Staff Hiring
                                </a>
                            }
                            @if (User.IsInRole(RoleConstants.Visitor))
                            {
                                <a asp-controller="Visitor" asp-action="MyTickets" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-ticket"></i> My Passes
                                </a>
                            }
                            @if (User.IsInRole(RoleConstants.Employee))
                            {
                                <a asp-controller="Employee" asp-action="MyApplications" class="px-4 py-2 rounded-2xl text-xs font-bold text-[#2e5d26] bg-[#e5efe2] flex items-center gap-2">
                                    <i class="fa-solid fa-briefcase"></i> My Applications
                                </a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="w-full">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full text-left px-4 py-2.5 rounded-2xl text-sm font-semibold text-rose-700 hover:bg-rose-50 flex items-center gap-3 transition">
                                    <i class="fa-solid fa-right-from-bracket w-5 text-center"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="pt-3 border-t border-[#e2ece0] mt-2 flex items-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="flex-1 text-center py-2.5 rounded-2xl bg-[#e5efe2] hover:bg-[#d8ebd4] text-[#2e5d26] text-xs font-bold transition">
                                Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="flex-1 text-center py-2.5 rounded-2xl bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs font-bold transition shadow-sm">
                                Register
                            </a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-grow w-full">
            @await Html.PartialAsync("_NotificationToast")
            @RenderBody()
        </main>

        <!-- Professional Enterprise Footer -->
        <footer class="relative bg-[#122410] text-[#c0dec0] rounded-[2.5rem] p-8 sm:p-12 lg:p-14 mt-16 shadow-2xl border border-[#23441f] overflow-hidden">
            <!-- Subtle decorative background gradient circles -->
            <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Top Row: Quick Header & Back-to-Top -->
            <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between pb-8 mb-8 border-b border-[#23441f] gap-4">
                <div class="flex items-center space-x-3 group select-none">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-emerald-600 to-emerald-400 text-white flex items-center justify-center font-black text-lg shadow-md group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
                        M
                    </div>
                    <div>
                        <span class="text-xl font-black text-white tracking-tight leading-none block">MELA FAIR</span>
                        <span class="text-[9px] text-emerald-400 font-bold uppercase tracking-widest">Enterprise Event Core</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="group flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 hover:bg-emerald-600 text-[#c0dec0] hover:text-white text-xs font-bold transition-all duration-300 hover:shadow-lg hover:shadow-emerald-900/40 hover:-translate-y-0.5 active:translate-y-0 border border-white/10 hover:border-emerald-500/50">
                        <span>Back to Top</span>
                        <i class="fa-solid fa-arrow-up text-[10px] group-hover:-translate-y-1 transition-transform duration-300"></i>
                    </button>
                </div>
            </div>

            <!-- Main Footer Links Grid (4 Professional Columns) -->
            <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
                
                <!-- Col 1: Brand & Architecture (lg:col-span-4) -->
                <div class="lg:col-span-4 space-y-4">
                    <p class="text-xs text-[#a2c59f] leading-relaxed">
                        A high-concurrency Fair &amp; Event management system built with ASP.NET Core MVC (C#) and SQL Server. Delivering synchronized multi-day fair scheduling, race-condition-safe stall leasing, and digital admission ticketing across Bangladesh.
                    </p>
                    
                    <!-- System Live Status & Dhaka Time -->
                    <div class="space-y-2 pt-1">
                        <div class="inline-flex items-center gap-2 text-[11px] text-[#8cb748] font-medium bg-white/5 px-3 py-1.5 rounded-full border border-white/5">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-sm shadow-emerald-400/50"></span>
                            </span>
                            <span>Core Operational &bull; Synchronized</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-[11px] text-[#a2c59f] font-mono pl-1">
                            <i class="fa-regular fa-clock text-emerald-400 text-xs"></i>
                            <span id="dhakaLiveTime">Dhaka Time: Loading...</span>
                        </div>
                    </div>

                    <!-- Social / Code Repositories -->
                    <div class="flex items-center space-x-2.5 pt-2">
                        <a href="https://github.com/Turjo101365/MELA" target="_blank" class="w-9 h-9 rounded-xl bg-white/5 hover:bg-emerald-600 text-white flex items-center justify-center text-sm transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-emerald-500/20" title="GitHub Repository">
                            <i class="fa-brands fa-github"></i>
                        </a>
                        <a asp-controller="Home" asp-action="Contact" class="w-9 h-9 rounded-xl bg-white/5 hover:bg-emerald-600 text-white flex items-center justify-center text-sm transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-emerald-500/20" title="Support Desk">
                            <i class="fa-solid fa-headset"></i>
                        </a>
                        <span class="text-[11px] text-[#71966c] pl-2 font-mono">v1.0-Release</span>
                    </div>
                </div>

                <!-- Col 2: Cultural Fairs Explorer (lg:col-span-3) -->
                <div class="lg:col-span-3">
                    <h3 class="text-xs font-black text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Cultural Fairs</span>
                    </h3>
                    <ul class="space-y-2.5 text-xs">
                        <li>
