@using Microsoft.AspNetCore.Identity
@using MelaFair.Core.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#eef3eb]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MELA Fair &amp; Event Management</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVJkEZSMUkrQ6usKGiOL6NwAn2NAIj50tnMYrQIEQrUreQ/yKxeFJ7cuB67v7/QIxxNNUul3obQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        poulls: {
                            50: '#f4f8f3',
                            100: '#e5efe2',
                            200: '#cce0c6',
                            300: '#9fc193',
                            400: '#73a466',
                            500: '#4e8740',
                            600: '#386c2c',
                            700: '#2e5d26',
                            800: '#23491f',
                            900: '#1c3c18',
                            950: '#0e200c'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full bg-[#eef3eb] text-slate-800 antialiased selection:bg-[#2e5d26] selection:text-white">

    <!-- Outer Frame Container -->
    <div class="w-full max-w-[1400px] mx-auto min-h-screen flex flex-col px-3 sm:px-6 lg:px-10 py-2 sm:py-3">

        <!-- Floating Capsule Navigation Bar -->
        <header class="sticky top-2 z-50 mb-6">
            <nav class="bg-white/95 backdrop-blur-md rounded-full px-5 sm:px-8 py-3 shadow-md border border-[#dbe6d6] flex items-center justify-between transition-all">
                
                <!-- Logo & Brand (MELA FAIR) -->
                <div class="flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2.5 group">
                        <div class="w-9 h-9 rounded-2xl bg-[#2e5d26] text-white flex items-center justify-center font-black text-lg shadow-sm group-hover:scale-105 transition-transform">
                            M
                        </div>
                        <div class="flex flex-col">
                            <div class="flex items-center gap-1.5 leading-none">
                                <span class="text-xl sm:text-2xl font-black tracking-tight text-[#1c3c18]">
                                    MELA
                                </span>
                                <span class="text-[10px] font-black uppercase tracking-wider text-[#2e5d26] bg-[#e5efe2] px-2 py-0.5 rounded-full">
                                    FAIR
                                </span>
                            </div>
                            <span class="text-[9px] text-[#557b4f] font-semibold uppercase tracking-wider mt-0.5">
                                Enterprise Event Core
                            </span>
                        </div>
                    </a>

                    <!-- Navigation Links -->
                    <div class="hidden md:flex items-center space-x-6 text-sm font-semibold text-[#40543e]">
                        <a asp-controller="Home" asp-action="Index" class="hover:text-[#2e5d26] transition">
                            Home
                        </a>
                        <a asp-controller="Fair" asp-action="Index" class="hover:text-[#2e5d26] transition">
                            Explore Fairs
                        </a>
                        <a asp-controller="Vendor" asp-action="Marketplace" class="hover:text-[#2e5d26] transition">
                            Vendor Stalls
                        </a>
                        <a asp-controller="Visitor" asp-action="BrowseFairs" class="hover:text-[#2e5d26] transition">
                            Passes
                        </a>
                        <a asp-controller="Employee" asp-action="JobListings" class="hover:text-[#2e5d26] transition">
                            Staff Jobs
                        </a>
                        <a asp-controller="Home" asp-action="Contact" class="hover:text-[#2e5d26] transition">
                            Contact
                        </a>

                        @if (User.IsInRole(RoleConstants.Admin))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e5efe2]">
                                <span class="w-2 h-2 rounded-full bg-[#2e5d26]"></span> Admin Panel
                            </a>
                        }
                        @if (User.IsInRole(RoleConstants.Vendor))
                        {
                            <a asp-controller="Vendor" asp-action="Dashboard" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e5efe2]">
                                <span class="w-2 h-2 rounded-full bg-[#2e5d26]"></span> My Stalls
                            </a>
                            <a asp-controller="Vendor" asp-action="Jobs" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e5efe2]">
                                <span class="w-2 h-2 rounded-full bg-[#2e5d26]"></span> Staff Hiring
                            </a>
                            <a asp-controller="Vendor" asp-action="Jobs" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-emerald-700 hover:bg-emerald-50 transition">
                                Staff Hiring
                            </a>
                        }
                        @if (User.IsInRole(RoleConstants.Visitor))
                        {
                            <a asp-controller="Visitor" asp-action="MyTickets" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e5efe2]">
                                <span class="w-2 h-2 rounded-full bg-[#2e5d26]"></span> My Passes
                            </a>
                        }
                        @if (User.IsInRole(RoleConstants.Employee))
                        {
                            <a asp-controller="Employee" asp-action="MyApplications" class="text-[#2e5d26] font-bold flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e5efe2]">
                                <span class="w-2 h-2 rounded-full bg-[#2e5d26]"></span> My Jobs
                            </a>
                        }
                    </div>
                </div>

                <!-- Right Side Actions & Auth -->
                <div class="flex items-center space-x-3">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="flex items-center space-x-2">
                            <span class="hidden lg:inline-block text-xs font-bold text-[#2e5d26] bg-[#e5efe2] px-3.5 py-1.5 rounded-full">
                                @(currentUser?.FullName ?? User.Identity?.Name) &bull; @(currentUser?.UserRole ?? "User")
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-4 py-2 text-xs font-semibold text-[#2e5d26] hover:bg-[#e5efe2] rounded-full transition flex items-center gap-1.5">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <!-- Get Started Pill Button -->
                        <div class="flex items-center space-x-2">
                            <a asp-controller="Account" asp-action="Login" class="hidden sm:inline-block px-4 py-2 text-xs font-bold text-[#2e5d26] hover:bg-[#e5efe2] rounded-full transition">
                                Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs sm:text-sm font-semibold shadow-sm transition hover:scale-105">
                                <i class="fa-solid fa-ticket text-xs opacity-90"></i>
                                <span>Get Passes</span>
                            </a>
                        </div>
                    }
                </div>
            </nav>
        </header>

        <!-- Main Content Area -->
        <main class="flex-grow w-full">
            @await Html.PartialAsync("_NotificationToast")
            @RenderBody()
        </main>

        <!-- Professional Enterprise Footer -->
        <footer class="bg-[#122410] text-[#c0dec0] rounded-[2.5rem] p-8 sm:p-12 lg:p-14 mt-16 shadow-2xl border border-[#23441f]">
            
            <!-- Top Contact & Trust Bar (4 Balanced Interactive Cards) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pb-10 border-b border-[#23441f]">
                
                <!-- Card 1: Support Hotline -->
                <a href="tel:+88029876543" class="bg-white/5 hover:bg-white/10 rounded-2xl p-4 border border-white/5 hover:border-emerald-500/30 transition-all group flex items-center gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500 group-hover:text-white flex items-center justify-center text-sm transition-colors shadow-sm">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase tracking-wider text-emerald-400 font-bold">Support Hotline</span>
                        <span class="text-xs sm:text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">+880 (02) 987-6543</span>
                    </div>
                </a>

                <!-- Card 2: Central Email -->
                <a asp-controller="Home" asp-action="Contact" class="bg-white/5 hover:bg-white/10 rounded-2xl p-4 border border-white/5 hover:border-emerald-500/30 transition-all group flex items-center gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500 group-hover:text-white flex items-center justify-center text-sm transition-colors shadow-sm">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase tracking-wider text-emerald-400 font-bold">Inquiries &amp; Stalls</span>
                        <span class="text-xs sm:text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">support@melafair.com</span>
                    </div>
                </a>

                <!-- Card 3: Operations HQ -->
                <a asp-controller="Home" asp-action="Contact" class="bg-white/5 hover:bg-white/10 rounded-2xl p-4 border border-white/5 hover:border-emerald-500/30 transition-all group flex items-center gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500 group-hover:text-white flex items-center justify-center text-sm transition-colors shadow-sm">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase tracking-wider text-emerald-400 font-bold">Operations HQ</span>
                        <span class="text-xs sm:text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">Suhrawardy Udyan, Dhaka</span>
                    </div>
                </a>

                <!-- Card 4: System Reliability Badge -->
                <div class="bg-white/5 rounded-2xl p-4 border border-white/5 flex items-center gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-sm shadow-sm">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase tracking-wider text-emerald-400 font-bold">Zero Oversell Safety</span>
                        <span class="text-xs sm:text-sm font-bold text-white">Row-Level Locking</span>
                    </div>
                </div>

            </div>

            <!-- Main Footer Links Grid (4 Professional Columns) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pt-10">
                
                <!-- Col 1: Brand & Architecture (lg:col-span-4) -->
                <div class="lg:col-span-4 space-y-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-600 to-emerald-400 text-white flex items-center justify-center font-black text-base shadow-md">
                            M
                        </div>
                        <div>
                            <span class="text-xl font-black text-white tracking-tight leading-none block">MELA FAIR</span>
                            <span class="text-[9px] text-emerald-400 font-bold uppercase tracking-widest">Enterprise Event Core</span>
                        </div>
                    </div>
                    <p class="text-xs text-[#a2c59f] leading-relaxed">
                        A high-concurrency Fair &amp; Event management system built with ASP.NET Core MVC (C#) and SQL Server. Delivering synchronized multi-day fair scheduling, race-condition-safe stall leasing, and digital admission ticketing across Bangladesh.
                    </p>
                    
                    <!-- System Live Status Indicator -->
                    <div class="flex items-center gap-2 pt-1 text-[11px] text-[#8cb748] font-medium">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        <span>Systems Operational &bull; Database Synchronized</span>
                    </div>

                    <!-- Social / Code Repositories -->
                    <div class="flex items-center space-x-2 pt-2">
                        <a href="https://github.com/Turjo101365/MELA" target="_blank" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-emerald-600 text-white flex items-center justify-center text-xs transition-colors" title="GitHub Repository">
                            <i class="fa-brands fa-github"></i>
                        </a>
                        <a asp-controller="Home" asp-action="Contact" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-emerald-600 text-white flex items-center justify-center text-xs transition-colors" title="Support Desk">
                            <i class="fa-solid fa-headset"></i>
                        </a>
                        <span class="text-[11px] text-[#71966c] pl-2 font-mono">v1.0-Release</span>
                    </div>
                </div>

                <!-- Col 2: Cultural Fairs Explorer (lg:col-span-3) -->
                <div class="lg:col-span-3">
                    <h3 class="text-xs font-black text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span>Cultural Fairs</span>
                    </h3>
                    <ul class="space-y-2.5 text-xs">
                        <li>
                            <a asp-controller="Fair" asp-action="Index" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-angle-right text-[10px] text-emerald-400"></i>
                                <span>Explore All Active Fairs</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Fair" asp-action="Index" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-angle-right text-[10px] text-emerald-400"></i>
                                <span>Dhaka Boishakhi Mela</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Fair" asp-action="Index" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-angle-right text-[10px] text-emerald-400"></i>
                                <span>Chattogram Folk Festival</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Fair" asp-action="Index" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-angle-right text-[10px] text-emerald-400"></i>
                                <span>Sylhet Tea &amp; Folk Expo</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Visitor" asp-action="BrowseFairs" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-angle-right text-[10px] text-emerald-400"></i>
                                <span>Festival Calendars &amp; Passes</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Col 3: Role Portals (lg:col-span-2) -->
                <div class="lg:col-span-2">
                    <h3 class="text-xs font-black text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span>Role Portals</span>
                    </h3>
                    <ul class="space-y-2.5 text-xs">
                        <li>
                            <a asp-controller="Admin" asp-action="Dashboard" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-shield-halved text-[10px] text-emerald-400"></i>
                                <span>Administrator</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Vendor" asp-action="Marketplace" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-store text-[10px] text-emerald-400"></i>
                                <span>Vendor Stalls</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Visitor" asp-action="BrowseFairs" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-ticket text-[10px] text-emerald-400"></i>
                                <span>Visitor Passes</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Employee" asp-action="JobListings" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-briefcase text-[10px] text-emerald-400"></i>
                                <span>Job Board</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Contact" class="text-[#a2c59f] hover:text-white transition flex items-center gap-1.5">
                                <i class="fa-solid fa-headset text-[10px] text-emerald-400"></i>
                                <span>Support Desk</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Col 4: Operating Hours & Quick Action (lg:col-span-3) -->
                <div class="lg:col-span-3 space-y-4">
                    <h3 class="text-xs font-black text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span>Operations Desk</span>
                    </h3>
                    
                    <div class="space-y-2.5 text-xs text-[#a2c59f]">
                        <div class="flex items-start gap-2.5">
                            <i class="fa-solid fa-clock text-emerald-400 text-xs mt-0.5"></i>
                            <div>
                                <span class="block text-white font-bold">Fair Ground Hours</span>
                                <span class="text-[11px]">Daily: 8:00 AM &ndash; 10:00 PM</span>
                            </div>
                        </div>
                        <div class="flex items-start gap-2.5">
                            <i class="fa-solid fa-building text-emerald-400 text-xs mt-0.5"></i>
                            <div>
                                <span class="block text-white font-bold">Stall Lease Secretariat</span>
                                <span class="text-[11px]">Mon &ndash; Sat: 9:00 AM &ndash; 6:00 PM</span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Support Action Pill -->
                    <div class="pt-2">
                        <a asp-controller="Home" asp-action="Contact" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-600/30 hover:bg-emerald-600 text-emerald-300 hover:text-white text-xs font-bold border border-emerald-500/30 transition-all">
                            <i class="fa-solid fa-paper-plane text-[10px]"></i>
                            <span>Get in Touch with Desk</span>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Bottom Copyright & Architecture Badges -->
            <div class="mt-12 pt-6 border-t border-[#23441f] flex flex-col lg:flex-row items-center justify-between gap-4 text-xs text-[#789d74]">
                <div class="flex items-center gap-2 text-center sm:text-left">
                    <p>&copy; @DateTime.UtcNow.Year MelaFair Enterprise Event Core. All rights reserved.</p>
                </div>

                <!-- Technical Badges -->
                <div class="flex flex-wrap items-center justify-center gap-2 text-[10px] font-mono text-emerald-300/80">
                    <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/5">ASP.NET Core 8 MVC</span>
                    <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/5">SQL Server 2022</span>
                    <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/5">Row-Level UPDLOCK</span>
                    <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/5">Dapper &bull; EF Core</span>
                </div>

                <div class="flex items-center space-x-4 text-xs">
                    <a asp-controller="Home" asp-action="Contact" class="hover:text-white transition">Privacy Policy</a>
                    <span>&bull;</span>
                    <a asp-controller="Home" asp-action="Contact" class="hover:text-white transition">Fair Regulations</a>
                    <span>&bull;</span>
                    <a asp-controller="Home" asp-action="Contact" class="hover:text-white transition">Help Center</a>
                </div>
            </div>
        </footer>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>