@using Microsoft.AspNetCore.Identity
@using MelaFair.Core.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mela Fair Management System</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVJkEZSMUkrQ6usKGiOL6NwAn2NAIj50tnMYrQIEQrUreQ/yKxeFJ7cuB67v7/QIxxNNUul3obQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        mela: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            200: '#fed7aa',
                            300: '#fdba74',
                            400: '#fb923c',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                            800: '#9a3412',
                            900: '#7c2d12',
                        },
                        brand: {
                            primary: '#ea580c',
                            secondary: '#0f172a',
                            accent: '#059669',
                            dark: '#020617'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased selection:bg-orange-500 selection:text-white">

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo & Brand -->
                <div class="flex items-center">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-600 via-amber-500 to-rose-500 flex items-center justify-center text-white shadow-md shadow-orange-500/20 group-hover:scale-105 transition-transform">
                            <span class="text-xl font-black tracking-tight">M</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-lg font-black tracking-tight text-slate-900 flex items-center gap-1.5">
                                MELA <span class="text-xs font-bold text-orange-600 uppercase tracking-widest px-1.5 py-0.5 bg-orange-100 rounded">FAIR</span>
                            </span>
                            <span class="text-[10px] text-slate-500 font-medium tracking-wide uppercase">Enterprise Event Core</span>
                        </div>
                    </a>

                    <!-- Navigation Links by Role -->
                    <div class="hidden md:ml-10 md:flex md:space-x-1">
                        <a asp-controller="Home" asp-action="Index" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-orange-600 hover:bg-orange-50 transition">
                            Explore Fairs
                        </a>

                        @if (User.IsInRole(RoleConstants.Admin))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="px-3 py-2 rounded-lg text-sm font-semibold text-slate-900 hover:text-orange-600 hover:bg-orange-50 transition flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-orange-500"></span> Dashboard
                            </a>
                            <a asp-controller="Admin" asp-action="CreateFair" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-orange-600 hover:bg-orange-50 transition">
                                + Create Fair
                            </a>
                            <a asp-controller="Admin" asp-action="ManageFairs" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-orange-600 hover:bg-orange-50 transition">
                                Manage Events
                            </a>
                            <a asp-controller="Admin" asp-action="Analytics" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-orange-600 hover:bg-orange-50 transition">
                                SQL Analytics
                            </a>
                        }

                        @if (User.IsInRole(RoleConstants.Vendor))
                        {
                            <a asp-controller="Vendor" asp-action="Marketplace" class="px-3 py-2 rounded-lg text-sm font-semibold text-emerald-800 hover:bg-emerald-50 transition flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Stall Marketplace
                            </a>
                            <a asp-controller="Vendor" asp-action="MyStalls" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-emerald-700 hover:bg-emerald-50 transition">
                                My Leased Stalls
                            </a>
                        }

                        @if (User.IsInRole(RoleConstants.Visitor))
                        {
                            <a asp-controller="Visitor" asp-action="BrowseFairs" class="px-3 py-2 rounded-lg text-sm font-semibold text-blue-800 hover:bg-blue-50 transition flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-blue-500"></span> Buy Tickets
                            </a>
                            <a asp-controller="Visitor" asp-action="MyTickets" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-blue-700 hover:bg-blue-50 transition">
                                My Digital Passes
                            </a>
                        }

                        @if (User.IsInRole(RoleConstants.Employee))
                        {
                            <a asp-controller="Employee" asp-action="JobListings" class="px-3 py-2 rounded-lg text-sm font-semibold text-purple-800 hover:bg-purple-50 transition flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-purple-500"></span> Job Board
                            </a>
                            <a asp-controller="Employee" asp-action="MyApplications" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-purple-700 hover:bg-purple-50 transition">
                                My Applications
                            </a>
                        }

                        @if (!User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Employee" asp-action="JobListings" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-orange-600 hover:bg-orange-50 transition">
                                Fair Jobs
                            </a>
                        }
                    </div>
                </div>

                <!-- Right Side User & Auth Section -->
                <div class="flex items-center space-x-3">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <div class="flex items-center space-x-3">
                            <div class="hidden sm:flex flex-col text-right">
                                <span class="text-sm font-bold text-slate-900 leading-tight">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full inline-block mt-0.5 @(User.IsInRole(RoleConstants.Admin) ? "bg-orange-100 text-orange-700" : User.IsInRole(RoleConstants.Vendor) ? "bg-emerald-100 text-emerald-700" : User.IsInRole(RoleConstants.Visitor) ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                                    @(currentUser?.UserRole ?? "User")
                                </span>
                            </div>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition flex items-center space-x-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    <span class="hidden sm:inline">Logout</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center space-x-2">
                            <a asp-controller="Account" asp-action="Login" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:text-orange-600 hover:bg-orange-50 rounded-lg transition">
                                Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="px-4 py-2 text-sm font-semibold text-white bg-orange-600 hover:bg-orange-700 shadow-md shadow-orange-600/20 rounded-lg transition">
                                Register
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @await Html.PartialAsync("_NotificationToast")
        @RenderBody()
    </main>

    <!-- Clean Modern Footer -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div class="md:col-span-1">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-8 h-8 rounded-lg bg-orange-600 flex items-center justify-center text-white font-black text-sm">
                            M
                        </div>
                        <span class="text-white font-bold text-lg">MELA System</span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Enterprise Cultural Fair Management Platform powered by ASP.NET Core MVC &amp; SQL Server Row-Level Stored Procedures.
                    </p>
                </div>

                <div>
                    <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">Administrative</h3>
                    <ul class="space-y-2 text-xs">
                        <li><a asp-controller="Admin" asp-action="Dashboard" class="hover:text-orange-400 transition">Executive Dashboard</a></li>
                        <li><a asp-controller="Admin" asp-action="CreateFair" class="hover:text-orange-400 transition">Create New Fair</a></li>
                        <li><a asp-controller="Admin" asp-action="ManageFairs" class="hover:text-orange-400 transition">Event Registry</a></li>
                        <li><a asp-controller="Admin" asp-action="Analytics" class="hover:text-orange-400 transition">SQL View Reporting</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">Portals</h3>
                    <ul class="space-y-2 text-xs">
                        <li><a asp-controller="Vendor" asp-action="Marketplace" class="hover:text-orange-400 transition">Vendor Stall Booking</a></li>
                        <li><a asp-controller="Visitor" asp-action="BrowseFairs" class="hover:text-orange-400 transition">Visitor Admission Passes</a></li>
                        <li><a asp-controller="Employee" asp-action="JobListings" class="hover:text-orange-400 transition">Staff Recruitment Board</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">Concurrency Architecture</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Zero oversell transactions executed via SQL Server <code class="text-orange-400 font-mono">UPDLOCK, ROWLOCK</code> stored procedures and reactive validation triggers.
                    </p>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
                <p>&copy; @DateTime.UtcNow.Year Mela Fair Management System. All rights reserved.</p>
                <p class="mt-2 sm:mt-0 font-mono">ASP.NET Core MVC &bull; Dapper &bull; EF Core &bull; SQL Server</p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
