@model IEnumerable<MelaFair.Web.Models.Entities.Fair>
@{
    ViewData["Title"] = "Explore Cultural Fairs & Pavilions";
    var defaultImages = new[]
    {
        "https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=800&q=80"
    };
    int imgIndex = 0;
}

<div class="space-y-8">
    <!-- Header Banner -->
    <div class="rounded-[2rem] p-8 sm:p-12 text-white shadow-xl relative overflow-hidden"
         style="background: linear-gradient(135deg, #1c3c18 0%, #2e5d26 50%, #437338 100%);">
        <div class="max-w-2xl relative z-10 space-y-3">
            <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-xs font-bold uppercase tracking-wider text-[#cce0c6]">
                <i class="fa-solid fa-landmark mr-1"></i> Active Cultural Events &amp; Pavilions
            </span>
            <h1 class="text-3xl sm:text-4xl font-black tracking-tight">Explore Cultural Fairs</h1>
            <p class="text-[#cce0c6] text-sm leading-relaxed">
                Discover active cultural events across Bangladesh, experience seamless digital ticketing, and explore available vendor stalls powered by robust SQL concurrency architecture.
            </p>
        </div>
    </div>

    <!-- Fairs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model != null && Model.Any())
        {
            @foreach (var fair in Model)
            {
                var cardImage = !string.IsNullOrWhiteSpace(fair.BannerImageUrl) && fair.BannerImageUrl.Contains("http") 
                    ? fair.BannerImageUrl 
                    : defaultImages[(imgIndex++) % defaultImages.Length];

                <div class="bg-white rounded-[2rem] border border-[#dce8d8] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div>
                        <div class="h-48 w-full overflow-hidden relative">
                            <img src="@cardImage" alt="@fair.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            <div class="absolute top-3 right-3 bg-[#1c3c18]/80 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full shadow">
                                @fair.StartDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        <div class="p-6 space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold px-3 py-1 bg-[#e5efe2] text-[#2e5d26] rounded-full">Active Event</span>
                                <span class="text-xs font-bold text-[#437338]">&#2547;@fair.BaseTicketPrice.ToString("F0") / pass</span>
                            </div>

                            <h3 class="text-lg font-bold text-[#1c3c18] group-hover:text-[#2e5d26] transition">@fair.Title</h3>
                            <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed">@fair.Description</p>
                            
                            <div class="flex items-center text-xs text-slate-500 gap-2 pt-1 font-medium">
                                <i class="fa-solid fa-location-dot text-[#2e5d26]"></i>
                                <span>@fair.Location</span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-semibold text-center border-t border-[#eef3eb]">
                                <div class="bg-[#f4f8f3] rounded-xl p-2">
                                    <span class="block text-[#2e5d26] font-bold">@fair.AvailableStalls / @fair.TotalStalls</span>
                                    <span class="text-[10px] text-slate-500">Stalls Open</span>
                                </div>
                                <div class="bg-[#f4f8f3] rounded-xl p-2">
                                    <span class="block text-[#2e5d26] font-bold">@fair.DailyCapacity.ToString("N0")</span>
                                    <span class="text-[10px] text-slate-500">Daily Capacity</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 pt-0">
                        <a asp-controller="Fair" asp-action="Details" asp-route-id="@fair.FairId" 
                           class="w-full py-2.5 px-4 bg-[#2e5d26] hover:bg-[#23491f] text-white text-xs font-bold rounded-full transition text-center block shadow-sm">
                            View Details &amp; Stalls &rarr;
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-12 bg-white rounded-[2rem] border border-[#dce8d8] shadow-sm">
                <div class="w-16 h-16 bg-[#e5efe2] text-[#2e5d26] rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900 mb-1">No Active Fairs Found</h3>
                <p class="text-xs text-slate-500">Please check back later or add a new fair from the admin dashboard.</p>
            </div>
        }
    </div>
</div>