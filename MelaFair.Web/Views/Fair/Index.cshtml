
@model IEnumerable<MelaFair.Web.Models.Entities.Fair>
@{
    ViewData["Title"] = "Explore Fairs";
}

<div class="space-y-8">
    <!-- Header Section -->
    <div class="bg-gradient-to-r from-orange-600 to-rose-600 rounded-3xl p-8 text-white shadow-xl">
        <h1 class="text-3xl font-black tracking-tight mb-2">Explore Cultural Fairs</h1>
        <p class="text-orange-100 text-sm max-w-2xl">
            Discover active cultural events, experience seamless digital ticketing, and explore available vendor stalls powered by robust SQL concurrency architecture.
        </p>
    </div>

    <!-- Fairs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model != null && Model.Any())
        {
            @foreach (var fair in Model)
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col overflow-hidden">
                    <div class="p-6 flex-grow">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold px-2.5 py-1 bg-orange-100 text-orange-700 rounded-full">Active Event</span>
                            <span class="text-xs text-slate-500 font-medium">@fair.StartDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">@fair.Title</h3>
                        <p class="text-slate-600 text-sm line-clamp-2 mb-4">@fair.Description</p>
                        <div class="flex items-center text-xs text-slate-500 gap-2 mb-1">
                            <i class="fa-solid fa-location-dot text-orange-600"></i>
                            <span>@fair.Location</span>
                        </div>
                    </div>
                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-xs font-semibold text-slate-700">Fair ID: @fair.FairId</span>
                        <a asp-controller="Fair" asp-action="Details" asp-route-id="@fair.FairId" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold rounded-xl transition shadow-sm">
    View Details
</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-12 bg-white rounded-2xl border border-slate-200">
                <div class="w-16 h-16 bg-orange-50 text-orange-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900 mb-1">No Active Fairs Found</h3>
                <p class="text-xs text-slate-500">Please check back later or add a new fair from the admin dashboard.</p>
            </div>
        }
    </div>
</div>