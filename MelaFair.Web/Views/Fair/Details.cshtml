@model MelaFair.Web.Models.Entities.Fair

@{
    ViewData["Title"] = Model.Title;
}

<div class="max-w-4xl mx-auto space-y-6 my-6">
    <div class="bg-white rounded-[2.5rem] border border-[#dce8d8] shadow-sm p-8 sm:p-10 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="text-xs font-bold px-3 py-1 bg-[#e5efe2] text-[#2e5d26] rounded-full">
                <i class="fa-solid fa-calendar-check mr-1"></i> Official Event #@Model.FairId
            </span>
            <span class="text-xs font-semibold text-slate-500">
                <i class="fa-regular fa-calendar mr-1"></i> @Model.StartDate.ToString("MMM dd, yyyy") &ndash; @Model.EndDate.ToString("MMM dd, yyyy")
            </span>
        </div>

        <div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#142a12] tracking-tight">@Model.Title</h1>
            <p class="text-slate-600 text-sm leading-relaxed mt-3">@Model.Description</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-[#eef3eb]">
            <div class="flex items-center gap-3 p-3 bg-[#f6f9f4] rounded-2xl border border-[#e2ece0]">
                <div class="w-10 h-10 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Location</span>
                    <span class="text-xs font-bold text-slate-900">@Model.Location</span>
                </div>
            </div>
            
            <div class="flex items-center gap-3 p-3 bg-[#f6f9f4] rounded-2xl border border-[#e2ece0]">
                <div class="w-10 h-10 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold">
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Pass Price</span>
                    <span class="text-xs font-bold text-slate-900">&#2547;@Model.BaseTicketPrice.ToString("N0") / person</span>
                </div>
            </div>

            <div class="flex items-center gap-3 p-3 bg-[#f6f9f4] rounded-2xl border border-[#e2ece0]">
                <div class="w-10 h-10 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold">
                    <i class="fa-solid fa-store"></i>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Vendor Stalls</span>
                    <span class="text-xs font-bold text-slate-900">@Model.AvailableStalls Open / @Model.TotalStalls</span>
                </div>
            </div>
        </div>

        <div class="pt-6 border-t border-[#eef3eb] flex flex-wrap items-center justify-between gap-4">
            <a asp-action="Index" class="px-5 py-2.5 bg-[#f6f9f4] hover:bg-[#eef4ed] text-slate-700 font-bold text-xs rounded-full border border-[#dce8d8] transition">
                &larr; Back to Fairs
            </a>
            
            <div class="flex flex-wrap items-center gap-3">
                <a asp-controller="Visitor" asp-action="TicketBooking" asp-route-fairId="@Model.FairId" 
                   class="px-6 py-2.5 bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-xs rounded-full transition shadow-sm flex items-center gap-2 hover:scale-105">
                    <i class="fa-solid fa-ticket text-amber-300"></i>
                    <span>Get Admission Passes</span>
                </a>
                <a asp-controller="Vendor" asp-action="Marketplace" 
                   class="px-5 py-2.5 bg-white hover:bg-slate-50 text-[#2e5d26] border border-[#2e5d26]/40 font-bold text-xs rounded-full transition">
                    <i class="fa-solid fa-store mr-1"></i>
                    <span>Explore Stalls</span>
                </a>
            </div>
        </div>
    </div>
</div>