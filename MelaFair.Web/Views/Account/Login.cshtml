@model MelaFair.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Portal Sign In";
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    var initialRole = Model?.TargetRole ?? RoleConstants.Visitor;
}

<div class="max-w-xl mx-auto my-6 space-y-6">
    <!-- Header -->
    <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-bold uppercase tracking-wider">
            🏮 MELA Multi-Role Authentication
        </div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Sign In to Your Account</h1>
        <p class="text-xs text-slate-500">Choose your portal type and enter your login credentials</p>
    </div>

    <!-- 4 Role Selection Tabs -->
    <div class="bg-white rounded-2xl border border-slate-200 p-1.5 shadow-sm grid grid-cols-2 sm:grid-cols-4 gap-1.5" id="roleTabs">
        <!-- Tab 1: Admin -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Admin', 'System Administrator', '👑', 'orange', 'admin@mela.com')"
                id="tab-@RoleConstants.Admin"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Admin ? "border-orange-500 bg-orange-50/70 text-orange-950 font-bold" : "border-transparent text-slate-600 hover:bg-slate-50")">
            <span class="text-xl mb-1">👑</span>
            <span class="text-xs font-bold leading-tight">Admin</span>
            <span class="text-[10px] text-slate-400 font-normal">Management</span>
        </button>

        <!-- Tab 2: Vendor -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Vendor', 'Fair Vendor', '🎪', 'emerald', 'vendor@mela.com')"
                id="tab-@RoleConstants.Vendor"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Vendor ? "border-emerald-500 bg-emerald-50/70 text-emerald-950 font-bold" : "border-transparent text-slate-600 hover:bg-slate-50")">
            <span class="text-xl mb-1">🎪</span>
            <span class="text-xs font-bold leading-tight">Vendor</span>
            <span class="text-[10px] text-slate-400 font-normal">Stall Owner</span>
        </button>

        <!-- Tab 3: Visitor -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Visitor', 'Fair Visitor', '🎟️', 'blue', 'visitor@mela.com')"
                id="tab-@RoleConstants.Visitor"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Visitor ? "border-blue-500 bg-blue-50/70 text-blue-950 font-bold" : "border-transparent text-slate-600 hover:bg-slate-50")">
            <span class="text-xl mb-1">🎟️</span>
            <span class="text-xs font-bold leading-tight">Visitor</span>
            <span class="text-[10px] text-slate-400 font-normal">Ticket Buyer</span>
        </button>

        <!-- Tab 4: Employee -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Employee', 'Staff & Employee', '💼', 'purple', 'employee@mela.com')"
                id="tab-@RoleConstants.Employee"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Employee ? "border-purple-500 bg-purple-50/70 text-purple-950 font-bold" : "border-transparent text-slate-600 hover:bg-slate-50")">
            <span class="text-xl mb-1">💼</span>
            <span class="text-xs font-bold leading-tight">Employee</span>
            <span class="text-[10px] text-slate-400 font-normal">Fair Staff</span>
        </button>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">
        
        <!-- Active Role Portal Banner -->
        <div id="roleBanner" class="p-4 rounded-2xl border flex items-center justify-between transition-all duration-300 @(initialRole == RoleConstants.Admin ? "bg-orange-50 border-orange-200" : initialRole == RoleConstants.Vendor ? "bg-emerald-50 border-emerald-200" : initialRole == RoleConstants.Employee ? "bg-purple-50 border-purple-200" : "bg-blue-50 border-blue-200")">
            <div class="flex items-center gap-3">
                <div id="roleIcon" class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-xl shadow-sm border border-slate-100">
                    @(initialRole == RoleConstants.Admin ? "👑" : initialRole == RoleConstants.Vendor ? "🎪" : initialRole == RoleConstants.Employee ? "💼" : "🎟️")
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold tracking-wider text-slate-500">Selected Portal</div>
                    <div id="roleTitle" class="text-sm font-black text-slate-900">
                        @(initialRole == RoleConstants.Admin ? "System Administrator" : initialRole == RoleConstants.Vendor ? "Fair Vendor" : initialRole == RoleConstants.Employee ? "Staff & Employee" : "Fair Visitor")
                    </div>
                </div>
            </div>
            <span class="text-[11px] font-semibold text-slate-500 px-2.5 py-1 rounded-lg bg-white border border-slate-200">
                Credentials Required
            </span>
        </div>

        <!-- Login Form -->
        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TargetRole" id="targetRoleInput" value="@initialRole" />

            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 p-3.5 rounded-xl"></div>

            <!-- Email Field -->
            <div>
                <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
                <div class="relative">
                    <input asp-for="Email" 
                           id="loginEmail"
                           type="email"
                           class="w-full pl-3.5 pr-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent text-sm transition placeholder-slate-400" 
                           placeholder="Enter your email" 
                           required 
                           autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Password Field -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label asp-for="Password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Password</label>
                </div>
                <div class="relative">
                    <input asp-for="Password" 
                           id="loginPassword"
                           type="password" 
                           class="w-full pl-3.5 pr-10 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent text-sm transition placeholder-slate-400" 
                           placeholder="Enter your password" 
                           required 
                           autocomplete="current-password" />
                    <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 text-xs">
                        <span id="eyeText">Show</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center justify-between text-xs pt-1">
                <label class="flex items-center space-x-2 text-slate-600 cursor-pointer select-none">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-slate-300 text-orange-600 focus:ring-orange-500 w-4 h-4" />
                    <span class="font-medium">Remember me on this browser</span>
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="submitBtn" class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-md shadow-orange-600/20 transition flex items-center justify-center gap-2">
                <span>Sign In &rarr;</span>
            </button>
        </form>

        <!-- Footer / Links -->
        <div class="text-center pt-4 border-t border-slate-100 text-xs text-slate-500 space-y-2">
            <div>
                Need a new account? 
                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl" class="font-bold text-orange-600 hover:text-orange-700">
                    Register here
                </a>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="text-slate-400 hover:text-slate-600 font-medium">
                    &larr; Back to Public Festival Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const rolesConfig = {
            '@RoleConstants.Admin': {
                title: 'System Administrator',
                icon: '👑',
                tabClass: 'border-orange-500 bg-orange-50/70 text-orange-950 font-bold',
                bannerClass: 'bg-orange-50 border-orange-200',
                btnClass: 'bg-orange-600 hover:bg-orange-700 shadow-orange-600/20',
                placeholder: 'admin@mela.com'
            },
            '@RoleConstants.Vendor': {
                title: 'Fair Vendor',
                icon: '🎪',
                tabClass: 'border-emerald-500 bg-emerald-50/70 text-emerald-950 font-bold',
                bannerClass: 'bg-emerald-50 border-emerald-200',
                btnClass: 'bg-emerald-600 hover:bg-emerald-700 shadow-emerald-600/20',
                placeholder: 'vendor@mela.com'
            },
            '@RoleConstants.Visitor': {
                title: 'Fair Visitor',
                icon: '🎟️',
                tabClass: 'border-blue-500 bg-blue-50/70 text-blue-950 font-bold',
                bannerClass: 'bg-blue-50 border-blue-200',
                btnClass: 'bg-blue-600 hover:bg-blue-700 shadow-blue-600/20',
                placeholder: 'visitor@mela.com'
            },
            '@RoleConstants.Employee': {
                title: 'Staff & Employee',
                icon: '💼',
                tabClass: 'border-purple-500 bg-purple-50/70 text-purple-950 font-bold',
                bannerClass: 'bg-purple-50 border-purple-200',
                btnClass: 'bg-purple-600 hover:bg-purple-700 shadow-purple-600/20',
                placeholder: 'employee@mela.com'
            }
        };

        function selectRole(role, title, icon, color, placeholder) {
            document.getElementById('targetRoleInput').value = role;
            document.getElementById('roleTitle').innerText = title;
            document.getElementById('roleIcon').innerText = icon;
            document.getElementById('loginEmail').placeholder = placeholder;

            // Update Tabs styling
            document.querySelectorAll('.role-tab').forEach(tab => {
                tab.className = 'role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center border-transparent text-slate-600 hover:bg-slate-50';
            });
            const activeTab = document.getElementById('tab-' + role);
            if (activeTab && rolesConfig[role]) {
                activeTab.className = 'role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center ' + rolesConfig[role].tabClass;
            }

            // Update Banner & Button styling
            const banner = document.getElementById('roleBanner');
            const submitBtn = document.getElementById('submitBtn');
            if (banner && submitBtn && rolesConfig[role]) {
                banner.className = 'p-4 rounded-2xl border flex items-center justify-between transition-all duration-300 ' + rolesConfig[role].bannerClass;
                submitBtn.className = 'w-full py-3 px-4 rounded-xl text-white font-bold text-sm shadow-md transition flex items-center justify-center gap-2 ' + rolesConfig[role].btnClass;
            }
        }

        function togglePasswordVisibility() {
            const pass = document.getElementById('loginPassword');
            const eyeText = document.getElementById('eyeText');
            if (pass.type === 'password') {
                pass.type = 'text';
                eyeText.innerText = 'Hide';
            } else {
                pass.type = 'password';
                eyeText.innerText = 'Show';
            }
        }
    </script>
}
