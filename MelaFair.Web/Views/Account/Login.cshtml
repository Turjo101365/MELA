@model MelaFair.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Account Sign In";
}

<div class="max-w-md mx-auto my-6">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">
        <div class="text-center space-y-2">
            <div class="w-12 h-12 rounded-2xl bg-orange-600 text-white mx-auto flex items-center justify-center font-black text-xl shadow-md shadow-orange-500/20">
                M
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Sign In to MELA</h1>
            <p class="text-xs text-slate-500">Access your role portal or test using demo credentials</p>
        </div>

        <!-- Quick Demo Switcher Cards -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3.5 space-y-2">
            <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">One-Click Demo Instant Access:</span>
            <div class="grid grid-cols-2 gap-2">
                <form asp-controller="Account" asp-action="QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="Admin" />
                    <button type="submit" class="w-full py-1.5 px-2 bg-orange-100 hover:bg-orange-200 text-orange-800 text-xs font-bold rounded-lg transition text-left flex items-center gap-1.5">
                        <span>🔑</span> <span>Admin</span>
                    </button>
                </form>
                <form asp-controller="Account" asp-action="QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="Vendor" />
                    <button type="submit" class="w-full py-1.5 px-2 bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-xs font-bold rounded-lg transition text-left flex items-center gap-1.5">
                        <span>🎪</span> <span>Vendor</span>
                    </button>
                </form>
                <form asp-controller="Account" asp-action="QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="Visitor" />
                    <button type="submit" class="w-full py-1.5 px-2 bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-bold rounded-lg transition text-left flex items-center gap-1.5">
                        <span>🎟️</span> <span>Visitor</span>
                    </button>
                </form>
                <form asp-controller="Account" asp-action="QuickLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="Employee" />
                    <button type="submit" class="w-full py-1.5 px-2 bg-purple-100 hover:bg-purple-200 text-purple-800 text-xs font-bold rounded-lg transition text-left flex items-center gap-1.5">
                        <span>💼</span> <span>Employee</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Standard Credentials Form -->
        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 p-3 rounded-lg"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"></label>
                <input asp-for="Email" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent text-sm" placeholder="e.g. admin@mela.com" />
                <span asp-validation-for="Email" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label asp-for="Password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider"></label>
                    <span class="text-[11px] text-slate-400">Demo pwd: Admin@123456</span>
                </div>
                <input asp-for="Password" type="password" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent text-sm" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-xs text-rose-500"></span>
            </div>

            <div class="flex items-center justify-between text-xs">
                <label class="flex items-center space-x-2 text-slate-600 cursor-pointer">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-slate-300 text-orange-600 focus:ring-orange-500" />
                    <span>Keep me signed in</span>
                </label>
            </div>

            <button type="submit" class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-md shadow-orange-600/20 transition">
                Sign In
            </button>
        </form>

        <div class="text-center pt-2 border-t border-slate-100 text-xs text-slate-500">
            Don't have an account? 
            <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="font-bold text-orange-600 hover:text-orange-700">
                Register here
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
