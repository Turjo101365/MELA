@model MelaFair.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Portal Sign In";
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    var initialRole = Model?.TargetRole ?? RoleConstants.Visitor;
}

<div class="max-w-xl mx-auto my-8 space-y-6">
    <!-- Header -->
    <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#e5efe2] text-[#2e5d26] border border-[#cce0c6] text-xs font-bold uppercase tracking-wider shadow-sm">
            <i class="fa-solid fa-leaf text-[#4e8740]"></i>
            <span>MELA Multi-Role Portal</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[#1c3c18] tracking-tight">Sign In to Your Account</h1>
        <p class="text-xs sm:text-sm text-[#557b4f]">Choose your portal type and enter your verified credentials</p>
    </div>

    <!-- 4 Role Selection Tabs -->
    <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-[#dce8d8] p-1.5 shadow-sm grid grid-cols-2 sm:grid-cols-4 gap-1.5" id="roleTabs">
        <!-- Tab 1: Admin -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Admin', 'System Administrator', '👑', 'tanmoy.cse.20230104124@aust.edu')"
                id="tab-@RoleConstants.Admin"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Admin ? "border-[#1c3c18] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm" : "border-transparent text-slate-600 hover:text-[#1c3c18] hover:bg-[#f4f8f3]")">
            <span class="text-xl mb-1">👑</span>
            <span class="text-xs font-bold leading-tight">Admin</span>
            <span class="text-[10px] text-[#557b4f] font-normal">Management</span>
        </button>

        <!-- Tab 2: Vendor -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Vendor', 'Fair Vendor', '🎪', 'vendor@mela.com')"
                id="tab-@RoleConstants.Vendor"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Vendor ? "border-[#2e5d26] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm" : "border-transparent text-slate-600 hover:text-[#1c3c18] hover:bg-[#f4f8f3]")">
            <span class="text-xl mb-1">🎪</span>
            <span class="text-xs font-bold leading-tight">Vendor</span>
            <span class="text-[10px] text-[#557b4f] font-normal">Stall Owner</span>
        </button>

        <!-- Tab 3: Visitor -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Visitor', 'Fair Visitor', '🎟️', 'visitor@mela.com')"
                id="tab-@RoleConstants.Visitor"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Visitor ? "border-[#4e8740] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm" : "border-transparent text-slate-600 hover:text-[#1c3c18] hover:bg-[#f4f8f3]")">
            <span class="text-xl mb-1">🎟️</span>
            <span class="text-xs font-bold leading-tight">Visitor</span>
            <span class="text-[10px] text-[#557b4f] font-normal">Ticket Buyer</span>
        </button>

        <!-- Tab 4: Employee -->
        <button type="button" 
                onclick="selectRole('@RoleConstants.Employee', 'Staff & Employee', '💼', 'employee@mela.com')"
                id="tab-@RoleConstants.Employee"
                class="role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center @(initialRole == RoleConstants.Employee ? "border-[#386c2c] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm" : "border-transparent text-slate-600 hover:text-[#1c3c18] hover:bg-[#f4f8f3]")">
            <span class="text-xl mb-1">💼</span>
            <span class="text-xs font-bold leading-tight">Employee</span>
            <span class="text-[10px] text-[#557b4f] font-normal">Fair Staff</span>
        </button>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-lg p-6 sm:p-8 space-y-6 relative overflow-hidden">
        <!-- Top subtle eco decorative bar -->
        <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#1c3c18] via-[#2e5d26] to-[#4e8740]"></div>
        
        <!-- Active Role Portal Banner -->
        <div id="roleBanner" class="p-4 rounded-2xl border border-[#cce0c6] bg-gradient-to-r from-[#f4f8f3] to-[#e5efe2] flex items-center justify-between transition-all duration-300 shadow-xs">
            <div class="flex items-center gap-3">
                <div id="roleIcon" class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-xl shadow-xs border border-[#cce0c6]">
                    @(initialRole == RoleConstants.Admin ? "👑" : initialRole == RoleConstants.Vendor ? "🎪" : initialRole == RoleConstants.Employee ? "💼" : "🎟️")
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold tracking-wider text-[#557b4f]">Selected Portal</div>
                    <div id="roleTitle" class="text-sm font-black text-[#1c3c18]">
                        @(initialRole == RoleConstants.Admin ? "System Administrator" : initialRole == RoleConstants.Vendor ? "Fair Vendor" : initialRole == RoleConstants.Employee ? "Staff & Employee" : "Fair Visitor")
                    </div>
                </div>
            </div>
            <span class="text-[11px] font-bold text-[#2e5d26] px-3 py-1 rounded-full bg-white border border-[#cce0c6] shadow-xs">
                Credentials Required
            </span>
        </div>

        <!-- Login Form -->
        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TargetRole" id="targetRoleInput" value="@initialRole" />

            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 p-3.5 rounded-xl"></div>

            <!-- Email Field -->
            <div>
                <label asp-for="Email" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1.5">
                    Email Address
                </label>
                <div class="relative">
                    <input asp-for="Email" 
                           id="loginEmail"
                           type="email"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" 
                           placeholder="Enter your email" 
                           required 
                           autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Password Field -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label asp-for="Password" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider">
                        Password
                    </label>
                </div>
                <div class="relative">
                    <input asp-for="Password" 
                           id="loginPassword"
                           type="password" 
                           class="w-full pl-3.5 pr-12 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" 
                           placeholder="Enter your password" 
                           required 
                           autocomplete="current-password" />
                    <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-xs font-bold text-[#557b4f] hover:text-[#1c3c18]">
                        <span id="eyeText">Show</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center justify-between text-xs pt-1">
                <label class="flex items-center space-x-2 text-[#40543e] cursor-pointer select-none">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-[#cce0c6] text-[#2e5d26] focus:ring-[#2e5d26] w-4 h-4" />
                    <span class="font-medium">Remember me on this browser</span>
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="submitBtn" class="w-full py-3.5 px-4 rounded-xl bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-sm shadow-md shadow-[#2e5d26]/20 transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2">
                <span>Sign In to Portal</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <!-- Quick Demo Credentials Fill -->
        <div class="bg-[#f6f9f3] border border-[#dce8d8] rounded-2xl p-3.5 space-y-2.5">
            <div class="flex items-center justify-between text-[11px] font-bold text-[#2e5d26]">
                <span class="flex items-center gap-1.5">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-500"></i>
                    <span>Quick Demo Login Auto-Fill</span>
                </span>
                <span class="text-[10px] text-[#557b4f] font-normal">Click a role to fill test credentials</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <button type="button" onclick="fillCredentials('@RoleConstants.Admin', 'tanmoy.cse.20230104124@aust.edu', 'Turjo124')" 
                        class="px-2 py-1.5 rounded-lg bg-white border border-[#cce0c6] hover:bg-[#e5efe2] text-[#1c3c18] text-[10px] font-bold transition flex items-center justify-center gap-1">
                    <span>👑</span> Admin
                </button>
                <button type="button" onclick="fillCredentials('@RoleConstants.Vendor', 'vendor@mela.com', 'Vendor@123456')" 
                        class="px-2 py-1.5 rounded-lg bg-white border border-[#cce0c6] hover:bg-[#e5efe2] text-[#1c3c18] text-[10px] font-bold transition flex items-center justify-center gap-1">
                    <span>🎪</span> Vendor
                </button>
                <button type="button" onclick="fillCredentials('@RoleConstants.Visitor', 'visitor@mela.com', 'Visitor@123456')" 
                        class="px-2 py-1.5 rounded-lg bg-white border border-[#cce0c6] hover:bg-[#e5efe2] text-[#1c3c18] text-[10px] font-bold transition flex items-center justify-center gap-1">
                    <span>🎟️</span> Visitor
                </button>
                <button type="button" onclick="fillCredentials('@RoleConstants.Employee', 'employee@mela.com', 'Employee@123456')" 
                        class="px-2 py-1.5 rounded-lg bg-white border border-[#cce0c6] hover:bg-[#e5efe2] text-[#1c3c18] text-[10px] font-bold transition flex items-center justify-center gap-1">
                    <span>💼</span> Staff
                </button>
            </div>
        </div>

        <!-- Footer / Links -->
        <div class="text-center pt-2 border-t border-[#eef3eb] text-xs text-slate-500 space-y-2">
            <div>
                Need a new account? 
                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl" class="font-bold text-[#2e5d26] hover:text-[#1c3c18] underline-offset-4 hover:underline">
                    Register here
                </a>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="text-[#557b4f] hover:text-[#1c3c18] font-semibold transition inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                    <span>Back to Public Festival Home</span>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const rolesConfig = {
            '@RoleConstants.Admin': {
                title: 'System Administrator',
                icon: '👑',
                tabClass: 'border-[#1c3c18] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm',
                email: 'tanmoy.cse.20230104124@aust.edu',
                placeholder: 'tanmoy.cse.20230104124@aust.edu'
            },
            '@RoleConstants.Vendor': {
                title: 'Fair Vendor',
                icon: '🎪',
                tabClass: 'border-[#2e5d26] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm',
                email: 'vendor@mela.com',
                placeholder: 'vendor@mela.com'
            },
            '@RoleConstants.Visitor': {
                title: 'Fair Visitor',
                icon: '🎟️',
                tabClass: 'border-[#4e8740] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm',
                email: 'visitor@mela.com',
                placeholder: 'visitor@mela.com'
            },
            '@RoleConstants.Employee': {
                title: 'Staff & Employee',
                icon: '💼',
                tabClass: 'border-[#386c2c] bg-[#e5efe2] text-[#1c3c18] font-bold shadow-sm',
                email: 'employee@mela.com',
                placeholder: 'employee@mela.com'
            }
        };

        function selectRole(role, title, icon, emailPlaceholder) {
            document.getElementById('targetRoleInput').value = role;
            document.getElementById('roleTitle').innerText = title;
            document.getElementById('roleIcon').innerText = icon;
            document.getElementById('loginEmail').placeholder = emailPlaceholder;

            // Update Tabs styling
            document.querySelectorAll('.role-tab').forEach(tab => {
                tab.className = 'role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center border-transparent text-slate-600 hover:text-[#1c3c18] hover:bg-[#f4f8f3]';
            });
            const activeTab = document.getElementById('tab-' + role);
            if (activeTab && rolesConfig[role]) {
                activeTab.className = 'role-tab flex flex-col items-center justify-center p-3 rounded-xl border-2 transition text-center ' + rolesConfig[role].tabClass;
            }
        }

        function fillCredentials(role, email, password) {
            selectRole(role, rolesConfig[role]?.title || '', rolesConfig[role]?.icon || '', email);
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }

        function togglePasswordVisibility() {
            const pass = document.getElementById('loginPassword');
            const eyeText = document.getElementById('eyeText');
            if (pass.type === 'password') {
                pass.type = 'text';
                eyeText.innerText = 'Hide';
            } else {
                pass.type = 'password';
                eyeText.innerText = 'Show';
            }
        }
    </script>
}
