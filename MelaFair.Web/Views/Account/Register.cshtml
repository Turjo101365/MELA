@model MelaFair.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="max-w-lg mx-auto my-8 space-y-6">
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-lg p-6 sm:p-8 space-y-6 relative overflow-hidden">
        <!-- Top subtle eco decorative bar -->
        <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#1c3c18] via-[#2e5d26] to-[#4e8740]"></div>

        <div class="text-center space-y-2">
            <div class="w-12 h-12 rounded-2xl bg-[#2e5d26] text-white mx-auto flex items-center justify-center font-black text-xl shadow-md shadow-[#2e5d26]/20">
                M
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-[#1c3c18] tracking-tight">Create an Account</h1>
            <p class="text-xs text-[#557b4f]">Join MELA Fair Management as a Vendor, Visitor, or Employee</p>
        </div>

        <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 p-3.5 rounded-xl"></div>

            <!-- Role Selector -->
            <div>
                <label class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-2">Select Your Role</label>
                <div class="grid grid-cols-3 gap-2">
                    <label class="border border-[#cce0c6] hover:border-[#2e5d26] rounded-xl p-3 text-center cursor-pointer transition has-[:checked]:border-[#2e5d26] has-[:checked]:bg-[#e5efe2] has-[:checked]:ring-1 has-[:checked]:ring-[#2e5d26]/30">
                        <input type="radio" asp-for="UserRole" value="@RoleConstants.Vendor" class="sr-only" />
                        <span class="block text-xl mb-1">🎪</span>
                        <span class="block text-xs font-bold text-[#1c3c18]">Vendor</span>
                        <span class="block text-[10px] text-[#557b4f]">Lease Stalls</span>
                    </label>

                    <label class="border border-[#cce0c6] hover:border-[#2e5d26] rounded-xl p-3 text-center cursor-pointer transition has-[:checked]:border-[#2e5d26] has-[:checked]:bg-[#e5efe2] has-[:checked]:ring-1 has-[:checked]:ring-[#2e5d26]/30">
                        <input type="radio" asp-for="UserRole" value="@RoleConstants.Visitor" class="sr-only" checked />
                        <span class="block text-xl mb-1">🎟️</span>
                        <span class="block text-xs font-bold text-[#1c3c18]">Visitor</span>
                        <span class="block text-[10px] text-[#557b4f]">Buy Passes</span>
                    </label>

                    <label class="border border-[#cce0c6] hover:border-[#2e5d26] rounded-xl p-3 text-center cursor-pointer transition has-[:checked]:border-[#2e5d26] has-[:checked]:bg-[#e5efe2] has-[:checked]:ring-1 has-[:checked]:ring-[#2e5d26]/30">
                        <input type="radio" asp-for="UserRole" value="@RoleConstants.Employee" class="sr-only" />
                        <span class="block text-xl mb-1">💼</span>
                        <span class="block text-xs font-bold text-[#1c3c18]">Employee</span>
                        <span class="block text-[10px] text-[#557b4f]">Fair Jobs</span>
                    </label>
                </div>
                <span asp-validation-for="UserRole" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="FullName" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1"></label>
                <input asp-for="FullName" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" placeholder="e.g. Rahim Ahmed" />
                <span asp-validation-for="FullName" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1"></label>
                <input asp-for="Email" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" placeholder="e.g. rahim@example.com" />
                <span asp-validation-for="Email" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="PhoneNumber" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1"></label>
                <input asp-for="PhoneNumber" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" placeholder="+880 1700 000000" />
                <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label asp-for="Password" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1"></label>
                    <input asp-for="Password" type="password" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1"></label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-sm shadow-md shadow-[#2e5d26]/20 transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2">
                <span>Create MELA Account</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <div class="text-center pt-2 border-t border-[#eef3eb] text-xs text-slate-500">
            Already have an account? 
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="font-bold text-[#2e5d26] hover:text-[#1c3c18] underline-offset-4 hover:underline">
                Sign In
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
