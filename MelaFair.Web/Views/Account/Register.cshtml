@model MelaFair.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="max-w-lg mx-auto my-6">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">
        <div class="text-center space-y-2">
            <div class="w-12 h-12 rounded-2xl bg-orange-600 text-white mx-auto flex items-center justify-center font-black text-xl shadow-md shadow-orange-500/20">
                M
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Create an Account</h1>
            <p class="text-xs text-slate-500">Join MELA Fair Management as a Vendor, Visitor, or Employee</p>
        </div>

        <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 p-3 rounded-lg"></div>

            <!-- Role Selector -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Select Your Role</label>
                <div class="grid grid-cols-3 gap-2">
                    <label class="border border-slate-200 hover:border-emerald-500 rounded-xl p-3 text-center cursor-pointer transition has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50">
                        <input type="radio" asp-for="UserRole" value="@RoleConstants.Vendor" class="sr-only" />
                        <span class="block text-xl mb-1">🎪</span>
                        <span class="block text-xs font-bold text-slate-800">Vendor</span>
                        <span class="block text-[10px] text-slate-500">Lease Stalls</span>
                    </label>

                    <label class="border border-slate-200 hover:border-blue-500 rounded-xl p-3 text-center cursor-pointer transition has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50">
                        <input type="radio" asp-for="UserRole" value="@RoleConstants.Visitor" class="sr-only" checked />
                        <span class="block text-xl mb-1">🎟️</span>
                        <span class="block text-xs font-bold text-slate-800">Visitor</span>
                        <span class="block text-[10px] text-slate-500">Buy Tickets</span>
                    </label>

                    <label class="border border-slate-200 hover:border-purple-500 rounded-xl p-3 text-center cursor-pointer transition has-[:checked]:border-purple-600 has-[:checked]:bg-purple-50">
                        <input type="radio" asp-for="UserRole" value="@RoleConstants.Employee" class="sr-only" />
                        <span class="block text-xl mb-1">💼</span>
                        <span class="block text-xs font-bold text-slate-800">Employee</span>
                        <span class="block text-[10px] text-slate-500">Fair Jobs</span>
                    </label>
                </div>
                <span asp-validation-for="UserRole" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="FullName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"></label>
                <input asp-for="FullName" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm" placeholder="e.g. Rahim Ahmed" />
                <span asp-validation-for="FullName" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"></label>
                <input asp-for="Email" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm" placeholder="e.g. rahim@example.com" />
                <span asp-validation-for="Email" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="PhoneNumber" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"></label>
                <input asp-for="PhoneNumber" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm" placeholder="+880 1700 000000" />
                <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label asp-for="Password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Password" type="password" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"></label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <button type="submit" class="w-full py-3 px-4 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm shadow-md shadow-orange-600/20 transition">
                Create Account
            </button>
        </form>

        <div class="text-center pt-2 border-t border-slate-100 text-xs text-slate-500">
            Already have an account? 
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="font-bold text-orange-600 hover:text-orange-700">
                Sign In
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
