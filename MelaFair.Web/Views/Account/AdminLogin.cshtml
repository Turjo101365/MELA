@{
    ViewData["Title"] = "Admin Login";
}

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
        <!-- Header with lock icon -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-red-600 to-orange-600 text-white mb-4 shadow-lg shadow-red-600/30">
                <i class="fas fa-lock text-2xl"></i>
            </div>
            <h1 class="text-3xl font-black text-white tracking-tight">Admin Access</h1>
            <p class="text-slate-300 text-sm mt-2">Secure Administrator Login Portal</p>
        </div>

        <!-- Main Login Card -->
        <div class="bg-white/10 backdrop-blur-xl rounded-2xl border border-white/20 shadow-2xl p-8 space-y-6">
            
            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="bg-red-500/20 border border-red-500/50 rounded-lg p-4 flex items-start gap-3">
                    <i class="fas fa-exclamation-circle text-red-400 mt-0.5"></i>
                    <div class="text-sm text-red-200">@ViewBag.ErrorMessage</div>
                </div>
            }

            <!-- Admin Info Box -->
            <div class="bg-purple-500/20 border border-purple-500/50 rounded-lg p-4 flex items-start gap-3">
                <i class="fas fa-shield-alt text-purple-300 mt-0.5"></i>
                <div class="text-sm text-purple-100">
                    <div class="font-semibold mb-1">Restricted Access</div>
                    <div class="text-xs opacity-90">Only authorized administrators can access this portal. Unauthorized access attempts are monitored and logged.</div>
                </div>
            </div>

            <!-- Login Form -->
            <form method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Email Field -->
                <div>
                    <label class="block text-sm font-semibold text-white mb-2">
                        <i class="fas fa-envelope mr-2"></i>Administrator Email
                    </label>
                    <input type="email" 
                           name="email" 
                           placeholder="tanmoy.cse.20230104124@aust.edu"
                           class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                           required
                           autocomplete="off" />
                </div>

                <!-- Password Field -->
                <div>
                    <label class="block text-sm font-semibold text-white mb-2">
                        <i class="fas fa-key mr-2"></i>Administrator Password
                    </label>
                    <input type="password" 
                           name="password" 
                           placeholder="••••••••"
                           class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                           required
                           autocomplete="off" />
                    <div class="text-xs text-slate-400 mt-2">
                        <i class="fas fa-info-circle mr-1"></i>Case-sensitive password
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        class="w-full py-3 px-4 rounded-lg bg-gradient-to-r from-red-600 to-orange-600 hover:from-red-700 hover:to-orange-700 text-white font-bold text-sm shadow-lg shadow-red-600/30 transition transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2">
                    <i class="fas fa-sign-in-alt"></i>
                    Authenticate Admin Access
                </button>
            </form>

            <!-- Divider -->
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-white/20"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-slate-900/50 text-slate-400">Or</span>
                </div>
            </div>

            <!-- Back to Regular Login -->
            <div class="text-center">
                <a href="@Url.Action("Login", "Account")" 
                   class="inline-flex items-center gap-2 text-slate-300 hover:text-white transition">
                    <i class="fas fa-arrow-left text-sm"></i>
                    Back to Regular Login
                </a>
            </div>
        </div>

        <!-- Footer Security Notice -->
        <div class="mt-8 text-center">
            <p class="text-slate-400 text-xs flex items-center justify-center gap-2">
                <i class="fas fa-lock-open"></i>
                Secure Connection | All login attempts are logged
                <i class="fas fa-lock-open"></i>
            </p>
        </div>
    </div>
</div>

<style>
    /* Remove autofill background color */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
        -webkit-box-shadow: 0 0 0 1000px rgba(255, 255, 255, 0.1) inset !important;
        -webkit-text-fill-color: white !important;
    }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus first field
            document.querySelector('input[name="email"]').focus();
            
            // Add shake animation on error
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <text>
                const form = document.querySelector('form');
                form.classList.add('animate-shake');
                setTimeout(() => form.classList.remove('animate-shake'), 600);
                </text>
            }
        });
    </script>
    <style>
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }
    </style>
}
