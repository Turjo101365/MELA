@{
    ViewData["Title"] = "Admin Security Access";
}

<div class="min-h-[85vh] flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md">
        <!-- Header with lock icon -->
        <div class="text-center mb-8 space-y-3">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-[#1c3c18] via-[#2e5d26] to-[#4e8740] text-white mb-2 shadow-xl shadow-[#1c3c18]/30 border border-emerald-500/20">
                <i class="fa-solid fa-shield-halved text-2xl text-emerald-300"></i>
            </div>
            <h1 class="text-3xl font-black text-[#1c3c18] tracking-tight">Admin Portal</h1>
            <p class="text-[#557b4f] text-xs font-medium">Enterprise Authentication &amp; System Oversight</p>
        </div>

        <!-- Main Login Card -->
        <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-xl p-8 space-y-6 relative overflow-hidden">
            <!-- Top brand bar -->
            <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#1c3c18] via-[#2e5d26] to-[#4e8740]"></div>
            
            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="bg-rose-50 border border-rose-200 rounded-xl p-4 flex items-start gap-3">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 mt-0.5 text-sm"></i>
                    <div class="text-xs font-semibold text-rose-700">@ViewBag.ErrorMessage</div>
                </div>
            }

            <!-- Admin Info Box -->
            <div class="bg-[#f4f8f3] border border-[#cce0c6] rounded-2xl p-4 flex items-start gap-3">
                <i class="fa-solid fa-lock text-[#2e5d26] mt-0.5 text-sm"></i>
                <div class="text-xs text-[#2e5d26]">
                    <div class="font-bold mb-0.5">Restricted Management Environment</div>
                    <div class="text-[11px] text-[#557b4f] leading-relaxed">
                        Dedicated portal for MELA system administrators. All authentication attempts and session operations are logged.
                    </div>
                </div>
            </div>

            <!-- Login Form -->
            <form method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Email Field -->
                <div>
                    <label class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1.5">
                        <i class="fa-solid fa-envelope mr-1.5 text-[#4e8740]"></i>Administrator Email
                    </label>
                    <input type="email" 
                           name="email" 
                           value="tanmoy.cse.20230104124@aust.edu"
                           placeholder="tanmoy.cse.20230104124@aust.edu"
                           class="w-full px-4 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition"
                           required
                           autocomplete="username" />
                </div>

                <!-- Password Field -->
                <div>
                    <label class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1.5">
                        <i class="fa-solid fa-key mr-1.5 text-[#4e8740]"></i>Administrator Password
                    </label>
                    <div class="relative">
                        <input type="password" 
                               id="adminPassword"
                               name="password" 
                               value="Turjo124"
                               placeholder="••••••••"
                               class="w-full pl-4 pr-12 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm transition"
                               required
                               autocomplete="current-password" />
                        <button type="button" onclick="toggleAdminPass()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-xs font-bold text-[#557b4f] hover:text-[#1c3c18]">
                            <span id="adminEyeText">Show</span>
                        </button>
                    </div>
                    <div class="text-[11px] text-[#557b4f] mt-1.5 flex items-center gap-1">
                        <i class="fa-solid fa-circle-info text-[10px]"></i>
                        <span>Default admin password: <code class="font-mono bg-[#e5efe2] px-1 py-0.5 rounded font-bold text-[#1c3c18]">Turjo124</code></span>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        class="w-full py-3.5 px-4 rounded-xl bg-[#1c3c18] hover:bg-[#0e200c] text-white font-bold text-sm shadow-md shadow-[#1c3c18]/25 transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-right-to-bracket text-xs text-emerald-400"></i>
                    <span>Authenticate Admin Access</span>
                </button>
            </form>

            <!-- Divider -->
            <div class="relative py-1">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-[#eef3eb]"></div>
                </div>
                <div class="relative flex justify-center text-xs">
                    <span class="px-3 bg-white text-[#557b4f] font-semibold">Or</span>
                </div>
            </div>

            <!-- Back to Regular Login -->
            <div class="text-center">
                <a href="@Url.Action("Login", "Account")" 
                   class="inline-flex items-center gap-2 text-xs font-bold text-[#2e5d26] hover:text-[#1c3c18] transition">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                    <span>Back to Standard Multi-Role Portal</span>
                </a>
            </div>
        </div>

        <!-- Footer Security Notice -->
        <div class="mt-6 text-center">
            <p class="text-[#557b4f] text-xs flex items-center justify-center gap-2">
                <i class="fa-solid fa-shield-halved text-[#4e8740]"></i>
                <span>SSL Encrypted Session &bull; ISO-Compliant Event Audit</span>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus password if email already populated
            const emailInput = document.querySelector('input[name="email"]');
            const passInput = document.getElementById('adminPassword');
            if (emailInput && emailInput.value) {
                passInput?.focus();
            } else {
                emailInput?.focus();
            }
            
            // Add shake animation on error
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <text>
                const form = document.querySelector('form');
                form?.classList.add('animate-shake');
                setTimeout(() => form?.classList.remove('animate-shake'), 600);
                </text>
            }
        });

        function toggleAdminPass() {
            const pass = document.getElementById('adminPassword');
            const eyeText = document.getElementById('adminEyeText');
            if (pass.type === 'password') {
                pass.type = 'text';
                eyeText.innerText = 'Hide';
            } else {
                pass.type = 'password';
                eyeText.innerText = 'Show';
            }
        }
    </script>
    <style>
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }
    </style>
}
