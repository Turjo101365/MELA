@model MelaFair.Web.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a New Password";
}

<div class="max-w-md mx-auto my-10">
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-lg p-6 sm:p-8 space-y-6 relative overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#1c3c18] via-[#2e5d26] to-[#4e8740]"></div>
        @if (ViewBag.InvalidToken == true)
        {
            <div class="text-center space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 mx-auto flex items-center justify-center text-xl"><i class="fa-solid fa-link-slash"></i></div>
                <h1 class="text-2xl font-black text-[#1c3c18]">This reset link is unavailable</h1>
                <p class="text-sm text-[#557b4f]">The link may be invalid, expired, or already used. Request a new password reset link to continue.</p>
                <a asp-action="ForgotPassword" class="inline-flex px-4 py-3 rounded-xl bg-[#2e5d26] text-white font-bold text-sm">Request a new link</a>
            </div>
        }
        else
        {
            <div class="text-center space-y-2"><div class="w-12 h-12 rounded-2xl bg-[#e5efe2] text-[#2e5d26] mx-auto flex items-center justify-center text-xl"><i class="fa-solid fa-lock"></i></div><h1 class="text-2xl font-black text-[#1c3c18]">Choose a new password</h1><p class="text-xs text-[#557b4f]">Your password must be at least 6 characters.</p></div>
            <form asp-action="ResetPassword" method="post" class="space-y-4" id="resetPasswordForm">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 p-3 rounded-xl"></div>
                <div><label asp-for="NewPassword" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1.5"></label><input asp-for="NewPassword" autocomplete="new-password" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-sm focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40" /><span asp-validation-for="NewPassword" class="text-xs text-rose-500 mt-1 block"></span></div>
                <div><label asp-for="ConfirmNewPassword" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1.5"></label><input asp-for="ConfirmNewPassword" autocomplete="new-password" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-sm focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40" /><span asp-validation-for="ConfirmNewPassword" class="text-xs text-rose-500 mt-1 block"></span></div>
                <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-sm transition flex items-center justify-center gap-2" data-submit><span>Reset password</span><i class="fa-solid fa-check text-xs"></i></button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>document.getElementById('resetPasswordForm')?.addEventListener('submit', function () { const button = this.querySelector('[data-submit]'); if (button && this.checkValidity()) { button.disabled = true; button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Resetting...</span>'; } });</script>
}
