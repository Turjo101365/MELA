@{ ViewData["Title"] = "Password Reset Complete"; }
<div class="max-w-md mx-auto my-10"><div class="bg-white rounded-3xl border border-[#dce8d8] shadow-lg p-6 sm:p-8 text-center space-y-5 relative overflow-hidden"><div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#1c3c18] via-[#2e5d26] to-[#4e8740]"></div><div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-700 mx-auto flex items-center justify-center text-2xl"><i class="fa-solid fa-check"></i></div><h1 class="text-2xl font-black text-[#1c3c18]">Password reset complete</h1><p class="text-sm text-[#557b4f]">Your password has been updated. Please sign in with your new password.</p><a asp-action="Login" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-sm"><span>Return to sign in</span><i class="fa-solid fa-arrow-right"></i></a></div></div>
