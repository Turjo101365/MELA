@model MelaFair.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="max-w-md mx-auto my-10">
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-lg p-6 sm:p-8 space-y-6 relative overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#1c3c18] via-[#2e5d26] to-[#4e8740]"></div>
        <div class="text-center space-y-2">
            <div class="w-12 h-12 rounded-2xl bg-[#e5efe2] text-[#2e5d26] mx-auto flex items-center justify-center text-xl"><i class="fa-solid fa-key"></i></div>
            <h1 class="text-2xl font-black text-[#1c3c18]">Reset your password</h1>
            <p class="text-xs text-[#557b4f]">Enter your registered email address and we will send a reset link.</p>
        </div>

        @if (ViewBag.RequestSubmitted == true)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
                If an account exists with this email, a password reset link has been sent.
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post" class="space-y-4" id="forgotPasswordForm">
                <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600"></div>
                <div>
                    <label asp-for="Email" class="block text-xs font-bold text-[#1c3c18] uppercase tracking-wider mb-1.5"></label>
                    <input asp-for="Email" autocomplete="email" placeholder="Enter your email" class="w-full px-3.5 py-2.5 rounded-xl border border-[#cce0c6] bg-[#fbfdfa] text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#2e5d26]/40 focus:border-[#2e5d26] text-sm" />
                    <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-sm transition flex items-center justify-center gap-2" data-submit>
                    <span>Send reset link</span><i class="fa-solid fa-paper-plane text-xs"></i>
                </button>
            </form>
        }

        <div class="text-center text-xs"><a asp-action="Login" class="font-bold text-[#2e5d26] hover:underline"><i class="fa-solid fa-arrow-left mr-1"></i>Back to sign in</a></div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.getElementById('forgotPasswordForm')?.addEventListener('submit', function () {
            const button = this.querySelector('[data-submit]');
            if (button && this.checkValidity()) { button.disabled = true; button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Sending...</span>'; }
        });
    </script>
}
