@model MelaFair.Web.Models.ViewModels.MyTicketsViewModel
@{
    ViewData["Title"] = "My Digital Admission Passes";
}

<div class="space-y-8">
    <!-- Header -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800">
                🎟️ E-Tickets Vault
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">My Digital Admission Passes</h1>
            <p class="text-xs sm:text-sm text-slate-500">
                Official electronic entry passes with unique verification codes and gate barcodes.
            </p>
        </div>

        <a asp-controller="Visitor" asp-action="BrowseFairs" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/20 transition self-start md:self-auto">
            + Purchase More Tickets
        </a>
    </div>

    @if (!Model.Tickets.Any())
    {
        <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center space-y-4 shadow-sm">
            <div class="w-16 h-16 rounded-3xl bg-blue-50 text-blue-600 mx-auto flex items-center justify-center text-3xl font-bold">
                🎟️
            </div>
            <h2 class="text-lg font-bold text-slate-900">No Admission Passes Yet</h2>
            <p class="text-xs text-slate-500 max-w-sm mx-auto">
                You haven't bought any festival tickets yet. Browse available fairs to book single or group entries!
            </p>
            <a asp-controller="Visitor" asp-action="BrowseFairs" class="inline-block px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md transition">
                Explore Fairs &amp; Passes
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var ticket in Model.Tickets)
            {
                <div class="bg-white rounded-3xl border-2 border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-blue-300 transition">
                    <!-- Ticket Pass Top Section -->
                    <div class="p-6 bg-gradient-to-r from-slate-900 to-slate-800 text-white space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500 text-white uppercase tracking-wider">
                                Official Pass
                            </span>
                            <span class="text-xs font-bold text-emerald-400">● @ticket.Status</span>
                        </div>
                        <h2 class="text-lg font-black tracking-tight leading-tight">@ticket.FairTitle</h2>
                        <p class="text-xs text-slate-300">📍 @ticket.Location</p>
                    </div>

                    <!-- Ticket Perforated Divider Bar -->
                    <div class="relative bg-white py-1 flex items-center justify-between border-y border-dashed border-slate-200 px-4">
                        <span class="w-4 h-4 bg-slate-50 border-r border-slate-200 rounded-full -ml-6 inline-block"></span>
                        <span class="text-[10px] font-mono text-slate-400 font-bold uppercase tracking-widest">
                            ADMIT @ticket.Quantity PERSON(S)
                        </span>
                        <span class="w-4 h-4 bg-slate-50 border-l border-slate-200 rounded-full -mr-6 inline-block"></span>
                    </div>

                    <!-- Pass Details -->
                    <div class="p-6 space-y-4">
                        <div class="grid grid-cols-2 gap-3 text-xs">
                            <div class="bg-slate-50 rounded-xl p-2.5">
                                <span class="block text-[10px] text-slate-400 uppercase font-semibold">Valid Visit Date</span>
                                <span class="font-bold text-slate-900">@ticket.VisitDate.ToString("ddd, MMM dd, yyyy")</span>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-2.5">
                                <span class="block text-[10px] text-slate-400 uppercase font-semibold">Amount Paid</span>
                                <span class="font-bold text-blue-700">$@ticket.PricePaid.ToString("N2")</span>
                            </div>
                        </div>

                        <!-- Barcode Mockup & Ticket Code -->
                        <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 text-center space-y-2">
                            <!-- SVG Barcode lines simulation -->
                            <div class="h-10 w-full flex items-center justify-center space-x-1 opacity-70">
                                <div class="w-1 h-full bg-slate-800"></div>
                                <div class="w-0.5 h-full bg-slate-800"></div>
                                <div class="w-2 h-full bg-slate-800"></div>
                                <div class="w-1 h-full bg-slate-800"></div>
                                <div class="w-0.5 h-full bg-slate-800"></div>
                                <div class="w-1.5 h-full bg-slate-800"></div>
                                <div class="w-1 h-full bg-slate-800"></div>
                                <div class="w-2 h-full bg-slate-800"></div>
                                <div class="w-0.5 h-full bg-slate-800"></div>
                                <div class="w-1 h-full bg-slate-800"></div>
                                <div class="w-2 h-full bg-slate-800"></div>
                                <div class="w-0.5 h-full bg-slate-800"></div>
                                <div class="w-1.5 h-full bg-slate-800"></div>
                                <div class="w-1 h-full bg-slate-800"></div>
                            </div>
                            <span class="block font-mono text-xs font-black text-slate-800 tracking-wider">
                                @ticket.TicketCode
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
