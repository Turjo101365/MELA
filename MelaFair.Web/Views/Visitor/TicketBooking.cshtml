@model MelaFair.Web.Models.ViewModels.TicketPurchaseViewModel
@{
    ViewData["Title"] = "Admission Passes Booking - " + Model.FairTitle;
}

<div class="max-w-5xl mx-auto space-y-8">

    <!-- 1. Event Summary Header Banner -->
    <div class="bg-white rounded-[2.5rem] border border-[#dce8d8] p-6 sm:p-8 lg:p-10 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3">
            <div class="flex items-center gap-2">
                <a asp-controller="Visitor" asp-action="BrowseFairs" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#2e5d26] hover:text-[#1c3c18] bg-[#eef4ed] hover:bg-[#e2ece0] px-3 py-1 rounded-full transition">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                    <span>Back to Passes</span>
                </a>
                <span class="text-slate-300">&bull;</span>
                <span class="text-xs font-bold text-[#2e5d26] bg-[#e5efe2] px-3 py-1 rounded-full">
                    <i class="fa-solid fa-shield-check text-emerald-600 mr-1"></i> Verified Admission Checkout
                </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#142a12] tracking-tight">
                @Model.FairTitle
            </h1>

            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600 font-medium">
                <span class="flex items-center gap-1.5">
                    <i class="fa-solid fa-location-dot text-[#2e5d26]"></i>
                    <span>@Model.Location</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <i class="fa-solid fa-ticket text-[#2e5d26]"></i>
                    <span>Base Admission: <strong class="text-slate-900">&#2547;@Model.BaseTicketPrice.ToString("N0")</strong> / person</span>
                </span>
            </div>
        </div>

        <!-- Zero-Oversell Concurrency Security Badge -->
        <div class="bg-[#142a12] text-white rounded-3xl p-5 max-w-xs text-xs space-y-2 shadow-md">
            <div class="flex items-center gap-2 text-emerald-400 font-bold">
                <i class="fa-solid fa-lock text-sm"></i>
                <span>Guaranteed Zero-Oversell</span>
            </div>
            <p class="text-[11px] text-[#c0dec0] leading-relaxed">
                Tickets are allocated via transactional row locks. Once purchased, your admission quota is immediately locked and verified.
            </p>
        </div>
    </div>

    <!-- 2. Purchase Form -->
    <form asp-controller="Visitor" asp-action="ProcessTicketPurchase" method="post" id="ticketPurchaseForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FairId" />
        <input type="hidden" asp-for="FairTitle" />
        <input type="hidden" asp-for="Location" />
        <input type="hidden" asp-for="BaseTicketPrice" id="baseTicketPrice" />
        <input type="hidden" asp-for="TotalAmount" id="hiddenTotalAmount" value="@Model.BaseTicketPrice" />
        <input type="hidden" asp-for="PaymentMethod" id="selectedPaymentMethod" value="@(string.IsNullOrEmpty(Model.PaymentMethod) ? "bKash" : Model.PaymentMethod)" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Date & Quantity Selection (8 Cols) -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- Step 1: Operating Date Selection -->
                <div class="bg-white rounded-[2rem] border border-[#dce8d8] p-6 sm:p-8 shadow-sm space-y-5">
                    <div class="border-b border-[#eef3eb] pb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-[#2e5d26] text-white text-xs font-black flex items-center justify-center">1</span>
                            <h2 class="text-base font-bold text-slate-900">Select Your Festival Visit Date</h2>
                        </div>
                        <p class="text-xs text-slate-500 mt-1 pl-8">
                            Choose an operating day with available admission capacity
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                        @foreach (var day in Model.AvailableDays)
                        {
                            var pctLeft = day.DailyCapacity > 0 ? (int)Math.Round((double)day.RemainingCapacity / day.DailyCapacity * 100) : 0;

                            if (day.IsSoldOut)
                            {
                                <div class="border border-slate-200 bg-slate-50/80 rounded-2xl p-4 opacity-50 cursor-not-allowed select-none">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-xs font-bold text-slate-400">@day.Date.ToString("ddd, MMM dd")</span>
                                        <span class="text-[10px] font-bold text-rose-600 uppercase bg-rose-50 px-2 py-0.5 rounded-full">Sold Out</span>
                                    </div>
                                    <div class="text-[11px] text-slate-400">All @day.DailyCapacity slots filled</div>
                                </div>
                            }
                            else
                            {
                                <label class="day-card-label border-2 border-[#dce8d8] hover:border-[#2e5d26] rounded-2xl p-4 cursor-pointer select-none transition-all has-[:checked]:border-[#2e5d26] has-[:checked]:bg-[#f4f8f3] has-[:checked]:shadow-md block">
                                    <input type="radio" asp-for="FairDayId" value="@day.FairDayId" class="sr-only day-radio" 
                                           data-date="@day.Date.ToString("dddd, MMM dd, yyyy")" 
                                           data-remaining="@day.RemainingCapacity" 
                                           onchange="updateTicketSummary()" />
                                    <div class="flex justify-between items-center mb-1.5">
                                        <span class="text-xs font-black text-slate-900">@day.Date.ToString("ddd, MMM dd")</span>
                                        <span class="text-[10px] font-bold text-[#2e5d26] bg-[#e5efe2] px-2.5 py-0.5 rounded-full">
                                            @day.RemainingCapacity Available
                                        </span>
                                    </div>
                                    <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden my-2">
                                        <div class="bg-[#2e5d26] h-1.5 rounded-full" style="width: @(100 - pctLeft)%"></div>
                                    </div>
                                    <div class="text-[10px] text-slate-500 flex justify-between">
                                        <span>@day.TicketsSold booked</span>
                                        <span>@pctLeft% left</span>
                                    </div>
                                </label>
                            }
                        }
                    </div>
                    <span asp-validation-for="FairDayId" class="text-xs text-rose-500 font-semibold block"></span>
                </div>

                <!-- Step 2: Pass Quantity Selector -->
                <div class="bg-white rounded-[2rem] border border-[#dce8d8] p-6 sm:p-8 shadow-sm space-y-5">
                    <div class="border-b border-[#eef3eb] pb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-[#2e5d26] text-white text-xs font-black flex items-center justify-center">2</span>
                            <h2 class="text-base font-bold text-slate-900">Choose Pass Quantity</h2>
                        </div>
                        <p class="text-xs text-slate-500 mt-1 pl-8">
                            Individual &amp; group passes available (1 to 50 passes per order)
                        </p>
                    </div>

                    <!-- Counter and quick chips -->
                    <div class="space-y-4 pt-1">
                        <div class="flex items-center space-x-4">
                            <button type="button" onclick="adjustQty(-1)" class="w-11 h-11 rounded-2xl bg-[#eef4ed] hover:bg-[#e2ece0] text-[#1c3c18] font-black text-lg flex items-center justify-center transition shadow-sm">
                                <i class="fa-solid fa-minus text-xs"></i>
                            </button>
                            <input asp-for="Quantity" id="ticketQty" type="number" min="1" max="50" onchange="updateTicketSummary()" 
                                   class="w-24 text-center py-2.5 rounded-2xl border-2 border-[#dce8d8] font-black text-xl text-[#142a12] focus:border-[#2e5d26] focus:outline-none" />
                            <button type="button" onclick="adjustQty(1)" class="w-11 h-11 rounded-2xl bg-[#eef4ed] hover:bg-[#e2ece0] text-[#1c3c18] font-black text-lg flex items-center justify-center transition shadow-sm">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                            <span class="text-xs font-medium text-slate-500">
                                Pass(es) for you &amp; companions
                            </span>
                        </div>

                        <!-- Quick Presets -->
                        <div class="flex flex-wrap items-center gap-2 pt-1">
                            <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider mr-1">Quick Select:</span>
                            <button type="button" onclick="setQty(1)" class="px-3 py-1 rounded-full bg-[#f6f9f4] hover:bg-[#eef4ed] border border-[#dce8d8] text-xs font-bold text-slate-700 transition">
                                1 Single
                            </button>
                            <button type="button" onclick="setQty(2)" class="px-3 py-1 rounded-full bg-[#f6f9f4] hover:bg-[#eef4ed] border border-[#dce8d8] text-xs font-bold text-slate-700 transition">
                                2 Couple
                            </button>
                            <button type="button" onclick="setQty(4)" class="px-3 py-1 rounded-full bg-[#f6f9f4] hover:bg-[#eef4ed] border border-[#dce8d8] text-xs font-bold text-slate-700 transition">
                                4 Family
                            </button>
                            <button type="button" onclick="setQty(10)" class="px-3 py-1 rounded-full bg-[#f6f9f4] hover:bg-[#eef4ed] border border-[#dce8d8] text-xs font-bold text-slate-700 transition">
                                10 Group
                            </button>
                        </div>
                    </div>
                    <span asp-validation-for="Quantity" class="text-xs text-rose-500 font-semibold block"></span>
                </div>

                <!-- Step 3: Inclusions Checklist Card -->
                <div class="bg-[#f6f9f4] rounded-[2rem] border border-[#dce8d8] p-6 space-y-3">
                    <h3 class="text-xs font-bold text-[#142a12] uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                        <span>What Your Pass Includes</span>
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-slate-600">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-check text-[#2e5d26] text-[11px]"></i>
                            <span>Full-day access: 8:00 AM &ndash; 10:00 PM</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-check text-[#2e5d26] text-[11px]"></i>
                            <span>Artisan &amp; Cultural Pavilion exhibits</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-check text-[#2e5d26] text-[11px]"></i>
                            <span>Live traditional music &amp; folk dances</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-check text-[#2e5d26] text-[11px]"></i>
                            <span>Free emergency medical &amp; safety booth</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Order Summary & Digital Voucher Mockup (5 Cols) -->
            <div class="lg:col-span-5 space-y-6">
                <div class="bg-white rounded-[2rem] border border-[#dce8d8] p-6 sm:p-7 shadow-lg space-y-6 sticky top-24">
                    
                    <div class="border-b border-[#eef3eb] pb-3 flex items-center justify-between">
                        <h2 class="text-base font-bold text-slate-900">Pass Order Summary</h2>
                        <span class="text-[10px] font-bold text-[#2e5d26] bg-[#e5efe2] px-2.5 py-0.5 rounded-full">
                            E-Ticket Order
                        </span>
                    </div>

                    <!-- Pass Order Breakdown Table -->
                    <div class="space-y-3 text-xs">
                        <div class="flex justify-between text-slate-600">
                            <span>Selected Festival:</span>
                            <span class="font-bold text-slate-900 text-right max-w-[180px] truncate">@Model.FairTitle</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Selected Visit Date:</span>
                            <span id="summaryDate" class="font-bold text-[#2e5d26] italic">Please select a date</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Rate per Pass:</span>
                            <span class="font-semibold text-slate-800">&#2547;@Model.BaseTicketPrice.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Pass Quantity:</span>
                            <span id="summaryQty" class="font-bold text-slate-900">1</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Service &amp; Processing Fee:</span>
                            <span class="font-semibold text-emerald-600">&#2547;0.00 (Waived)</span>
                        </div>
                    </div>

                    <!-- Total Amount Box -->
                    <div class="bg-[#f4f8f3] rounded-2xl p-4 border border-[#dce8d8] flex justify-between items-center">
                        <div>
                            <span class="block text-[11px] font-bold text-slate-500 uppercase">Total Amount Due</span>
                            <span class="text-[10px] text-slate-400">All taxes included</span>
                        </div>
                        <span id="summaryTotal" class="text-2xl font-black text-[#2e5d26]">
                            &#2547;@Model.BaseTicketPrice.ToString("N2")
                        </span>
                    </div>

                    <!-- Payment Methods Badges (Selectable) -->
                    <div class="space-y-2 text-center">
                        <div class="flex items-center justify-between text-[11px]">
                            <span class="font-bold uppercase tracking-wider text-slate-400">Select Payment Mode</span>
                            <span id="activePaymentLabel" class="text-pink-700 bg-pink-50 px-2.5 py-0.5 rounded-full border border-pink-200 text-[10px] font-bold inline-flex items-center gap-1">
                                <i class="fa-solid fa-circle-check text-pink-600 text-[9px]"></i>
                                <span id="activePaymentMethodText">bKash Selected</span>
                            </span>
                        </div>
                        
                        <div class="grid grid-cols-4 gap-2" id="paymentMethodsGrid">
                            <!-- bKash -->
                            <button type="button" 
                                    data-method="bKash"
                                    onclick="selectPaymentMode('bKash')"
                                    class="payment-mode-btn group py-2.5 px-1.5 rounded-xl border text-center transition-all duration-200 select-none focus:outline-none flex flex-col items-center justify-center gap-1 bg-pink-50 text-pink-700 border-pink-300 ring-2 ring-pink-500/40 shadow-xs scale-[1.02]">
                                <span class="w-6 h-6 rounded-lg bg-pink-100/80 group-hover:bg-pink-100 flex items-center justify-center text-pink-700 transition">
                                    <i class="fa-solid fa-mobile-screen-button text-[11px]"></i>
                                </span>
                                <span class="text-[10px] font-black tracking-tight">bKash</span>
                            </button>

                            <!-- Nagad -->
                            <button type="button" 
                                    data-method="Nagad"
                                    onclick="selectPaymentMode('Nagad')"
                                    class="payment-mode-btn group py-2.5 px-1.5 rounded-xl border text-center transition-all duration-200 select-none focus:outline-none flex flex-col items-center justify-center gap-1 bg-white text-orange-700 border-orange-200 hover:bg-orange-50/60 opacity-70">
                                <span class="w-6 h-6 rounded-lg bg-orange-100/80 group-hover:bg-orange-100 flex items-center justify-center text-orange-700 transition">
                                    <i class="fa-solid fa-money-bill-wave text-[11px]"></i>
                                </span>
                                <span class="text-[10px] font-black tracking-tight">Nagad</span>
                            </button>

                            <!-- Rocket -->
                            <button type="button" 
                                    data-method="Rocket"
                                    onclick="selectPaymentMode('Rocket')"
                                    class="payment-mode-btn group py-2.5 px-1.5 rounded-xl border text-center transition-all duration-200 select-none focus:outline-none flex flex-col items-center justify-center gap-1 bg-white text-purple-700 border-purple-200 hover:bg-purple-50/60 opacity-70">
                                <span class="w-6 h-6 rounded-lg bg-purple-100/80 group-hover:bg-purple-100 flex items-center justify-center text-purple-700 transition">
                                    <i class="fa-solid fa-bolt text-[11px]"></i>
                                </span>
                                <span class="text-[10px] font-black tracking-tight">Rocket</span>
                            </button>

                            <!-- Visa / Master -->
                            <button type="button" 
                                    data-method="Visa / Master"
                                    onclick="selectPaymentMode('Visa / Master')"
                                    class="payment-mode-btn group py-2.5 px-1.5 rounded-xl border text-center transition-all duration-200 select-none focus:outline-none flex flex-col items-center justify-center gap-1 bg-white text-blue-700 border-blue-200 hover:bg-blue-50/60 opacity-70">
                                <span class="w-6 h-6 rounded-lg bg-blue-100/80 group-hover:bg-blue-100 flex items-center justify-center text-blue-700 transition">
                                    <i class="fa-solid fa-credit-card text-[11px]"></i>
                                </span>
                                <span class="text-[10px] font-black tracking-tight leading-tight">Card</span>
                            </button>
                        </div>
                        <span asp-validation-for="PaymentMethod" class="text-xs text-rose-500 font-semibold block text-left"></span>
                    </div>

                    <!-- Submit Button with Simulated Payment Loading State -->
                    <button type="submit" id="btnSubmitTickets" disabled 
                            class="w-full py-3.5 px-5 rounded-full bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-sm shadow-md transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2">
                        <span id="btnSubmitIcon"><i class="fa-solid fa-lock text-xs"></i></span>
                        <span id="btnSubmitText">Confirm &amp; Purchase Passes</span>
                    </button>

                    <p class="text-[11px] text-slate-400 text-center leading-relaxed">
                        Instant QR pass and gate barcode will be generated and added to your pass vault upon confirmation.
                    </p>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Payment Mode configurations and style mappings
        const paymentStyles = {
            'bKash': {
                activeClasses: ['bg-pink-50', 'text-pink-700', 'border-pink-300', 'ring-2', 'ring-pink-500/40', 'shadow-xs', 'scale-[1.02]'],
                inactiveClasses: ['bg-white', 'text-pink-700', 'border-pink-200', 'hover:bg-pink-50/60', 'opacity-70'],
                badgeClass: 'text-pink-700 bg-pink-50 border-pink-200',
                iconColor: 'text-pink-600',
                displayName: 'bKash'
            },
            'Nagad': {
                activeClasses: ['bg-orange-50', 'text-orange-700', 'border-orange-300', 'ring-2', 'ring-orange-500/40', 'shadow-xs', 'scale-[1.02]'],
                inactiveClasses: ['bg-white', 'text-orange-700', 'border-orange-200', 'hover:bg-orange-50/60', 'opacity-70'],
                badgeClass: 'text-orange-700 bg-orange-50 border-orange-200',
                iconColor: 'text-orange-600',
                displayName: 'Nagad'
            },
            'Rocket': {
                activeClasses: ['bg-purple-50', 'text-purple-700', 'border-purple-300', 'ring-2', 'ring-purple-500/40', 'shadow-xs', 'scale-[1.02]'],
                inactiveClasses: ['bg-white', 'text-purple-700', 'border-purple-200', 'hover:bg-purple-50/60', 'opacity-70'],
                badgeClass: 'text-purple-700 bg-purple-50 border-purple-200',
                iconColor: 'text-purple-600',
                displayName: 'Rocket'
            },
            'Visa / Master': {
                activeClasses: ['bg-blue-50', 'text-blue-700', 'border-blue-300', 'ring-2', 'ring-blue-500/40', 'shadow-xs', 'scale-[1.02]'],
                inactiveClasses: ['bg-white', 'text-blue-700', 'border-blue-200', 'hover:bg-blue-50/60', 'opacity-70'],
                badgeClass: 'text-blue-700 bg-blue-50 border-blue-200',
                iconColor: 'text-blue-600',
                displayName: 'Visa / Master'
            }
        };

        function selectPaymentMode(method) {
            const hiddenInput = document.getElementById('selectedPaymentMethod');
            if (hiddenInput) {
                hiddenInput.value = method;
            }

            const activeBadge = document.getElementById('activePaymentLabel');
            const activeText = document.getElementById('activePaymentMethodText');
            const config = paymentStyles[method] || paymentStyles['bKash'];

            if (activeBadge && activeText) {
                activeBadge.className = `${config.badgeClass} px-2.5 py-0.5 rounded-full border text-[10px] font-bold inline-flex items-center gap-1`;
                activeBadge.innerHTML = `<i class="fa-solid fa-circle-check ${config.iconColor} text-[9px]"></i> <span id="activePaymentMethodText">${config.displayName} Selected</span>`;
            }

            // Update badge buttons styling
            const buttons = document.querySelectorAll('.payment-mode-btn');
            buttons.forEach(btn => {
                const btnMethod = btn.getAttribute('data-method');
                const btnConfig = paymentStyles[btnMethod];
                if (!btnConfig) return;

                // Remove all potential active and inactive state classes
                btn.classList.remove(...btnConfig.activeClasses, ...btnConfig.inactiveClasses);

                if (btnMethod === method) {
                    btn.classList.add(...btnConfig.activeClasses);
                } else {
                    btn.classList.add(...btnConfig.inactiveClasses);
                }
            });
        }

        function adjustQty(delta) {
            const qtyInput = document.getElementById('ticketQty');
            let current = parseInt(qtyInput.value) || 1;
            current = Math.max(1, Math.min(50, current + delta));
            qtyInput.value = current;
            updateTicketSummary();
        }

        function setQty(val) {
            const qtyInput = document.getElementById('ticketQty');
            qtyInput.value = Math.max(1, Math.min(50, val));
            updateTicketSummary();
        }

        function updateTicketSummary() {
            const selectedRadio = document.querySelector('.day-radio:checked');
            const qtyInput = document.getElementById('ticketQty');
            const basePrice = parseFloat(document.getElementById('baseTicketPrice').value) || 0;
            const btnSubmit = document.getElementById('btnSubmitTickets');
            const hiddenTotalAmount = document.getElementById('hiddenTotalAmount');

            const qty = Math.max(1, Math.min(50, parseInt(qtyInput.value) || 1));
            document.getElementById('summaryQty').innerText = qty;

            if (selectedRadio) {
                document.getElementById('summaryDate').innerText = selectedRadio.dataset.date;
                if (!isProcessingPayment) {
                    btnSubmit.disabled = false;
                }
            } else {
                document.getElementById('summaryDate').innerText = 'Please select a date';
                btnSubmit.disabled = true;
            }

            const total = qty * basePrice;
            document.getElementById('summaryTotal').innerText = '৳' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (hiddenTotalAmount) {
                hiddenTotalAmount.value = total.toFixed(2);
            }
        }

        let isProcessingPayment = false;

        document.addEventListener('DOMContentLoaded', () => {
            // Initialize payment mode from hidden input or default to bKash
            const hiddenInput = document.getElementById('selectedPaymentMethod');
            const initialMethod = (hiddenInput && hiddenInput.value) ? hiddenInput.value : 'bKash';
            selectPaymentMode(initialMethod);

            // Initialize ticket summary
            updateTicketSummary();

            // Intercept form submission to display simulated payment gateway loading state
            const form = document.getElementById('ticketPurchaseForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (isProcessingPayment) {
                        e.preventDefault();
                        return false;
                    }

                    const selectedDay = document.querySelector('.day-radio:checked');
                    if (!selectedDay) {
                        e.preventDefault();
                        alert('Please select a visit date to continue.');
                        return false;
                    }

                    const paymentMethod = document.getElementById('selectedPaymentMethod')?.value || 'Payment Gateway';

                    // Pause immediate submit to demonstrate the payment gateway authorization delay
                    e.preventDefault();
                    isProcessingPayment = true;

                    const btn = document.getElementById('btnSubmitTickets');
                    const btnIcon = document.getElementById('btnSubmitIcon');
                    const btnText = document.getElementById('btnSubmitText');

                    btn.disabled = true;
                    btn.classList.remove('hover:scale-[1.02]', 'active:scale-[0.98]');
                    btn.classList.add('cursor-wait', 'opacity-90');

                    btnIcon.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-sm"></i>';
                    btnText.innerText = `Processing Payment via ${paymentMethod}...`;

                    // Simulated 1.4s gateway handshake before submitting form
                    setTimeout(() => {
                        form.submit();
                    }, 1400);
                });
            }
        });
    </script>
}
