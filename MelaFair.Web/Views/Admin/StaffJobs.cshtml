@model MelaFair.Web.Models.ViewModels.AdminStaffJobsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Staff Recruitment & Jobs Oversight";
}

<div class="space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e5efe2] text-[#2e5d26] text-xs font-bold uppercase tracking-wider mb-1 shadow-xs">
                <i class="fa-solid fa-briefcase"></i> Global Recruitment & Staff Command
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-[#1c3c18] tracking-tight">Staff Jobs & Hiring Pipelines</h2>
            <p class="text-xs sm:text-sm text-[#557b4f]">Unrestricted oversight of vendor employment postings, candidate resumes, and staff hiring decisions.</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Employee" asp-action="JobListings" class="px-4 py-2.5 rounded-full bg-white hover:bg-[#e5efe2] border border-[#dbe6d6] text-[#2e5d26] font-bold text-xs shadow-xs transition-all flex items-center gap-2">
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                <span>Public Job Board</span>
            </a>
            <a asp-controller="Vendor" asp-action="Jobs" class="px-4 py-2.5 rounded-full bg-[#2e5d26] hover:bg-[#1c3c18] text-white font-bold text-xs shadow-sm shadow-[#2e5d26]/20 transition-all flex items-center gap-2">
                <i class="fa-solid fa-user-plus text-xs"></i>
                <span>Manage Vendor Jobs</span>
            </a>
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-3xl border border-[#dce8d8] p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-xs font-bold text-[#557b4f] uppercase tracking-wider">
                <span>Job Openings</span>
                <span class="w-8 h-8 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-sm shadow-xs"><i class="fa-solid fa-bullhorn"></i></span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-[#1c3c18]">@Model.ActiveJobs <span class="text-sm font-bold text-slate-400">/ @Model.TotalJobPostings Total</span></div>
            <div class="text-[11px] text-slate-500">Active hiring roles posted by vendors</div>
        </div>

        <div class="bg-white rounded-3xl border border-[#dce8d8] p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-xs font-bold text-[#557b4f] uppercase tracking-wider">
                <span>Positions Filled</span>
                <span class="w-8 h-8 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-sm shadow-xs"><i class="fa-solid fa-user-check"></i></span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-emerald-800">@Model.TotalPositionsFilled <span class="text-sm font-bold text-slate-400">/ @Model.TotalPositionsAvailable Available</span></div>
            @{
                var fillPct = Model.TotalPositionsAvailable > 0 ? (Model.TotalPositionsFilled * 100) / Model.TotalPositionsAvailable : 0;
            }
            <div class="w-full bg-[#eef3eb] rounded-full h-1.5 overflow-hidden">
                <div class="bg-[#2e5d26] h-1.5 rounded-full" style="width: @fillPct%"></div>
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-[#dce8d8] p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-xs font-bold text-[#557b4f] uppercase tracking-wider">
                <span>Applications Received</span>
                <span class="w-8 h-8 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-sm shadow-xs"><i class="fa-solid fa-file-lines"></i></span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-[#1c3c18]">@Model.TotalApplicationsReceived</div>
            <div class="text-[11px] text-[#2e5d26] font-semibold">Total submissions processed</div>
        </div>

        <div class="bg-white rounded-3xl border border-[#dce8d8] p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-xs font-bold text-[#557b4f] uppercase tracking-wider">
                <span>Pending Review</span>
                <span class="w-8 h-8 rounded-xl bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center text-sm shadow-xs"><i class="fa-solid fa-hourglass-half"></i></span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-amber-600">@Model.PendingApplications</div>
            <div class="text-[11px] text-slate-500">Awaiting recruiter/admin verdict</div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="bg-white rounded-3xl border border-[#dce8d8] p-5 shadow-sm">
        <form method="get" asp-action="StaffJobs" class="flex flex-wrap items-center gap-3">
            <div class="flex-1 min-w-[180px]">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-[#557b4f] mb-1">Filter By Fair</label>
                <select name="fairId" onchange="this.form.submit()" class="w-full text-xs font-semibold px-3 py-2 rounded-xl border border-[#dbe6d6] bg-[#f8faf7] text-[#1c3c18] focus:outline-none focus:ring-2 focus:ring-[#2e5d26]">
                    <option value="">-- All Cultural Fairs --</option>
                    @foreach (var fair in Model.Fairs)
                    {
                        <option value="@fair.FairId" selected="@(Model.SelectedFairId == fair.FairId)">@fair.Title</option>
                    }
                </select>
            </div>

            <div class="min-w-[160px]">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-[#557b4f] mb-1">Department</label>
                <select name="department" onchange="this.form.submit()" class="w-full text-xs font-semibold px-3 py-2 rounded-xl border border-[#dbe6d6] bg-[#f8faf7] text-[#1c3c18] focus:outline-none focus:ring-2 focus:ring-[#2e5d26]">
                    <option value="">-- All Departments --</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(Model.SelectedDepartment == dept)">@dept</option>
                    }
                </select>
            </div>

            <div class="flex-1 min-w-[220px]">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-[#557b4f] mb-1">Search Openings / Resumes</label>
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" name="search" value="@Model.SearchQuery" placeholder="Job title, vendor employer, fair..." class="w-full text-xs px-3 py-2 pl-9 rounded-xl border border-[#dbe6d6] bg-[#f8faf7] text-[#1c3c18] focus:outline-none focus:ring-2 focus:ring-[#2e5d26]" />
                </div>
            </div>

            <div class="flex items-end gap-2 pt-4">
                <button type="submit" class="px-5 py-2 rounded-xl bg-[#2e5d26] text-white font-bold text-xs shadow-xs hover:bg-[#1c3c18] transition">Filter</button>
                @if (Model.SelectedFairId.HasValue || !string.IsNullOrEmpty(Model.SelectedDepartment) || !string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-action="StaffJobs" class="px-3 py-2 rounded-xl bg-[#e5efe2] text-[#2e5d26] font-bold text-xs hover:bg-[#d8ebd4] transition">Reset</a>
                }
            </div>
        </form>
    </div>

    <!-- Job Postings Registry Table -->
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-sm overflow-hidden">
        <div class="p-5 border-b border-[#eef3eb] flex items-center justify-between">
            <div>
                <h3 class="font-black text-base text-[#1c3c18]">Active & Completed Staff Job Postings</h3>
                <p class="text-xs text-slate-500">Recruitment listings published by fair vendors</p>
            </div>
            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-[#e5efe2] text-[#2e5d26]">@Model.JobPostings.Count Job Roles</span>
        </div>

        @if (!Model.JobPostings.Any())
        {
            <div class="p-8 text-center text-slate-500 text-xs">
                No job postings found matching your filter criteria.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-[#eef5ec] text-[#2e5d26] font-bold uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="py-3.5 px-4 rounded-l-xl">Role Title</th>
                            <th class="py-3.5 px-4">Fair & Host Vendor</th>
                            <th class="py-3.5 px-4">Department</th>
                            <th class="py-3.5 px-4">Daily Wage</th>
                            <th class="py-3.5 px-4">Openings Filled</th>
                            <th class="py-3.5 px-4">Applicants</th>
                            <th class="py-3.5 px-4">Status</th>
                            <th class="py-3.5 px-4 text-right rounded-r-xl">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0f6ee] text-slate-700">
                        @foreach (var job in Model.JobPostings)
                        {
                            <tr class="hover:bg-[#f8faf7] transition-colors">
                                <td class="py-3.5 px-4 font-bold text-[#1c3c18]">
                                    @job.Title
                                    <span class="block text-[10px] text-slate-400 font-normal">Deadline: @job.ApplicationDeadline.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-[#1c3c18] block">@job.FairTitle</span>
                                    <span class="text-[10px] text-slate-500">By: @job.VendorName</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-[#eef3eb] text-slate-700">@job.Department</span>
                                </td>
                                <td class="py-3.5 px-4 font-bold text-emerald-800">
                                    $@job.DailyWage.ToString("N0") <span class="text-[10px] font-normal text-slate-400">/day</span>
                                </td>
                                <td class="py-3.5 px-4 font-semibold">
                                    <span class="@(job.PositionsFilled >= job.PositionsAvailable ? "text-emerald-700" : "text-[#1c3c18]")">
                                        @job.PositionsFilled / @job.PositionsAvailable
                                    </span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-[#1c3c18]">@job.ApplicationsCount</span>
                                    @if (job.PendingApplicationsCount > 0)
                                    {
                                        <span class="ml-1 px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-100 text-amber-800">@job.PendingApplicationsCount pending</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (job.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">
                                            Closed
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap space-x-1">
                                    <a asp-controller="Vendor" asp-action="JobApplications" asp-route-jobPostingId="@job.JobPostingId" class="px-3 py-1 rounded-full bg-[#e5efe2] hover:bg-[#2e5d26] text-[#2e5d26] hover:text-white text-[11px] font-bold transition shadow-xs">
                                        View Pipeline
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Candidate Applications & Direct Decision Table -->
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-sm overflow-hidden">
        <div class="p-5 border-b border-[#eef3eb] flex items-center justify-between">
            <div>
                <h3 class="font-black text-base text-[#1c3c18]">Candidate Applications & Decision Desk</h3>
                <p class="text-xs text-slate-500">Review applicant qualifications and render instant hiring decisions</p>
            </div>
            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-[#eef3eb] text-slate-700">@Model.Applications.Count Candidate Applications</span>
        </div>

        @if (!Model.Applications.Any())
        {
            <div class="p-8 text-center text-slate-500 text-xs">
                No job applications have been submitted for the selected criteria.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-[#eef5ec] text-[#2e5d26] font-bold uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="py-3.5 px-4 rounded-l-xl">Applicant</th>
                            <th class="py-3.5 px-4">Role & Fair</th>
                            <th class="py-3.5 px-4">Contact Info</th>
                            <th class="py-3.5 px-4">Experience & Resume</th>
                            <th class="py-3.5 px-4">Application Date</th>
                            <th class="py-3.5 px-4">Status</th>
                            <th class="py-3.5 px-4 text-right rounded-r-xl">Admin Review Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0f6ee] text-slate-700">
                        @foreach (var app in Model.Applications)
                        {
                            <tr class="hover:bg-[#f8faf7] transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-full bg-[#e5efe2] text-[#2e5d26] flex items-center justify-center font-bold text-xs">
                                            @(app.ApplicantName.Length > 0 ? app.ApplicantName[0].ToString().ToUpper() : "A")
                                        </div>
                                        <div>
                                            <span class="font-bold text-[#1c3c18] block">@app.ApplicantName</span>
                                            <span class="text-[10px] text-slate-400">Applicant #@app.JobApplicationId</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-[#1c3c18] block">@app.JobTitle</span>
                                    <span class="text-[10px] text-[#557b4f]">@app.FairTitle &bull; @app.Department</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="text-slate-700 block">@app.ApplicantEmail</span>
                                    <span class="text-[10px] text-slate-400">@app.ContactPhone</span>
                                </td>
                                <td class="py-3.5 px-4 max-w-xs">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef3eb] text-[#2e5d26]">@app.ExperienceYears Yrs Exp</span>
                                    <p class="text-[11px] text-slate-600 mt-1 line-clamp-2" title="@app.ResumeSummary">@app.ResumeSummary</p>
                                </td>
                                <td class="py-3.5 px-4 text-slate-500 whitespace-nowrap">
                                    @app.ApplicationDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    @if (app.Status == MelaFair.Core.Enums.ApplicationStatus.Accepted)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                            <i class="fa-solid fa-check mr-1"></i> Accepted
                                        </span>
                                    }
                                    else if (app.Status == MelaFair.Core.Enums.ApplicationStatus.Rejected)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-red-100 text-red-700">
                                            <i class="fa-solid fa-xmark mr-1"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                            <i class="fa-solid fa-clock mr-1"></i> Pending
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <form method="post" asp-action="ReviewJobApplication" class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="applicationId" value="@app.JobApplicationId" />
                                            <input type="hidden" name="status" value="@MelaFair.Core.Enums.ApplicationStatus.Accepted" />
                                            <input type="hidden" name="fairId" value="@Model.SelectedFairId" />
                                            <button type="submit" class="px-2.5 py-1 rounded-full bg-emerald-50 hover:bg-emerald-600 text-emerald-800 hover:text-white text-[10px] font-bold transition shadow-xs" title="Accept candidate for role">
                                                <i class="fa-solid fa-check mr-0.5"></i> Accept
                                            </button>
                                        </form>

                                        <form method="post" asp-action="ReviewJobApplication" class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="applicationId" value="@app.JobApplicationId" />
                                            <input type="hidden" name="status" value="@MelaFair.Core.Enums.ApplicationStatus.Rejected" />
                                            <input type="hidden" name="fairId" value="@Model.SelectedFairId" />
                                            <button type="submit" class="px-2.5 py-1 rounded-full bg-red-50 hover:bg-red-600 text-red-700 hover:text-white text-[10px] font-bold transition shadow-xs" title="Reject candidate">
                                                <i class="fa-solid fa-xmark mr-0.5"></i> Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
