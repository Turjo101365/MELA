@model IEnumerable<MelaFair.Web.Models.ViewModels.DailyVisitorCountViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Database Analytics (Views)";
    var summaries = ViewBag.FairSummaries as IEnumerable<MelaFair.Web.Models.ViewModels.FairSummaryViewModel> ?? Enumerable.Empty<MelaFair.Web.Models.ViewModels.FairSummaryViewModel>();
    var allFairs = ViewBag.AllFairs as IEnumerable<MelaFair.Web.Models.Entities.Fair> ?? Enumerable.Empty<MelaFair.Web.Models.Entities.Fair>();
    int? selectedFairId = ViewBag.SelectedFairId as int?;
}

<div class="space-y-8">
    <!-- Header with Filter -->
    <div class="bg-white rounded-3xl border border-[#dce8d8] p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl sm:text-2xl font-black text-[#1c3c18]">SQL View Analytics Engine</h2>
            <p class="text-xs text-slate-500 mt-0.5">Live reporting consumed from <code class="text-[#2e5d26] font-mono bg-[#e5efe2] px-2 py-0.5 rounded-md">vw_FairSummary</code> and <code class="text-[#2e5d26] font-mono bg-[#e5efe2] px-2 py-0.5 rounded-md">vw_DailyVisitorCount</code></p>
        </div>

        <!-- Filter Dropdown -->
        <form method="get" asp-controller="Admin" asp-action="Analytics" class="flex items-center gap-2">
            <select name="fairId" onchange="this.form.submit()" class="px-4 py-2 text-xs rounded-full border border-[#dce8d8] focus:ring-2 focus:ring-[#2e5d26] focus:border-[#2e5d26] font-bold text-[#1c3c18] bg-[#f8faf7]">
                <option value="">-- All Fairs Aggregate --</option>
                @foreach (var fair in allFairs)
                {
                    if (selectedFairId == fair.FairId)
                    {
                        <option value="@fair.FairId" selected>@fair.Title</option>
                    }
                    else
                    {
                        <option value="@fair.FairId">@fair.Title</option>
                    }
                }
            </select>
        </form>
    </div>

    <!-- Section 1: vw_FairSummary Cards -->
    <div class="space-y-4">
        <h3 class="text-sm font-bold text-[#1c3c18] uppercase tracking-wider flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#2e5d26]"></span> 
            vw_FairSummary - Financial &amp; Occupancy Breakdown
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var s in summaries.Where(x => !selectedFairId.HasValue || x.FairId == selectedFairId.Value))
            {
                <div class="bg-white rounded-3xl border border-[#dce8d8] p-5 sm:p-6 shadow-sm space-y-4 hover:shadow-md transition">
                    <div class="border-b border-[#eef3eb] pb-3">
                        <span class="text-[10px] font-bold text-[#2e5d26] uppercase tracking-widest block">Fair #@s.FairId</span>
                        <h4 class="text-base font-bold text-[#1c3c18] mt-0.5">@s.Title</h4>
                        <span class="text-xs text-slate-500">@s.Location</span>
                    </div>

                    <!-- Occupancy Gauges -->
                    <div class="space-y-2.5 text-xs">
                        <div>
                            <div class="flex justify-between font-semibold mb-1">
                                <span class="text-slate-600">Stall Occupancy Rate:</span>
                                <span class="text-[#2e5d26] font-bold">@s.StallOccupancyRate% (@s.BookedStalls / @s.TotalStalls)</span>
                            </div>
                            <div class="w-full bg-[#eef3eb] rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-[#2e5d26] to-[#4e8740] h-2 rounded-full" style="width: @s.StallOccupancyRate%"></div>
                            </div>
                        </div>

                        <div>
                            <div class="flex justify-between font-semibold mb-1">
                                <span class="text-slate-600">Ticket Capacity Sold:</span>
                                <span class="text-emerald-800 font-bold">@s.TicketCapacitySoldPercentage% (@s.TotalTicketsSold / @s.TotalTicketCapacity)</span>
                            </div>
                            <div class="w-full bg-[#eef3eb] rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-emerald-600 to-teal-500 h-2 rounded-full" style="width: @s.TicketCapacitySoldPercentage%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Revenue Breakdown -->
                    <div class="bg-[#f8faf7] rounded-2xl p-3.5 grid grid-cols-3 gap-2 text-center text-xs border border-[#eef3eb]">
                        <div>
                            <span class="block text-[10px] text-slate-500 uppercase font-semibold">Stalls</span>
                            <span class="font-bold text-[#1c3c18]">$@s.StallRevenue.ToString("N0")</span>
                        </div>
                        <div>
                            <span class="block text-[10px] text-slate-500 uppercase font-semibold">Tickets</span>
                            <span class="font-bold text-[#1c3c18]">$@s.TicketRevenue.ToString("N0")</span>
                        </div>
                        <div class="border-l border-[#dce8d8]">
                            <span class="block text-[10px] text-[#2e5d26] uppercase font-bold">Total</span>
                            <span class="font-black text-[#1c3c18]">$@s.TotalRevenue.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Section 2: vw_DailyVisitorCount Table -->
    <div class="bg-white rounded-3xl border border-[#dce8d8] shadow-sm overflow-hidden p-6 sm:p-7 space-y-4">
        <div class="flex items-center justify-between border-b border-[#eef3eb] pb-3">
            <div>
                <h3 class="text-base font-black text-[#1c3c18]">vw_DailyVisitorCount - Operating Day Capacity Analysis</h3>
                <p class="text-xs text-slate-500 mt-0.5">Day-by-day ticket sales and utilization metrics</p>
            </div>
            <span class="text-xs px-3 py-1 rounded-full bg-[#e5efe2] text-[#2e5d26] font-bold border border-[#cce0c6]">
                @Model.Count() Recorded Operating Day(s)
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-[#eef5ec] text-[#2e5d26] font-bold uppercase tracking-wider text-[10px] border-b border-[#dce8d8]">
                    <tr>
                        <th class="py-3.5 px-4 rounded-l-xl">Fair Title</th>
                        <th class="py-3.5 px-4">Operating Date</th>
                        <th class="py-3.5 px-4">Daily Quota</th>
                        <th class="py-3.5 px-4">Tickets Sold</th>
                        <th class="py-3.5 px-4">Remaining Quota</th>
                        <th class="py-3.5 px-4">Capacity Utilization</th>
                        <th class="py-3.5 px-4 text-right rounded-r-xl font-black text-[#1c3c18]">Daily Ticket Revenue</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#f0f6ee] text-slate-700">
                    @foreach (var row in Model)
                    {
                        <tr class="hover:bg-[#f8faf7] transition-colors">
                            <td class="py-4 px-4 font-bold text-[#1c3c18]">@row.FairTitle</td>
                            <td class="py-4 px-4 whitespace-nowrap font-medium text-slate-700">
                                @row.FairDate.ToString("dddd, MMM dd, yyyy")
                            </td>
                            <td class="py-4 px-4 font-semibold text-slate-700">@row.DailyCapacity.ToString("N0")</td>
                            <td class="py-4 px-4 font-bold text-[#2e5d26]">@row.TicketsSold.ToString("N0")</td>
                            <td class="py-4 px-4 font-semibold text-emerald-700">@row.RemainingCapacity.ToString("N0")</td>
                            <td class="py-4 px-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-20 bg-[#eef3eb] rounded-full h-1.5 overflow-hidden">
                                        <div class="bg-gradient-to-r from-[#2e5d26] to-[#4e8740] h-1.5 rounded-full" style="width: @row.CapacityUtilizationPercent%"></div>
                                    </div>
                                    <span class="font-bold text-[#1c3c18]">@row.CapacityUtilizationPercent%</span>
                                </div>
                            </td>
                            <td class="py-4 px-4 text-right font-black text-[#1c3c18]">
                                $@row.DailyTicketRevenue.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
