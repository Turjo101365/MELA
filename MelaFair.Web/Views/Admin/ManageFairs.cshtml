@model IEnumerable<MelaFair.Web.Models.Entities.Fair>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Cultural Fairs";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-bold text-slate-900">Registered Cultural Fairs</h2>
            <p class="text-xs text-slate-500">Manage fair lifecycles, inspect schedules, or perform cascade deletion</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateFair" class="px-4 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-xs shadow-md shadow-orange-600/20 transition self-start sm:self-auto">
            + New Fair
        </a>
    </div>

    <!-- Fairs Table -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-600 font-bold uppercase tracking-wider text-[10px] border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-4">ID</th>
                        <th class="py-3.5 px-4">Fair Name &amp; Location</th>
                        <th class="py-3.5 px-4">Schedule</th>
                        <th class="py-3.5 px-4">Stall Inventory</th>
                        <th class="py-3.5 px-4">Pricing</th>
                        <th class="py-3.5 px-4">Status</th>
                        <th class="py-3.5 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @foreach (var fair in Model)
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-4 px-4 font-mono font-bold text-slate-500">#@fair.FairId</td>
                            <td class="py-4 px-4">
                                <span class="font-bold text-slate-900 block text-sm">@fair.Title</span>
                                <span class="text-[11px] text-slate-500">@fair.Location</span>
                            </td>
                            <td class="py-4 px-4 whitespace-nowrap">
                                <span class="font-semibold text-slate-800">@fair.StartDate.ToString("MMM dd") - @fair.EndDate.ToString("MMM dd, yyyy")</span>
                                <span class="block text-[10px] text-slate-500">@fair.FairDays.Count operating day(s)</span>
                            </td>
                            <td class="py-4 px-4">
                                <span class="font-bold text-emerald-700">@fair.AvailableStalls open</span>
                                <span class="text-slate-500 text-[10px]">/ @fair.TotalStalls total</span>
                            </td>
                            <td class="py-4 px-4">
                                <span class="block text-slate-800 font-semibold">Stall: $@fair.BaseStallPrice.ToString("N0")</span>
                                <span class="block text-[10px] text-slate-500">Ticket: $@fair.BaseTicketPrice.ToString("N0")</span>
                            </td>
                            <td class="py-4 px-4">
                                @if (fair.IsActive && fair.EndDate >= DateTime.Today)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                        ● Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                        Concluded
                                    </span>
                                }
                            </td>
                            <td class="py-4 px-4 text-right whitespace-nowrap space-x-1">
                                <a asp-controller="Admin" asp-action="Analytics" asp-route-fairId="@fair.FairId" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition">
                                    Analytics
                                </a>
                                <a asp-controller="Vendor" asp-action="StallBooking" asp-route-fairId="@fair.FairId" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold transition">
                                    Stall View
                                </a>
                                <form asp-controller="Admin" asp-action="DeleteFair" asp-route-id="@fair.FairId" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete @fair.Title? This will CASCADE DELETE all associated stalls, bookings, tickets, and operating days.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold transition">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
